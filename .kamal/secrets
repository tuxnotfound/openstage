# Kamal sources this file at deploy time. It IS checked in, so never put a raw value here.
# Each value comes from the shell, else from the gitignored .env.kamal in this checkout, through
# bin/secret. The values today live in Render's environment for the web and the worker; copy
# them into .env.kamal before the first deploy.

# ghcr.io: the box's one classic token, kamal-tux-box, write:packages only (HOSTING.md, item 8).
KAMAL_REGISTRY_PASSWORD=$(bin/secret KAMAL_REGISTRY_PASSWORD)

# Postgres: the accessory's password, and the app's URL to it on the kamal network.
POSTGRES_PASSWORD=$(bin/secret POSTGRES_PASSWORD)
DATABASE_URL=postgres://openstage:${POSTGRES_PASSWORD}@openstage-db:5432/openstage_production

# Rails. Losing the three encryption keys loses every stored GitHub token and Stripe key.
SECRET_KEY_BASE=$(bin/secret SECRET_KEY_BASE)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(bin/secret ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY)
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(bin/secret ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY)
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(bin/secret ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT)

# GitHub: the OAuth app for sign-in, the GitHub App for private repos, the token for previews.
GITHUB_CLIENT_ID=$(bin/secret GITHUB_CLIENT_ID)
GITHUB_CLIENT_SECRET=$(bin/secret GITHUB_CLIENT_SECRET)
GITHUB_APP_CLIENT_ID=$(bin/secret GITHUB_APP_CLIENT_ID)
GITHUB_APP_SLUG=$(bin/secret GITHUB_APP_SLUG)
GITHUB_APP_PRIVATE_KEY=$(bin/secret GITHUB_APP_PRIVATE_KEY)
GITHUB_APP_WEBHOOK_SECRET=$(bin/secret GITHUB_APP_WEBHOOK_SECRET)
GITHUB_PREVIEW_TOKEN=$(bin/secret GITHUB_PREVIEW_TOKEN)

# Stripe (Pro) and Resend (mail; its From and Reply-To are the code's defaults).
STRIPE_SECRET_KEY=$(bin/secret STRIPE_SECRET_KEY)
STRIPE_WEBHOOK_SECRET=$(bin/secret STRIPE_WEBHOOK_SECRET)
STRIPE_MONTHLY_PRICE_ID=$(bin/secret STRIPE_MONTHLY_PRICE_ID)
RESEND_API_KEY=$(bin/secret RESEND_API_KEY)

# The owner's account, the site's own visit counting, Search Console and Umami.
OWNER_GITHUB_UID=$(bin/secret OWNER_GITHUB_UID)
OPENSTAGE_PROJECT_TOKEN=$(bin/secret OPENSTAGE_PROJECT_TOKEN)
GOOGLE_SITE_VERIFICATION=$(bin/secret GOOGLE_SITE_VERIFICATION)
UMAMI_WEBSITE_ID=$(bin/secret UMAMI_WEBSITE_ID)

# Cloudflare R2: the nightly pg_dump goes to a bucket of its own, openstage-backups, with a
# token scoped to that bucket only (HOSTING.md, item 7).
R2_ACCESS_KEY_ID=$(bin/secret R2_ACCESS_KEY_ID)
R2_SECRET_ACCESS_KEY=$(bin/secret R2_SECRET_ACCESS_KEY)
R2_ENDPOINT=$(bin/secret R2_ENDPOINT)
R2_BUCKET=$(bin/secret R2_BUCKET)
