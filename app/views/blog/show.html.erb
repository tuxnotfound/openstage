<% content_for :title, "#{@post.title} — Openstage" %>
<% content_for :meta_description, @post.description %>
<% content_for :og_type, "article" %>
<% content_for :dark_mode, true %>
<% content_for :main_class, "os-wrap pt-1.5" %>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org",
      "@type" => "BlogPosting",
      "headline" => @post.title,
      "description" => @post.description,
      "datePublished" => @post.published_on.iso8601,
      "dateModified" => @post.published_on.iso8601,
      "url" => blog_post_url(@post),
      "mainEntityOfPage" => blog_post_url(@post),
      "image" => "#{request.base_url}/og-default.png",
      "author" => { "@id" => "#{request.base_url}/#organization" },
      "publisher" => { "@id" => "#{request.base_url}/#organization" }
    }.to_json.html_safe %>
  </script>
<% end %>

<article class="os-panel mx-auto max-w-[820px] p-6 sm:p-12">
  <%= link_to "← Blog", blog_path, class: "os-sm font-bold" %>

  <header class="mt-4">
    <h1 class="os-h1 text-[clamp(32px,4vw,48px)]"><%= @post.title %></h1>
    <p class="os-sm os-muted mt-3 mb-6">
      <time datetime="<%= @post.published_on.iso8601 %>"><%= @post.published_on.strftime("%B %-d, %Y") %></time>
      · <%= @post.reading_minutes %> min read
    </p>
  </header>

  <div class="os-prose [&_strong]:text-ink">
    <%= render @post.body_partial %>
  </div>

  <footer class="os-row mt-10 pt-6 text-center">
    <p class="os-sm os-ink2 mb-4">Start your own build-in-public timeline.</p>
    <% unless user_signed_in? %>
      <%= button_to "Sign in with GitHub", "/auth/github", method: :post, data: { turbo: false }, class: "os-btn" %>
    <% else %>
      <%= link_to "Go to dashboard", dashboard_path, class: "os-btn" %>
    <% end %>
  </footer>
</article>
