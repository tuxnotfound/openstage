<% content_for :title, "#{@post.title} — Openstage" %>
<% content_for :meta_description, @post.description %>
<% content_for :og_type, "article" %>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org",
      "@type" => "BlogPosting",
      "headline" => @post.title,
      "description" => @post.description,
      "datePublished" => @post.published_on.iso8601,
      "dateModified" => @post.published_on.iso8601,
      "url" => blog_post_url(@post),
      "mainEntityOfPage" => blog_post_url(@post),
      "image" => "#{request.base_url}/og-default.png",
      "author" => { "@id" => "#{request.base_url}/#organization" },
      "publisher" => { "@id" => "#{request.base_url}/#organization" }
    }.to_json.html_safe %>
  </script>
<% end %>

<article class="max-w-2xl mx-auto px-4 py-10">
  <%= link_to "← Blog", blog_path, class: "text-sm text-gray-400 hover:text-gray-700" %>

  <header class="mt-4">
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight leading-tight"><%= @post.title %></h1>
    <div class="text-xs text-gray-400 mt-2">
      <time datetime="<%= @post.published_on.iso8601 %>"><%= @post.published_on.strftime("%B %-d, %Y") %></time>
      · <%= @post.reading_minutes %> min read
    </div>
  </header>

  <div class="mt-8 space-y-5 text-gray-600 leading-relaxed [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-gray-900 [&_h2]:mt-8 [&_a]:text-gray-800 [&_a]:underline [&_a:hover]:text-gray-900 [&_strong]:text-gray-900">
    <%= render @post.body_partial %>
  </div>

  <footer class="mt-12 pt-6 border-t border-gray-100 text-center">
    <p class="text-gray-500 text-sm mb-4">Start your own build-in-public timeline.</p>
    <% unless user_signed_in? %>
      <%= button_to "Sign in with GitHub", "/auth/github", method: :post, data: { turbo: false }, class: "inline-flex items-center gap-2 bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-700 border-0 cursor-pointer" %>
    <% else %>
      <%= link_to "Go to dashboard", dashboard_path, class: "inline-flex items-center gap-2 bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-700" %>
    <% end %>
  </footer>
</article>
