<% content_for :title, "Blog — Openstage" %>
<% content_for :dark_mode, true %>
<% content_for :main_class, "os-wrap os-stack pt-1.5" %>
<% content_for :meta_description, "Notes on building in public, shipping consistently, and getting the most out of your Openstage timeline." %>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org",
      "@type" => "Blog",
      "name" => "Openstage Blog",
      "url" => blog_url,
      "publisher" => { "@id" => "#{request.base_url}/#organization" },
      "blogPost" => @posts.map { |post|
        {
          "@type" => "BlogPosting",
          "headline" => post.title,
          "description" => post.description,
          "datePublished" => post.published_on.iso8601,
          "url" => blog_post_url(post)
        }
      }
    }.to_json.html_safe %>
  </script>
<% end %>

<section class="os-panel p-6 sm:p-11">
  <h1 class="os-h1 text-[clamp(34px,4vw,48px)]">Blog</h1>
  <p class="os-p mt-2">Notes on building in public and shipping consistently.</p>

  <div class="mt-4.5">
    <% @posts.each do |post| %>
      <article class="os-row py-5">
        <div class="os-xs os-muted">
          <time datetime="<%= post.published_on.iso8601 %>"><%= post.published_on.strftime("%B %-d, %Y") %></time>
          · <%= post.reading_minutes %> min read
        </div>
        <h2 class="os-h2 mt-1.5"><%= link_to post.title, blog_post_path(post), class: "hover:text-accent-ink" %></h2>
        <p class="os-p mt-2 max-w-[760px] text-[15px]"><%= post.description %></p>
        <%= link_to "Read more →", blog_post_path(post), class: "os-link mt-2.5 inline-block text-sm", aria: { label: "Read more: #{post.title}" } %>
      </article>
    <% end %>
  </div>
</section>
