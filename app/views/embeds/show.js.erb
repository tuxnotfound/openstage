(function () {
  var data = <%= raw(ERB::Util.json_escape(@embed_payload.to_json)) %>;
  var script = document.currentScript;
  if (!script || !script.parentNode) return;

  var card = document.createElement("a");
  card.href = data.profile_url;
  card.target = "_blank";
  card.rel = "noopener noreferrer";
  card.style.display = "block";
  card.style.maxWidth = "420px";
  card.style.padding = "14px";
  card.style.border = "1px solid #e5e7eb";
  card.style.borderRadius = "12px";
  card.style.background = "#ffffff";
  card.style.fontFamily = "ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, Helvetica, Arial, sans-serif";
  card.style.textDecoration = "none";
  card.style.color = "#111827";
  card.style.boxSizing = "border-box";

  var top = document.createElement("div");
  top.style.display = "flex";
  top.style.alignItems = "center";
  top.style.gap = "10px";
  top.style.marginBottom = "8px";

  if (data.avatar_url) {
    var avatar = document.createElement("img");
    avatar.src = data.avatar_url;
    avatar.alt = data.display_name;
    avatar.width = 28;
    avatar.height = 28;
    avatar.style.width = "28px";
    avatar.style.height = "28px";
    avatar.style.borderRadius = "9999px";
    avatar.style.objectFit = "cover";
    top.appendChild(avatar);
  }

  var titleWrap = document.createElement("div");
  var name = document.createElement("div");
  name.textContent = data.display_name;
  name.style.fontSize = "13px";
  name.style.fontWeight = "600";
  name.style.lineHeight = "1.2";

  var handle = document.createElement("div");
  handle.textContent = "@" + data.username;
  handle.style.fontSize = "12px";
  handle.style.color = "#6b7280";
  handle.style.lineHeight = "1.2";

  titleWrap.appendChild(name);
  titleWrap.appendChild(handle);
  top.appendChild(titleWrap);

  var label = document.createElement("div");
  label.textContent = "What I'm building";
  label.style.fontSize = "11px";
  label.style.textTransform = "uppercase";
  label.style.letterSpacing = "0.06em";
  label.style.color = "#6b7280";
  label.style.marginBottom = "6px";

  var body = document.createElement("div");
  body.textContent = data.latest_title || "Building in public on Openstage.";
  body.style.fontSize = "14px";
  body.style.lineHeight = "1.4";
  body.style.marginBottom = "10px";

  var footer = document.createElement("div");
  footer.style.display = "flex";
  footer.style.alignItems = "center";
  footer.style.justifyContent = "space-between";

  var type = document.createElement("span");
  type.textContent = data.latest_type || "Timeline";
  type.style.fontSize = "11px";
  type.style.color = "#6b7280";

  var cta = document.createElement("span");
  cta.textContent = "View on Openstage ->";
  cta.style.fontSize = "12px";
  cta.style.color = "#111827";
  cta.style.fontWeight = "600";

  footer.appendChild(type);
  footer.appendChild(cta);

  card.appendChild(top);
  card.appendChild(label);
  card.appendChild(body);
  card.appendChild(footer);

  script.parentNode.insertBefore(card, script.nextSibling);
})();
