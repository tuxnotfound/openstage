<% content_for :title, "Embed preview for @#{@username} — Openstage" %>
<% content_for :main_class, "os-wrap pt-1.5" %>

<section class="os-panel" data-controller="clipboard">
  <h1 class="os-h2">Embed preview for @<%= @username %></h1>
  <p class="os-p mt-1.5">A live card for your own site: it updates itself and links back to your page.</p>
  <div class="mt-4.5 flex flex-wrap items-start gap-5">
    <div class="min-w-0 flex-[1_1_380px] sm:max-w-[460px]">
      <script src="<%= @script_src %>"></script>
    </div>
    <div class="min-w-0 flex-[1_1_380px]">
      <label for="embed-script" class="os-label">Script</label>
      <input id="embed-script" data-clipboard-target="source" type="text" readonly
             value="<script src=&quot;<%= @script_src %>&quot;></script>" class="os-code mt-1.5 block w-full">
      <button type="button" data-action="clipboard#copy" data-clipboard-target="button" class="os-btn2 sm mt-2.5">Copy</button>
      <p class="os-xs os-muted mt-3">Paste it where the card should appear. Impressions show in your analytics.</p>
    </div>
  </div>
</section>
