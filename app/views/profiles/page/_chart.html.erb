<%# The chart of a window: a legend, one line per project, numbered discs and
    a tooltip per point. linked: discs jump to the numbered list beside it. %>
<div data-controller="chart-tooltip">
  <% if chart.lines.any? %>
    <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-[13px] text-ink-2">
      <% chart.lines.each do |line| %>
        <span class="inline-flex items-center gap-[7px]">
          <span class="<%= project_class(line.rank) %> h-[3px] w-4 rounded-sm bg-(--project)" aria-hidden="true"></span>
          <%= line.name %> <span class="os-num font-bold text-ink"><%= line.total %></span>
        </span>
      <% end %>
    </div>
  <% end %>

  <div class="os-chart mt-3.5 <%= local_assigns[:height] %>" data-action="mouseleave->chart-tooltip#hide">
    <% chart.ticks.each do |tick| %>
      <div class="os-gridline" style="top: <%= tick.top %>%"></div>
    <% end %>
    <div class="os-axis"></div>
    <svg viewBox="0 0 <%= ProgressChart::Trend::WIDTH %> <%= ProgressChart::Trend::HEIGHT %>" preserveAspectRatio="none" role="img" aria-label="<%= chart.aria_label %>">
      <% chart.paths.each do |d, rank| %>
        <path d="<%= d %>" class="<%= project_class(rank) %> stroke-(--project)" fill="none" stroke-width="3"
              stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
      <% end %>
    </svg>
    <% chart.ticks.each do |tick| %>
      <div class="os-ylab -translate-y-1/2" style="top: <%= tick.top %>%"><%= tick.value %></div>
    <% end %>
    <div class="absolute inset-y-0 right-0 w-0.5 bg-strong" aria-hidden="true"></div>

    <% chart.columns.each_with_index do |column, i| %>
      <div class="group absolute inset-y-0 z-[2]" style="left: <%= column.left %>%; width: <%= column.width %>%"
           data-action="mouseenter->chart-tooltip#show mousemove->chart-tooltip#move" data-chart-tooltip-template-param="trend-tip-<%= i %>">
        <div class="absolute inset-y-0 w-px bg-ink-3 opacity-0 group-hover:opacity-100" style="left: <%= column.mark %>%"></div>
      </div>
    <% end %>

    <% chart.discs.each do |disc| %>
      <% disc_class = "os-disc #{project_class(disc.rank)} absolute z-[3] size-[26px] -translate-x-1/2 -translate-y-1/2 border-2 border-fill bg-(--project) text-(--on-project)" %>
      <% if linked %>
        <a href="#progress-note-<%= disc.number %>" data-turbo="false" title="<%= disc.item.title %>" aria-label="Number <%= disc.number %>: <%= disc.item.title %>"
           class="<%= disc_class %>" style="left: <%= disc.left %>%; top: <%= disc.top %>%"><%= disc.number %></a>
      <% else %>
        <span title="<%= disc.item.title %>" class="<%= disc_class %>" style="left: <%= disc.left %>%; top: <%= disc.top %>%"><%= disc.number %></span>
      <% end %>
    <% end %>

    <div data-chart-tooltip-target="tooltip" class="pointer-events-none absolute z-[5] hidden w-[220px] rounded-[10px] bg-ink px-3 py-2.5 text-xs/snug text-ground shadow-lg"></div>
    <% chart.columns.each_with_index do |column, i| %>
      <template id="trend-tip-<%= i %>">
        <div class="opacity-70"><%= column.title %><%= " · 7-day average" if chart.average? %></div>
        <% if column.rows.empty? %><div class="mt-1">No commits</div><% end %>
        <% column.rows.each do |row| %>
          <div class="mt-1 flex items-center gap-2">
            <span class="<%= project_class(row.rank) %> h-[3px] w-3 rounded-sm bg-(--project)"></span>
            <span class="flex-1"><%= row.name %></span>
            <span class="font-semibold tabular-nums"><%= row.value %></span>
          </div>
        <% end %>
        <% column.notes.each do |disc| %>
          <div class="mt-1.5 flex gap-2"><span class="w-3 shrink-0 text-center font-semibold"><%= disc.number %></span><span class="line-clamp-2"><%= disc.item.title %></span></div>
        <% end %>
      </template>
    <% end %>
  </div>
  <div class="os-xlabs">
    <% chart.axis.each_with_index do |label, i| %>
      <span class="<%= 'font-bold text-ink' if i == chart.axis.size - 1 %>"><%= label %></span>
    <% end %>
  </div>
  <p class="os-note mt-2">
    <%= chart.lines.any? ? chart.note : "No commits #{section.labels.word}#{" for #{section.selection_name}" if section.filtered?}." %>
  </p>
</div>
