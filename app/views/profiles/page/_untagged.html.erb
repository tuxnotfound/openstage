<%# The owner's backlog: entries with no project never show in a project
    view, and nothing is inferred from their text. One click tags a row and
    the page redraws with the panel still open. %>
<% untagged = section.tally.untagged %>
<% open = params[:tag] == "1" %>
<% back = params.permit(:range, :repo, repo: []).to_h %>
<% if untagged.any? || open %>
  <% if untagged.any? %>
    <p class="os-xs os-muted mt-[18px]">
      <%= progress_untagged_line(section) %>
      <%= link_to (open ? "Close" : "Tag them"), progress_view_path(user, tag: (open ? nil : "1")), class: "os-link text-[13px]" %>
    </p>
  <% end %>

  <% if open %>
    <div class="os-card mt-2.5 px-3.5 pt-1 pb-2.5" data-tag-panel>
      <% untagged.each_with_index do |item, i| %>
        <% if i == 6 %><details class="group"><summary class="os-sm mt-2 cursor-pointer list-none text-ink-2 group-open:hidden [&::-webkit-details-marker]:hidden">Show <%= untagged.size - 6 %> more</summary><% end %>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-line py-2.5" data-tag-row="<%= item.id %>">
          <div class="flex min-w-0 flex-[1_1_300px] items-center gap-2.5">
            <span class="os-xs w-[74px] shrink-0 font-bold text-ink-3"><%= item.date.strftime("%b %-d") %> · <%= item.shipped? ? "Shipped" : "Published" %></span>
            <span class="os-sm line-clamp-2 min-w-0"><%= item.title %></span>
          </div>
          <div class="flex flex-wrap items-center gap-1.5">
            <% progress_tag_choices(item, section).each do |project, n| %>
              <%= button_to entry_project_path(item.id), method: :patch, params: back.merge(repo_name: project.repo),
                    class: "os-chip #{project_class(project.rank)} h-[30px] px-2.5 text-xs text-ink" do %>
                <span class="os-dot size-2 bg-(--project)"></span><%= project.name %><%= " · #{n} that day" if n %>
              <% end %>
            <% end %>
            <%= form_with url: entry_project_path(item.id), method: :patch, data: { controller: "autosubmit" } do %>
              <% back.each do |key, value| %>
                <% Array(value).each do |one| %><%= hidden_field_tag(value.is_a?(Array) ? "#{key}[]" : key, one, id: nil) %><% end %>
              <% end %>
              <select name="repo_name" aria-label="Other project" data-action="change->autosubmit#submit"
                      class="h-[30px] cursor-pointer rounded-[10px] border border-line bg-surface px-1.5 text-xs text-ink-2">
                <option value="">Other…</option>
                <% section.tally.projects.all.each do |project| %><option value="<%= project.repo %>"><%= project.name %></option><% end %>
              </select>
            <% end %>
            <%= button_to "No project", entry_project_path(item.id), method: :patch, params: back.merge(no_project: "1"),
                  class: "os-btn2 sm h-[30px] px-2.5 text-xs" %>
          </div>
        </div>
      <% end %>
      <% if untagged.size > 6 %></details><% end %>
      <% if untagged.empty? %>
        <p class="os-sm os-muted mt-2.5">Every entry here has a project now.</p>
      <% end %>
    </div>
  <% end %>
<% end %>
