<%# The owner's card of this view: the window and the projects in view. %>
<div data-controller="dialog">
  <button type="button" data-action="dialog#open" class="os-btn2 sm">Make a card</button>
  <dialog data-dialog-target="dialog" data-action="click->dialog#backdrop" aria-label="Make a card"
          class="m-auto mt-10 w-[calc(100%-2rem)] max-w-[1060px] rounded-panel bg-fill p-[clamp(18px,2.4vw,28px)] text-ink shadow-2xl backdrop:bg-black/55">
    <div class="os-between">
      <h2 class="os-h2">Make a card</h2>
      <button type="button" data-action="dialog#close" class="os-btn2 sm">Close</button>
    </div>
    <%= turbo_frame_tag "progress_card", src: progress_card_path(range: section.labels.range, repo: section.selected.map(&:repo).presence),
          loading: :lazy, class: "mt-4 block" do %>
      <p class="os-sm os-muted">Drawing your card…</p>
    <% end %>
  </dialog>
</div>
