<%# What's new: every shipped and published entry in the window, newest
    first, in the builder's own words, as the chart marks them. A row wears
    its entry's mark (a milestone's flag, the rocket of something shipped,
    the bubble of something published) and opens on its description, the
    newest open; its title leads to its link. Past the first eight, the rows
    fold away. The chart's script keeps it in step (ProgressIsland). lone: a
    project's own page, whose rows leave their project out. %>
<% items = section.tally.items.reverse %>
<% shown = 8 %>
<section id="whats-new-panel" class="os-panel" aria-labelledby="whats-new">
  <div class="os-between">
    <h2 id="whats-new" class="os-h2">What's new</h2>
    <span class="os-xs os-muted"><%= items.size %> <%= section.labels.word %></span>
  </div>
  <% if items.empty? %>
    <p class="os-note mt-3"><%= section.filtered? ? section.labels.empty_tagged(section.selection_name(alternatives: true)) : section.labels.empty %></p>
  <% else %>
    <div class="mt-2.5">
      <% items.each_with_index do |item, i| %>
        <% if i == shown %><details class="group/all"><summary class="os-btn2 sm mt-3 list-none group-open/all:hidden [&::-webkit-details-marker]:hidden">Show all <%= items.size %></summary><% end %>
        <%= render "profiles/page/whats_new_row", item: item, section: section, open: i.zero?, lone: local_assigns[:lone],
                                                   anchor: ("entry-#{item.id}" unless item.entry == local_assigns[:linked]) %>
      <% end %>
      <% if items.size > shown %></details><% end %>
    </div>
  <% end %>
</section>
