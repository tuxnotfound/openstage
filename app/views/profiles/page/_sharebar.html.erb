<%# A bar split by project, each part its share of the commits, with each
    project's share and name below it. shares: [name, rank, commits] per
    project with commits, busiest first; label: what the bar shows, for
    screen readers. %>
<% total = shares.sum(&:last) %>
<div class="os-sharebar <%= local_assigns[:css] %>" role="img" aria-label="<%= label %>">
  <% shares.each do |name, rank, commits| %>
    <div class="<%= project_class(rank) %> min-w-1.5 bg-(--project)" style="flex: <%= commits %> 1 0" title="<%= name %>: <%= pluralize(commits, 'commit') %>"></div>
  <% end %>
</div>
<div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[13px] text-ink-2">
  <% shares.each do |name, _rank, commits| %>
    <span><span class="os-num font-bold text-ink"><%= (100.0 * commits / total).round %>%</span> <%= name %></span>
  <% end %>
</div>
