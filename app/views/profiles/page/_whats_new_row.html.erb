<%# One entry of What's new, as ProgressIsland's NewsRow draws it: its day,
    its mark and kind, its title (a link to its link, through the click
    counter), its project unless lone, and with a description a row that
    opens on it; a title that runs into its body (Progress::RunIn) shows
    that run-in only while closed. open: open from the start. anchor: its
    id, nil for the entry a link pointed at, which shows above the page. %>
<% project = item.repo_name && section.tally.projects.find(item.repo_name) %>
<% body = item.body.presence %>
<% url = safe_external_url(item.entry.url) %>
<% run_in = progress_run_in(item, section).presence %>
<% line = capture do %>
  <span class="os-sm os-muted flex-[0_0_64px]"><%= item.date.strftime("%b %-d") %></span>
  <span class="os-xs inline-flex flex-[0_0_104px] items-center gap-1.5 font-bold text-ink-3">
    <span class="<%= badge_class(project, lone: local_assigns[:lone]) %> inline-flex size-[18px] flex-none items-center justify-center rounded-full bg-(--project) text-(--on-project)"><%= mark_icon(item.badge, css: "size-[11px]") %></span>
    <%= ProgressHelper::BADGE_WORDS.fetch(item.badge) %>
  </span>
  <span class="min-w-0 flex-[1_1_300px] text-[15px] font-semibold">
    <% if url %>
      <%= link_to item.title, entry_click_out_path(item.id), target: "_blank", rel: "noopener", data: { turbo: false }, class: "hover:underline", title: url %>
    <% else %>
      <%= item.title %>
    <% end %>
    <% if run_in %><span class="font-normal text-ink-3 group-open/row:hidden"><%= run_in %></span><% end %>
  </span>
  <% if project && !local_assigns[:lone] %><span class="os-xs os-muted"><%= project.name %></span><% end %>
<% end %>
<% if body %>
  <%= tag.details id: local_assigns[:anchor], open: local_assigns[:open].presence, class: "os-row group/row scroll-mt-6 py-3" do %>
    <summary class="os-rowflex relative cursor-pointer list-none pr-7 [&::-webkit-details-marker]:hidden">
      <%= line %>
      <svg viewBox="0 0 16 16" class="absolute top-0.5 right-0 size-4 text-ink-3 transition-transform group-open/row:rotate-180" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
    </summary>
    <p class="os-sm os-ink2 mt-1.5 whitespace-pre-line"><%= body %></p>
  <% end %>
<% else %>
  <%= tag.div line, id: local_assigns[:anchor], class: "os-row os-rowflex scroll-mt-6 py-3" %>
<% end %>
