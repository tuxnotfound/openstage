<%# A toggle per number the chart can draw, with its value and its line:
    commits solid, site visits dotted. The last one on stays on. path_for:
    the page's address for a ?show= value, nil for both. %>
<nav class="os-pills flex-wrap <%= local_assigns[:class] %>" aria-label="Numbers">
  <% SiteVisitsHelper::CHART_NUMBERS.each do |number, label| %>
    <%= link_to path_for.call(chart_numbers_show(numbers, number)), class: "os-pill h-auto flex-col items-start px-[18px] py-2",
          aria: { current: (numbers.include?(number) ? "true" : nil) } do %>
      <span class="flex items-center gap-1.5 text-xs">
        <span class="w-3.5 border-t-[3px] border-current <%= 'border-dotted' if number == 'visits' %>" aria-hidden="true"></span><%= label %>
      </span>
      <span class="os-num text-[22px]"><%= values.fetch(number) %></span>
    <% end %>
  <% end %>
</nav>
