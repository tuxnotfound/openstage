<%# The six that get words, picked as the cards pick them; each one's number
    is its disc on the chart. The rest are under What shipped. %>
<% pick = section.pick %>
<div class="min-w-0 flex-[1_1_280px]">
  <h3 class="os-label mb-1">Shipped and published, <%= section.labels.words %></h3>
  <% if pick.kept.any? %>
    <ol class="m-0 list-none p-0">
      <% chart.discs.each do |disc| %>
        <% item = disc.item %>
        <% project = item.repo_name && section.tally.projects.find(item.repo_name) %>
        <li id="progress-note-<%= disc.number %>" class="os-row flex scroll-mt-6 items-start gap-3 py-[11px]">
          <span class="os-disc <%= project_class(disc.rank) %> bg-(--project) text-(--on-project)"><%= disc.number %></span>
          <span class="min-w-0">
            <a href="#entry-<%= item.id %>" data-turbo="false" class="block text-[15px]/[1.35] font-semibold hover:underline"><%= item.title %>
              <% if (run_in = progress_run_in(item, section)).present? %><span class="font-normal text-ink-3"><%= run_in %></span><% end %></a>
            <span class="os-xs os-muted">
              <%= item.date.strftime("%b %-d") %><%= " · #{project.name}" if project %> · <%= item.shipped? ? "Shipped" : "Published" %><%= " · pinned" if item.pinned? %>
            </span>
          </span>
        </li>
      <% end %>
    </ol>
    <p class="os-note border-t border-line pt-2.5">
      <%= pick.left.any? ? "#{pick.left.size} more #{section.labels.word}, all listed under What shipped." : "Everything shipped and published #{section.labels.word}." %>
    </p>
  <% else %>
    <p class="os-note mt-2">
      <%= section.filtered? ? section.labels.empty_tagged(section.selection_name(alternatives: true)) : section.labels.empty %>
      <% if current_user == user %><%= link_to "Log an entry", dashboard_path, data: { turbo_frame: "_top" }, class: "os-link ml-1 text-[13px]" %><% end %>
    </p>
  <% end %>
</div>
