<%# A page with nothing public yet says so plainly, and tells its owner what
    fills it. %>
<div class="mt-8 border-t border-line py-12 text-center">
  <% if @syncing %>
    <p class="os-h3">Your commits are on their way</p>
    <p class="os-sm os-muted mt-1">Give it a minute. If your repos are quiet, this page fills as you ship.</p>
  <% elsif current_user == user %>
    <p class="os-h3">Nothing public in the last year</p>
    <p class="os-sm os-muted mt-1">Log your first milestone, or include a private repo in Settings to publish its build.</p>
    <div class="mt-6 flex items-center justify-center gap-3">
      <%= link_to "Log a milestone", dashboard_path, class: "os-btn sm", data: { turbo_frame: "_top" } %>
      <%= link_to "Settings", settings_path(tab: "integrations"), class: "os-btn2 sm", data: { turbo_frame: "_top" } %>
    </div>
  <% else %>
    <p class="os-h3">Nothing here yet</p>
    <p class="os-sm os-muted mt-1">This builder has no public activity in the last year.</p>
  <% end %>
</div>
