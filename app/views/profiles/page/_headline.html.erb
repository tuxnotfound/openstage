<%# Commits is the one number GitHub gives every project today; the tab row
    is where the others will sit. %>
<% totals = section.tally.totals %>
<% arrow, change, up = progress_change(section) %>
<% shares = section.tally.projects.all.filter_map { |project| [ project, totals.counts[project.repo] ] if totals.counts[project.repo].to_i.positive? } %>
<div class="os-pills mt-[26px]">
  <span class="os-pill on h-auto flex-col items-start px-[18px] py-2">
    <span class="block text-xs opacity-90">Commits</span>
    <span class="os-num text-[22px]"><%= totals.commits %></span>
  </span>
</div>

<div class="mt-[22px]">
  <p class="os-label">Commits · <%= progress_scope(section) %>, <%= section.labels.words %></p>
  <div class="mt-0.5 flex flex-wrap items-baseline gap-x-[22px] gap-y-1.5">
    <span class="os-num os-big"><%= totals.commits %></span>
    <% if change.present? %>
      <span class="text-lg font-semibold text-ink-2">
        <% if arrow %><span class="<%= up ? 'text-up' : 'text-down' %>" aria-label="<%= up ? 'Up' : 'Down' %>"><%= arrow %></span><% end %>
        <%= change %>
      </span>
    <% end %>
  </div>

  <% if shares.any? %>
    <div class="os-sharebar mt-5" role="img" aria-label="Share of commits by project">
      <% shares.each do |project, n| %>
        <div class="<%= project_class(project.rank) %> min-w-1.5 bg-(--project)" style="flex: <%= n %> 1 0" title="<%= project.name %>: <%= pluralize(n, 'commit') %>"></div>
      <% end %>
    </div>
    <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[13px] text-ink-2">
      <% shares.each do |project, n| %>
        <span><span class="os-num font-bold text-ink"><%= (100.0 * n / totals.commits).round %>%</span> <%= project.name %></span>
      <% end %>
    </div>
  <% end %>

  <p class="os-xs os-muted mt-3">
    <%= totals.shipped %> shipped · <%= totals.published %> published ·
    <%= pluralize(totals.projects, "project") %> with commits · <%= pluralize(totals.active_days, "active day") %>
  </p>
</div>
