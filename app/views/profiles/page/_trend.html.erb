<%# The chart beside the numbered list of what shipped and was published.
    On a phone the list follows the chart. A builder can hide the list, and
    the chart takes the width. %>
<div class="mt-[22px] flex flex-wrap items-start gap-x-9 gap-y-6">
  <div class="min-w-0 flex-[999_1_520px]">
    <%= render "profiles/page/chart", section: section, chart: chart, linked: true %>
  </div>

  <% if user.shipped_list? %>
    <%= render "profiles/page/picks", user: user, section: section, chart: chart %>
  <% end %>
</div>
