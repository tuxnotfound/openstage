<%# The entry a link pointed at, whatever the window and filters show below:
    an older commit, or an entry outside the window. %>
<% project = entry.repo_name&.split("/")&.last %>
<section id="entry-<%= entry.id %>" class="os-card scroll-mt-6 border-accent bg-accent-soft" aria-label="The entry you followed" data-linked-entry>
  <div class="os-between">
    <p class="os-label text-accent-ink">The entry you followed</p>
    <%= link_to "Close", progress_view_path(user), class: "os-xs font-bold underline hover:text-ink" %>
  </div>
  <p class="mt-1.5 text-[17px] font-semibold">
    <% if (url = safe_external_url(entry.url)) %>
      <%= link_to entry.title, entry_click_out_path(entry), target: "_blank", rel: "noopener", data: { turbo: false }, class: "hover:underline", title: url %>
    <% else %>
      <%= entry.title %>
    <% end %>
  </p>
  <% if entry.body.present? && !entry.commit? %>
    <p class="os-sm os-ink2 mt-1 whitespace-pre-line"><%= entry.body %></p>
  <% end %>
  <p class="os-xs os-muted mt-1.5">
    <%= [ entry_kind(entry), entry.occurred_at.strftime("%b %-d, %Y"), project ].compact.join(" · ") %>
  </p>
</section>
