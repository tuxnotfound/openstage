<%# Project chips switch a project in or out of view; the pills pick the
    window. Both are links, so the frame redraws and the URL follows. %>
<% projects = section.tally.projects.all %>
<div class="os-between mt-6">
  <% if projects.size > 1 %>
    <div role="group" aria-label="Projects" class="flex flex-wrap gap-2">
      <%= link_to "All projects", progress_view_path(user, repo: nil), class: "os-chip #{'text-ink' if section.filtered?}",
            aria: { current: (section.filtered? ? nil : "true") } %>
      <% projects.each do |project| %>
        <% on = !section.filtered? || section.selected.include?(project) %>
        <%= link_to progress_chip_path(user, section, project), aria: { current: (on ? "true" : nil) },
              class: "os-chip #{project_class(project.rank)} #{on ? 'border-(--project) bg-(--project) text-(--on-project)' : 'border-dashed'}" do %>
          <span class="os-dot <%= on ? 'bg-current opacity-60' : 'bg-line' %>"></span><%= project.name %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-2.5">
    <nav class="os-pills" aria-label="Time range">
      <% ProgressHelper::RANGES.each do |range, label| %>
        <%= link_to label, progress_view_path(user, range: range == Progress::Window::DEFAULT ? nil : range),
              class: "os-pill max-sm:px-2", aria: { current: (section.labels.range == range ? "page" : nil) } %>
      <% end %>
    </nav>
  </div>
</div>
