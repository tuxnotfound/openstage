<div id="entry-<%= entry.id %>" class="group flex gap-4 py-4 border-b border-gray-100 last:border-0 scroll-mt-6">
  <!-- Icon -->
  <div class="shrink-0 mt-0.5">
    <%= render "profiles/entry_icon", type: entry.entry_type %>
  </div>

  <!-- Content -->
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <%= render "profiles/entry_badge", type: entry.entry_type, source: entry.source %>
          <% if entry.repo_name.present? %>
            <span class="text-xs text-gray-400 truncate"><%= entry.repo_name.split("/").last %></span>
          <% end %>
          <% if entry.pinned? %>
            <svg class="w-3 h-3 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
            </svg>
          <% end %>
        </div>

        <p class="text-sm font-medium text-gray-900 leading-snug"><%= entry.title %></p>

        <% if entry.body.present? %>
          <div data-controller="toggle">
            <p data-toggle-target="openIcon"
               data-action="click->toggle#toggle"
               class="text-sm text-gray-500 mt-1 leading-relaxed line-clamp-3 cursor-pointer hover:text-gray-700 transition-colors">
              <%= entry.body %>
            </p>
            <p data-toggle-target="closeIcon"
               data-action="click->toggle#toggle"
               class="text-sm text-gray-500 mt-1 leading-relaxed cursor-pointer hover:text-gray-700 transition-colors hidden">
              <%= entry.body %>
            </p>
          </div>
        <% end %>

        <% if entry.url.present? %>
          <a href="<%= entry_click_out_path(entry) %>" target="_blank" rel="noopener"
             class="inline-flex items-center gap-1 text-xs text-gray-400 hover:text-gray-700 mt-1.5 transition-colors">
            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
            </svg>
            <span class="truncate max-w-xs"><%= entry.url.gsub(%r{\Ahttps?://}, '') %></span>
          </a>
        <% end %>
      </div>

      <time datetime="<%= entry.occurred_at.iso8601 %>"
            title="<%= entry.occurred_at.strftime("%B %-d, %Y at %H:%M") %>"
            class="text-xs text-gray-400 whitespace-nowrap shrink-0">
        <%= time_ago_in_words(entry.occurred_at) %> ago
      </time>
    </div>
  </div>
</div>
