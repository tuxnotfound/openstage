<% content_for :title, "#{@user.display_name} (@#{@user.username}) — Openstage" %>
<% meta_desc = @user.bio.presence || "#{@user.display_name} is building in public on Openstage. #{@total_entries} entries, #{@repos_synced} repos, #{@milestones} milestones." %>
<% content_for :meta_description, meta_desc %>
<% content_for :head do %>
  <link rel="canonical" href="<%= profile_url(@user.username) %>" />

  <meta property="og:type"        content="profile" />
  <meta property="og:site_name"   content="Openstage" />
  <meta property="og:title"       content="<%= @user.display_name %> (@<%= @user.username %>) on Openstage" />
  <meta property="og:description" content="<%= meta_desc %>" />
  <meta property="og:image"       content="<%= og_image_url(@user.username) %>?v=3" />

  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="<%= @user.display_name %> (@<%= @user.username %>) on Openstage" />
  <meta name="twitter:description" content="<%= meta_desc %>" />
  <meta name="twitter:image"       content="<%= og_image_url(@user.username) %>?v=3" />

  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org",
      "@type"    => "Person",
      "name"     => @user.display_name,
      "url"      => profile_url(@user.username),
      "image"    => @user.avatar_url,
      "description" => @user.bio.presence,
      "sameAs"   => [
        "https://github.com/#{@user.github_username}",
        @user.website_url.presence
      ].compact
    }.compact.to_json.html_safe %>
  </script>
<% end %>

<% unless @user.pro? %>
  <footer class="mt-10 pt-6 border-t border-gray-100 text-center">
    <a href="<%= root_url %>" class="text-sm text-gray-500 hover:text-gray-900">
      Powered by Openstage
    </a>
  </footer>
<% end %>

<!-- Profile header -->
<div class="flex flex-col sm:flex-row gap-6 items-start pb-8 border-b border-gray-200">
  <img src="<%= @user.avatar_url %>"
       alt="<%= @user.display_name %>"
       class="w-20 h-20 rounded-full ring-2 ring-gray-100 shrink-0">

  <div class="flex-1 min-w-0">
    <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
      <h1 class="text-xl font-bold text-gray-900 truncate"><%= @user.display_name %></h1>
      <% if @user.pro? %>
        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">✦ Pro</span>
      <% end %>
      <span class="text-gray-400 text-sm font-mono">@<%= @user.username %></span>
    </div>

    <% if @user.bio.present? %>
      <p class="mt-2 text-gray-600 text-sm leading-relaxed max-w-lg"><%= @user.bio %></p>
    <% end %>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-3 text-sm text-gray-500">
      <a href="https://github.com/<%= @user.github_username %>"
         target="_blank" rel="noopener"
         class="flex items-center gap-1.5 hover:text-gray-900 transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
        </svg>
        <%= @user.github_username %>
      </a>

      <% if @user.website_url.present? %>
        <a href="<%= @user.website_url %>" target="_blank" rel="noopener"
           class="flex items-center gap-1.5 hover:text-gray-900 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>
          </svg>
          <%= @user.website_url.gsub(%r{\Ahttps?://}, "") %>
        </a>
      <% end %>

      <% if @user.building_since.present? %>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5"/>
          </svg>
          Building since <%= @user.building_since.strftime("%B %Y") %>
        </span>
      <% end %>
    </div>
  </div>
</div>

<!-- Stats bar -->
<div class="flex gap-8 py-5 border-b border-gray-200">
  <div>
    <div class="text-2xl font-bold text-gray-900"><%= @total_entries %></div>
    <div class="text-xs text-gray-400 uppercase tracking-wide mt-0.5">entries</div>
  </div>
  <div>
    <div class="text-2xl font-bold text-gray-900"><%= @repos_synced %></div>
    <div class="text-xs text-gray-400 uppercase tracking-wide mt-0.5">repos</div>
  </div>
  <div>
    <div class="text-2xl font-bold text-gray-900"><%= @milestones %></div>
    <div class="text-xs text-gray-400 uppercase tracking-wide mt-0.5">milestones</div>
  </div>
</div>

<!-- Activity heatmap -->
<% if @heatmap_data.any? %>
  <div class="py-5 border-b border-gray-200 overflow-x-auto">
    <% weeks = (0..51).map { |w| (51 - w).weeks.ago.to_date.beginning_of_week(:sunday) } %>
    <div class="flex gap-1 min-w-max">
      <% weeks.each do |week_start| %>
        <div class="flex flex-col gap-1">
          <% (0..6).each do |day_offset| %>
            <% date = week_start + day_offset %>
            <% count = @heatmap_data[date.to_s] || 0 %>
            <% color = if count == 0 then "bg-gray-100"
                        elsif count == 1 then "bg-green-200"
                        elsif count <= 3 then "bg-green-400"
                        else "bg-green-600"
                        end %>
            <div class="w-2.5 h-2.5 rounded-sm <%= color %>"
                 title="<%= date.strftime("%b %-d") %>: <%= count %> <%= "entry".pluralize(count) %>"></div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>


<!-- Pinned entries -->
<% if @pinned_entries.any? %>
  <div class="py-5 border-b border-gray-200">
    <div class="flex items-center gap-2 mb-3">
      <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24">
        <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
      </svg>
      <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Pinned</span>
    </div>
    <div class="space-y-1">
      <% @pinned_entries.each do |entry| %>
        <%= render "profiles/entry_card", entry: entry %>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Filter row: type tabs + repo dropdown -->
<div class="flex items-center justify-between mt-6 border-b border-gray-100 gap-4">
  <div class="flex gap-1 overflow-x-auto">
    <% [["all", "All"], ["shipped", "Shipped"], ["posted", "Posted"], ["milestone", "Milestones"], ["note", "Notes"]].each do |value, label| %>
      <%= link_to label,
          profile_path(@user.username, filter: value == "all" ? nil : value, repo: @repo_filter),
          class: "px-4 py-2 text-sm font-medium whitespace-nowrap transition-colors #{@filter == value ? 'text-gray-900 border-b-2 border-gray-900 -mb-px' : 'text-gray-500 hover:text-gray-900'}",
          data: { turbo_frame: "timeline" } %>
    <% end %>
  </div>

  <% if @available_repos.any? %>
    <div class="shrink-0 pb-1">
      <form action="<%= profile_path(@user.username) %>" method="get" data-turbo-frame="timeline">
        <%= hidden_field_tag :filter, @filter == "all" ? nil : @filter %>
        <select name="repo" onchange="this.form.requestSubmit()"
                class="text-xs border border-gray-200 rounded-lg px-2.5 py-1.5 text-gray-600 bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 cursor-pointer">
          <option value="">All repos</option>
          <% @available_repos.each do |repo| %>
            <option value="<%= repo %>" <%= "selected" if @repo_filter == repo %>>
              <%= repo.split("/").last %>
            </option>
          <% end %>
        </select>
      </form>
    </div>
  <% end %>
</div>

<!-- Timeline -->
<%= turbo_frame_tag "timeline" do %>
  <div class="mt-6">
    <% if @entries.empty? %>
      <%= render "profiles/empty_state" %>
    <% else %>
      <div id="timeline-entries" class="space-y-1">
        <% @entries.each do |entry| %>
          <%= render "profiles/entry_card", entry: entry %>
        <% end %>
      </div>
      <% if @entries.next_page %>
        <div id="load-more" class="mt-6 text-center">
          <%= link_to "Load more",
              profile_path(@user.username, page: @entries.next_page, filter: @filter == "all" ? nil : @filter, repo: @repo_filter),
              class: "text-sm text-gray-500 hover:text-gray-900 border border-gray-200 rounded-lg px-5 py-2.5 inline-block transition-colors",
              data: { turbo_stream: true } %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
