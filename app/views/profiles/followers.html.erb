<% content_for :title, "#{@user.display_name}'s followers — Openstage" %>

<div class="mb-6">
  <a href="<%= profile_path(@user.username) %>" class="text-sm text-gray-500 hover:text-gray-900 transition-colors">← @<%= @user.username %></a>
  <h1 class="text-xl font-bold text-gray-900 mt-2"><%= @user.display_name %>'s followers</h1>
</div>

<% if @users.empty? %>
  <div class="rounded-2xl border border-dashed border-gray-200 bg-white px-6 py-12 text-center">
    <p class="text-sm text-gray-500">No followers yet.</p>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded-2xl px-4 divide-y divide-gray-100">
    <% @users.each do |user| %>
      <%= render "profiles/user_row", user: user, follows_map: @follows_map %>
    <% end %>
  </div>
<% end %>
