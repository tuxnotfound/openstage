<%# The owner's backlog: entries with no project never show in a project
    view, and nothing is inferred from their text. One click tags a row and
    the section redraws with the panel still open. %>
<% untagged = section.tally.untagged %>
<% open = params[:tag] == "1" %>
<% back = params.permit(:range, :offset, :repo, :chart).to_h %>
<% if untagged.any? || open %>
  <% if untagged.any? %>
    <p class="mt-[18px] text-xs text-gray-500">
      <%= progress_untagged_line(section) %>
      <%= link_to (open ? "Close" : "Tag them"), progress_view_path(user, tag: (open ? nil : "1")), class: "text-gray-900 underline" %>
    </p>
  <% end %>

  <% if open %>
    <div class="mt-2.5 rounded-xl border border-gray-200 px-3.5 pt-1 pb-2.5" data-tag-panel>
      <% untagged.each_with_index do |item, i| %>
        <% if i == 6 %><details class="group"><summary class="mt-2 list-none cursor-pointer text-[13px] text-gray-700 [&::-webkit-details-marker]:hidden group-open:hidden">Show <%= untagged.size - 6 %> more</summary><% end %>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 py-2.5 border-b border-gray-100" data-tag-row="<%= item.id %>">
          <div class="flex items-center gap-2.5 flex-[1_1_300px] min-w-0">
            <svg class="size-2.5 shrink-0" viewBox="0 0 10 10" role="img" aria-label="<%= item.shipped? ? 'Shipped' : 'Published' %>">
              <% if item.shipped? %><circle cx="5" cy="5" r="4.5" fill="#111827"/><% else %><circle cx="5" cy="5" r="3.9" fill="#ffffff" stroke="#111827" stroke-width="1.3"/><% end %>
            </svg>
            <span class="w-12 shrink-0 text-xs font-medium text-gray-500 uppercase tabular-nums"><%= item.date.strftime("%b %-d") %></span>
            <span class="min-w-0 line-clamp-2 text-sm text-gray-900"><%= item.title %></span>
          </div>
          <div class="flex flex-wrap items-center gap-1.5">
            <% progress_tag_choices(item, section).each do |project, n| %>
              <%= button_to entry_project_path(item.id), method: :patch, params: back.merge(repo_name: project.repo),
                    class: "inline-flex items-center gap-1.5 min-h-[30px] px-2.5 border border-gray-200 rounded-lg bg-white text-xs text-gray-900 cursor-pointer hover:border-gray-400" do %>
                <span class="inline-block size-2 rounded-full" style="background: <%= ProgressChart::Palette.project_color(project.rank) %>"></span><%= project.name %><%= " · #{n} that day" if n %>
              <% end %>
            <% end %>
            <%= form_with url: entry_project_path(item.id), method: :patch, data: { controller: "autosubmit" } do %>
              <% back.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
              <select name="repo_name" aria-label="Other project" data-action="change->autosubmit#submit"
                      class="min-h-[30px] px-1.5 border border-gray-200 rounded-lg bg-white text-xs text-gray-700 cursor-pointer">
                <option value="">Other…</option>
                <% section.tally.projects.all.each do |project| %><option value="<%= project.repo %>"><%= project.name %></option><% end %>
              </select>
            <% end %>
            <%= button_to "No project", entry_project_path(item.id), method: :patch, params: back.merge(no_project: "1"),
                  class: "min-h-[30px] px-2.5 rounded-lg bg-gray-100 text-xs text-gray-700 cursor-pointer hover:bg-gray-200" %>
          </div>
        </div>
      <% end %>
      <% if untagged.size > 6 %></details><% end %>
      <% if untagged.empty? %>
        <p class="mt-2.5 text-[13px] text-gray-500">Every entry here has a project now.</p>
      <% end %>
    </div>
  <% end %>
<% end %>
