<% tones = { now: "color: #111827; font-weight: 600", future: "color: #D1D5DB", past: "color: #9CA3AF" } %>
<div class="min-w-0" data-controller="chart-tooltip">
  <%# A size container: below a 600px column the discs turn into dots, and
      the list beside the chart keeps the numbers. %>
  <div class="@container relative w-full aspect-[640/300]" data-action="mouseleave->chart-tooltip#hide">
    <svg viewBox="0 0 640 300" class="absolute inset-0 size-full overflow-visible" role="img" aria-label="<%= chart.aria_label %>">
      <path d="<%= chart.grid_path %>" stroke="#F0F1F3" stroke-width="1" fill="none"/>
      <% if (track = chart.track_path) %><path d="<%= track %>" stroke="#E5E7EB" stroke-width="1" fill="none"/><% end %>
      <% if (wash = chart.wash) %><path d="<%= wash.first %>" fill="<%= wash.last %>" opacity="0.12"/><% end %>
      <path d="<%= chart.base_path %>" stroke="#D1D5DB" stroke-width="1" fill="none"/>
      <% if chart.lines? %>
        <% chart.series.paths.each do |path, stroke| %>
          <path d="<%= path %>" stroke="<%= stroke %>" stroke-width="2" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
        <% end %>
        <path d="<%= chart.series.ends %>" fill="#ffffff" stroke="#9CA3AF" stroke-width="1"/>
      <% else %>
        <% chart.series.fills.each do |path, fill| %><path d="<%= path %>" fill="<%= fill %>"/><% end %>
      <% end %>
    </svg>

    <% chart.ticks.each do |tick| %>
      <span class="absolute left-0 -translate-y-1/2 text-[10px]/none text-gray-400 tabular-nums" style="top: <%= tick.top %>%"><%= tick.value %></span>
    <% end %>
    <% chart.labels.each do |label| %>
      <span class="absolute -translate-x-1/2 -translate-y-1/2 text-[11px]/none whitespace-nowrap"
            style="top: <%= chart.label_top %>%; left: <%= label.left %>%; <%= tones.fetch(label.tone) %>"><%= label.text %></span>
    <% end %>

    <% chart.columns.each_with_index do |column, i| %>
      <div class="group absolute inset-y-0" style="left: <%= column.left %>%; width: <%= column.width %>%"
           data-action="mouseenter->chart-tooltip#show mousemove->chart-tooltip#move"
           data-chart-tooltip-template-param="progress-tip-<%= i %>">
        <div class="absolute inset-x-px top-[8%] rounded-sm bg-gray-900/5 opacity-0 group-hover:opacity-100" style="height: <%= chart.hover_height %>%"></div>
      </div>
    <% end %>

    <% chart.discs.each do |disc| %>
      <a href="#progress-note-<%= disc.numbers.first %>" data-turbo="false" aria-label="<%= chart.disc_label(disc) %>"
         class="absolute z-[3] -translate-x-1/2 -translate-y-1/2 box-border inline-flex items-center justify-center h-[18px] px-1 rounded-full
                border-[1.5px] border-gray-900 text-[10.5px] font-semibold tabular-nums shadow-[0_0_0_2px_#fff] focus-visible:outline-none
                focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:ring-offset-2
                <%= disc.width > ProgressChart::Page::SHAPE.size ? 'min-w-[30px]' : 'min-w-[18px]' %>
                <%= disc.shipped? ? 'bg-gray-900 text-white' : 'bg-white text-gray-900' %>
                @max-[600px]:min-w-2 @max-[600px]:size-2 @max-[600px]:p-0 @max-[600px]:border @max-[600px]:text-[0px]"
         style="left: <%= chart.left(disc.x) %>%; top: <%= chart.top(disc.cy) %>%"><%= disc.label %></a>
    <% end %>

    <div data-chart-tooltip-target="tooltip" class="hidden absolute z-[5] pointer-events-none w-[210px] rounded-lg bg-gray-900 px-3 py-2.5 text-xs/snug text-gray-50 shadow-lg"></div>
    <% chart.columns.each_with_index do |column, i| %>
      <template id="progress-tip-<%= i %>">
        <div class="text-gray-400"><%= column.title %></div>
        <div class="mt-0.5 text-[15px] font-semibold"><%= column.total %></div>
        <% column.rows.each do |row| %>
          <div class="mt-1 flex items-center gap-2">
            <span class="inline-block w-3 h-[3px] rounded-sm" style="background: <%= row.color %>"></span>
            <span class="flex-1 text-gray-300"><%= row.name %></span>
            <span class="font-semibold tabular-nums"><%= row.n %><% if row.so_far %><span class="font-normal text-gray-400"> · <%= row.so_far %> so far</span><% end %></span>
          </div>
        <% end %>
        <% column.notes.each do |note| %>
          <div class="mt-1.5 flex gap-2 text-gray-200"><span class="w-3 shrink-0 text-center font-semibold"><%= note.mark %></span><span class="line-clamp-2"><%= note.title %></span></div>
        <% end %>
      </template>
    <% end %>
  </div>

  <% if (legend = chart.legend) %>
    <div class="mt-2.5 flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-xs text-gray-600">
      <% legend.first(ProgressChart::Page::LEGEND_SIZE).each do |row| %>
        <%= link_to progress_view_path(user, repo: row.repo), data: { turbo_frame: "_top" },
              class: "inline-flex items-center gap-1.5 py-0.5 hover:text-gray-900", title: "Show only #{row.name}" do %>
          <span class="inline-block rounded-[3px] <%= chart.lines? ? 'w-3.5 h-[3px]' : 'size-2.5' %>" style="background: <%= row.color %>"></span>
          <%= row.name %> <span class="text-gray-400 tabular-nums"><%= row.n %></span>
        <% end %>
      <% end %>
      <% if legend.size > ProgressChart::Page::LEGEND_SIZE %>
        <span class="text-gray-400">+<%= legend.size - ProgressChart::Page::LEGEND_SIZE %> more</span>
      <% end %>
    </div>
  <% end %>
</div>
