<%# Shares the first row with the counters beside it, and its rule. %>
<div class="order-3 min-[821px]:order-none mt-6 min-[821px]:mt-0 min-w-0 self-stretch flex items-end justify-between gap-2 pb-2 border-b border-gray-200">
  <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
    Shipped and published <%= section.labels.phrase %><%= " · #{section.selection_name}" if section.filtered? %>
  </p>
  <span class="inline-flex items-center gap-2.5 text-[11px] text-gray-500 whitespace-nowrap">
    <span class="inline-flex items-center gap-1"><svg class="size-[9px] shrink-0" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4.5" fill="#111827"/></svg>shipped</span>
    <span class="inline-flex items-center gap-1"><svg class="size-[9px] shrink-0" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.9" fill="#ffffff" stroke="#111827" stroke-width="1.3"/></svg>published</span>
  </span>
</div>
