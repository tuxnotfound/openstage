<% pick = section.pick %>
<% filled = '<svg class="size-[9px] shrink-0" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4.5" fill="#111827"/></svg>'.html_safe %>
<% hollow = '<svg class="size-[9px] shrink-0" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.9" fill="#ffffff" stroke="#111827" stroke-width="1.3"/></svg>'.html_safe %>
<div class="order-4 min-[821px]:order-none min-w-0">

  <% if pick.kept.any? %>
    <ol class="list-none m-0 p-0">
      <% pick.kept.each_with_index do |item, i| %>
        <% project = section.project.nil? && item.repo_name && section.tally.projects.find(item.repo_name) %>
        <li id="progress-note-<%= i + 1 %>" class="flex gap-2.5 py-2.5 border-b border-gray-100 scroll-mt-6">
          <span class="mt-px shrink-0 box-border inline-flex items-center justify-center size-5 rounded-full border-[1.5px] border-gray-900 text-[11px] font-semibold tabular-nums <%= item.shipped? ? 'bg-gray-900 text-white' : 'bg-white text-gray-900' %>"
                aria-label="<%= item.shipped? ? 'Shipped' : 'Published' %>"><%= i + 1 %></span>
          <div class="flex-1 min-w-0">
            <a href="#entry-<%= item.id %>" data-turbo="false" class="block line-clamp-3 text-sm/5 text-gray-900 hover:underline <%= item.shipped? ? 'font-semibold' : 'font-medium' %>"><%= item.title %>
              <% if (run_in = progress_run_in(item, section)).present? %><span class="font-normal text-gray-500"><%= run_in %></span><% end %></a>
            <div class="mt-[3px] flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-gray-400">
              <span class="tabular-nums"><%= item.date.strftime("%b %-d") %></span>
              <% if item.pinned? %><span class="text-amber-500">★ pinned</span><% end %>
              <% if project %>
                <span class="inline-flex items-center gap-1"><span class="inline-block size-[7px] rounded-full" style="background: <%= ProgressChart::Palette.project_color(project.rank) %>"></span><%= project.name %></span>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-3.5 text-[13px] text-gray-400">
      <%= section.filtered? ? section.labels.empty_tagged(section.selection_name(alternatives: true)) : section.labels.empty %>
      <% if current_user == user %><%= link_to "Log an entry", dashboard_path, data: { turbo_frame: "_top" }, class: "ml-1 text-gray-700 underline" %><% end %>
    </p>
  <% end %>

  <% if pick.left.any? %>
    <details class="mt-2.5 group">
      <summary class="list-none cursor-pointer text-xs text-gray-700 [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden"><%= pick.left.size %> more <%= section.labels.word %> ▾</span>
        <span class="hidden group-open:inline">Hide the other <%= pick.left.size %></span>
      </summary>
      <ul class="list-none mt-1.5 p-0">
        <% pick.left.each do |item| %>
          <li class="flex items-baseline gap-2 py-1.5 border-b border-gray-100 text-[13px]">
            <span class="self-center" role="img" aria-label="<%= item.shipped? ? 'Shipped' : 'Published' %>"><%= item.shipped? ? filled : hollow %></span>
            <a href="#entry-<%= item.id %>" data-turbo="false" class="flex-1 min-w-0 line-clamp-2 text-gray-700 hover:underline"><%= item.title %></a>
            <span class="text-xs text-gray-400 whitespace-nowrap tabular-nums"><%= item.date.strftime("%b %-d") %></span>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
