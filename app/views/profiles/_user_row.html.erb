<div class="flex items-center justify-between py-4 border-b border-gray-100 last:border-0">
  <a href="<%= profile_path(user.username) %>" class="flex items-center gap-3 min-w-0 hover:opacity-80 transition-opacity">
    <img src="<%= user.avatar_url %>"
         alt="<%= user.display_name %>"
         class="w-10 h-10 rounded-full ring-1 ring-gray-200 shrink-0">
    <div class="min-w-0">
      <p class="text-sm font-medium text-gray-900 truncate"><%= user.display_name %></p>
      <p class="text-xs text-gray-500 font-mono">@<%= user.username %></p>
    </div>
  </a>
  <%= render "profiles/follow_button", user: user, follow: follows_map[user.id] %>
</div>
