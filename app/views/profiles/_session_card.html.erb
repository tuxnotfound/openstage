<div id="<%= work.dom_id %>" class="flex gap-4 py-4 border-b border-gray-100 last:border-0 scroll-mt-6" data-session-size="<%= work.size %>">
  <div class="shrink-0 mt-0.5">
    <%= render "profiles/entry_icon", type: "shipped" %>
  </div>

  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <%= render "profiles/entry_badge", type: "shipped", source: "github" %>
          <span class="text-xs text-gray-400 truncate"><%= work.repo_name.split("/").last %></span>
          <span class="text-xs text-gray-400">&middot; <%= work.size %> commits</span>
        </div>

        <ul class="space-y-1">
          <% work.preview.each do |entry| %>
            <%= render "profiles/session_line", entry: entry %>
          <% end %>
        </ul>

        <% if work.rest.any? %>
          <details class="mt-1">
            <summary class="text-xs text-gray-400 hover:text-gray-700 cursor-pointer select-none">
              <%= pluralize(work.rest.size, "more commit") %> that day
            </summary>
            <ul class="space-y-1 mt-1">
              <% work.rest.each do |entry| %>
                <%= render "profiles/session_line", entry: entry %>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>

      <time datetime="<%= work.occurred_at.iso8601 %>"
            title="<%= work.occurred_at.strftime("%B %-d, %Y") %>"
            class="text-xs text-gray-400 whitespace-nowrap shrink-0">
        <%= time_ago_in_words(work.occurred_at) %> ago
      </time>
    </div>
  </div>
</div>
