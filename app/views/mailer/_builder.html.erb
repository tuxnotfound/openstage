<%# Whose updates these are: the builder's face and name, and their page's
    address, a link when url is given. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 16px; border-collapse: collapse;">
  <tr>
    <% if builder.avatar_url.present? %>
      <td style="padding: 0 12px 0 4px; vertical-align: middle;">
        <img src="<%= builder.avatar_url %>" width="44" height="44" alt="" style="display: block; width: 44px; height: 44px; border-radius: 22px;">
      </td>
    <% end %>
    <td style="vertical-align: middle;">
      <div style="font-family: <%= MailHelper::DISPLAY %>; font-size: 17px; font-weight: 700; color: #0E0F12;"><%= name %></div>
      <div style="margin-top: 2px; font-size: 13px; color: #666A73;">
        <% if local_assigns[:url] %><a href="<%= url %>" style="color: #666A73; text-decoration: none;"><%= address %></a><% else %><%= address %><% end %>
      </div>
    </td>
  </tr>
</table>
