<% content_for :dark_mode, true %>
<% content_for :main_class, "os-wrap pt-7.5" %>

<section class="os-panel mx-auto max-w-[560px] p-9 text-center">
  <h1 class="os-h2 text-[30px]">Unsubscribe?</h1>
  <p class="os-p mt-2.5">
    No more email about <%= @subscription.user.display_name %>'s work to <b class="text-ink [overflow-wrap:anywhere]"><%= @subscription.email %></b>.
  </p>
  <%= button_to "Unsubscribe", unsubscribe_subscription_path(@subscription.token), method: :post,
      form: { class: "mt-5" }, class: "os-btn" %>
</section>
