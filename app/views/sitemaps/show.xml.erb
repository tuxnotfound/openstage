<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc><%= root_url %></loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <% [ pricing_url, about_url, blog_url ].each do |page_url| %>
  <url>
    <loc><%= page_url %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <% end %>
  <% @posts.each do |post| %>
  <url>
    <loc><%= blog_post_url(post) %></loc>
    <lastmod><%= post.published_on.iso8601 %></lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>
  <% @users.each do |user| %>
  <url>
    <loc><%= profile_url(user.username) %></loc>
    <lastmod><%= (@last_entry_at[user.id] || user.created_at).utc.iso8601 %></lastmod>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  <% end %>
</urlset>