<div style="max-width: 600px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: #111827;">
  <p style="margin: 0 0 4px; font-size: 13px; color: #6B7280;"><%= @builder.display_name %>'s week on Openstage</p>
  <%= render "week", section: @section, link_label: "See the week on #{@builder.display_name}'s page", link_url: @profile_url %>

  <p style="margin: 28px 0 0; color: #6b7280; font-size: 12px;">You subscribed to <%= @builder.display_name %>'s updates on openstage.dev/<%= @builder.username %>. <%= link_to "Unsubscribe", @unsub_url, style: "color: #6b7280;" %>.</p>
  <p style="margin: 8px 0 0; color: #6b7280; font-size: 12px;">Openstage turns GitHub commits into a public proof-of-work page. <%= link_to "Get yours", @home_url, style: "color: #6b7280;" %>.</p>
</div>
