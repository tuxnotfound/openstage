<%# Whose week this is, before anything else: the reader asked for this
    builder's updates, so the email leads with them, not with the numbers. %>
<% address = "openstage.dev/#{@builder.username}#{"/#{@project.name}" if @project}" %>
<%= render "mailer/builder", builder: @builder, name: @project ? "#{@project.name}, by #{@builder.display_name}" : @builder.display_name,
                             address: address, url: @page_url %>
<%= render "week", section: @section, link_label: @project ? "See #{@project.name}'s page" : "See the week on #{@builder.display_name}'s page", link_url: @page_url %>

<p style="margin: 16px 4px 0; color: #666A73; font-size: 12px;">You subscribed to <%= @project ? "#{@project.name}'s" : "#{@builder.display_name}'s" %> updates on <%= address %>. <%= link_to "Unsubscribe", @unsub_url, style: "color: #666A73;" %>.</p>
<p style="margin: 8px 4px 0; color: #666A73; font-size: 12px;">Openstage keeps a public page of what you're building, project by project. <%= link_to "Get yours", @home_url, style: "color: #666A73;" %>.</p>
