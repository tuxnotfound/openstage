<div style="max-width: 600px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: #111827;">
  <%= render "week", section: @section, link_label: "Make your week's card", link_url: @card_url, log_url: @log_url %>

  <p style="margin: 24px 0 0; font-size: 13px; color: #4B5563;">Nothing is posted until you post it yourself.</p>
  <p style="margin: 16px 0 0; color: #6b7280; font-size: 12px;">You get this on Fridays when your week has three or more things in it. <%= link_to "Stop these emails", @stop_url, style: "color: #6b7280;" %>.</p>
</div>
