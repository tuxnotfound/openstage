<div style="max-width: 600px; font-family: 'Funnel Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: #0E0F12;">
  <%= render "week", section: @section, link_label: "Make your week's card", link_url: @card_url, log_url: @log_url %>

  <p style="margin: 24px 0 0; font-size: 13px; color: #43464D;">Nothing is posted until you post it yourself.</p>
  <p style="margin: 16px 0 0; color: #666A73; font-size: 12px;">You get this on Fridays when your week has three or more things in it. <%= link_to "Stop these emails", @stop_url, style: "color: #666A73;" %>.</p>
</div>
