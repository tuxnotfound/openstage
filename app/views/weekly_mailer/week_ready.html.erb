<%= simple_format(@draft.skeleton) %>

<% @draft.candidates_by_repo.each do |repo, list| %>
  <p><strong><%= repo %></strong></p>
  <ul>
    <% list.each do |candidate| %>
      <li><%= candidate.title %></li>
    <% end %>
  </ul>
<% end %>

<p><%= link_to "Make this week's card", @card_url %></p>
<p>Nothing is posted until you post it yourself.</p>

<p style="color: #6b7280; font-size: 12px;">You get this on Fridays when your week has three or more things in it. <%= link_to "Stop these emails", @stop_url %>.</p>
