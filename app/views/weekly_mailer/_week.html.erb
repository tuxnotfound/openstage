<%# The Week view of the progress section, as far as an email can draw it:
    the counters, the chart, the link, then the shipped and published list.
    No commit titles: the chart carries the commits. log_url: the builder's
    own email offers to log an entry when the list is empty. %>
<% labels = section.labels %>
<% now = section.tally.totals %>
<% before = section.tally.previous_totals %>
<% chart = ProgressChart::Email.new(section) %>
<% pick = section.pick %>
<% tiles = [
     [ "● Shipped", now.shipped, before&.shipped ],
     [ "○ Published", now.published, before&.published ],
     [ "Commits", now.commits, before&.commits ],
     [ "Active days", now.active_days, before&.active_days ],
     [ "Projects", now.projects, nil ]
   ] %>
<p style="margin: 0 0 14px; font-size: 18px; font-weight: 600; color: #111827;"><%= labels.nav %><span style="font-weight: 400; color: #9CA3AF;"><%= " · so far" if labels.running? %></span></p>

<div style="padding-bottom: 6px; border-bottom: 1px solid #E5E7EB;">
  <% tiles.each do |label, value, previous| %>
    <span style="display: inline-block; margin: 0 18px 8px 0; white-space: nowrap;">
      <span style="font-size: 18px; font-weight: 600; color: #111827;"><%= value %></span>
      <% if (delta = previous && progress_delta(value, previous)) %><span style="font-size: 12px; font-weight: 500; color: <%= delta.last ? '#15803D' : '#9CA3AF' %>;"><%= delta.first %></span><% end %>
      <br><span style="font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: #6B7280;"><%= label %></span>
    </span>
  <% end %>
</div>
<% if before && (versus = labels.versus) %>
  <p style="margin: 6px 0 0; font-size: 11px; color: #9CA3AF;">Changes <%= versus %>.</p>
<% end %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top: 16px; border-collapse: collapse; table-layout: fixed;">
  <tr>
    <% chart.days.each do |day| %>
      <td valign="bottom" style="height: <%= chart.column_height %>px; padding: 0 3px; vertical-align: bottom; text-align: center; border-bottom: 1px solid #D1D5DB;">
        <% day.discs.each do |disc| %>
          <span style="display: inline-block; min-width: 14px; height: 16px; padding: 0 2px; margin-bottom: 4px; border: 2px solid #111827; border-radius: 10px; font-size: 10px; line-height: 16px; font-weight: 600; <%= disc.shipped? ? 'background: #111827; color: #ffffff;' : 'background: #ffffff; color: #111827;' %>"><%= disc.label %></span>
        <% end %>
        <% day.segments.each_with_index do |segment, i| %>
          <div style="max-width: 28px; height: <%= segment.height %>px; margin: 0 auto; background: <%= segment.color %>; font-size: 0; line-height: 0; <%= i.zero? ? 'border-radius: 3px 3px 0 0;' : 'border-top: 2px solid #ffffff;' %>">&nbsp;</div>
        <% end %>
      </td>
    <% end %>
  </tr>
  <tr>
    <% chart.days.each do |day| %>
      <td style="padding-top: 6px; text-align: center; font-size: 11px; white-space: nowrap; <%= day.current ? 'color: #111827; font-weight: 600;' : 'color: #9CA3AF;' %>"><%= day.label %></td>
    <% end %>
  </tr>
</table>

<% if (legend = chart.legend) %>
  <p style="margin: 10px 0 0; font-size: 12px; color: #4B5563;">
    <% legend.first(ProgressChart::Page::LEGEND_SIZE).each do |row| %>
      <span style="display: inline-block; margin-right: 12px; white-space: nowrap;"><span style="display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: <%= row.color %>;"></span> <%= row.name %> <span style="color: #9CA3AF;"><%= row.n %></span></span>
    <% end %>
    <% if legend.size > ProgressChart::Page::LEGEND_SIZE %>
      <span style="color: #9CA3AF;">+<%= legend.size - ProgressChart::Page::LEGEND_SIZE %> more</span>
    <% end %>
  </p>
<% end %>

<p style="margin: 24px 0;">
  <a href="<%= link_url %>" style="display: inline-block; padding: 10px 18px; border-radius: 8px; background: #111827; color: #ffffff; font-size: 14px; font-weight: 600; text-decoration: none;"><%= link_label %></a>
</p>

<p style="margin: 0; padding-bottom: 8px; border-bottom: 1px solid #E5E7EB; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #9CA3AF;">Shipped and published <%= labels.phrase %></p>
<% if pick.kept.any? %>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse;">
    <% pick.kept.each_with_index do |item, i| %>
      <% project = item.repo_name && section.tally.projects.find(item.repo_name) %>
      <tr>
        <td valign="top" style="width: 30px; padding: 10px 0; vertical-align: top; border-bottom: 1px solid #F3F4F6;">
          <span style="display: inline-block; width: 18px; height: 18px; border: 2px solid #111827; border-radius: 11px; text-align: center; font-size: 11px; line-height: 18px; font-weight: 600; <%= item.shipped? ? 'background: #111827; color: #ffffff;' : 'background: #ffffff; color: #111827;' %>"><%= i + 1 %></span>
        </td>
        <td style="padding: 10px 0; border-bottom: 1px solid #F3F4F6;">
          <div style="font-size: 14px; line-height: 20px; color: #111827; font-weight: <%= item.shipped? ? 600 : 500 %>;"><%= item.title %><% if (run_in = progress_run_in(item, section)).present? %><span style="font-weight: 400; color: #6B7280;"><%= run_in %></span><% end %></div>
          <div style="margin-top: 3px; font-size: 12px; color: #9CA3AF;">
            <%= item.date.strftime("%b %-d") %><% if project %> · <span style="display: inline-block; width: 7px; height: 7px; border-radius: 4px; background: <%= ProgressChart::Palette.project_color(project.rank) %>;"></span> <%= project.name %><% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </table>
  <% if pick.left.any? %>
    <p style="margin: 10px 0 0; font-size: 12px; color: #6B7280;"><%= pick.left.size %> more <%= labels.word %> on the page.</p>
  <% end %>
<% else %>
  <p style="margin: 12px 0 0; font-size: 13px; color: #9CA3AF;">
    <%= labels.empty %>
    <% if local_assigns[:log_url] %><a href="<%= log_url %>" style="color: #374151;">Log an entry</a><% end %>
  </p>
<% end %>
