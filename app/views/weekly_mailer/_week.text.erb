<% labels = section.labels %>
<% now = section.tally.totals %>
<% pick = section.pick %>
<%= labels.nav %><%= " · so far" if labels.running? %>

<% counters = [ [ now.shipped, "#{now.shipped} shipped" ], [ now.published, "#{now.published} published" ], [ now.commits, pluralize(now.commits, "commit") ],
                [ now.active_days, pluralize(now.active_days, "active day") ], [ now.projects, pluralize(now.projects, "project") ] ] %>
<%= counters.reject { |count, _words| local_assigns[:follower] && count.zero? }.map(&:last).join(" · ") %>

Shipped and published <%= labels.phrase %>:
<% if pick.kept.any? %>
<% pick.kept.each_with_index do |item, i| %>
<%= i + 1 %>. <%= item.shipped? ? "●" : "○" %> <%= item.title %> (<%= item.date.strftime("%b %-d") %>)
<% end %>
<% if pick.left.any? %>
<%= pick.left.size %> more <%= labels.word %> on the page.
<% end %>
<% else %>
<%= labels.empty %>
<% if local_assigns[:log_url] %>
Log an entry: <%= log_url %>
<% end %>
<% end %>

<%= link_label %>: <%= link_url %>
