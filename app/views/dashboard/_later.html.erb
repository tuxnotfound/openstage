<%# The numbers projects will carry beside commits, named before they ship. %>
<section class="os-panel" aria-labelledby="coming-later">
  <h2 id="coming-later" class="os-h3">Coming later</h2>
  <p class="os-xs os-muted mt-0.5 mb-2">Numbers you can add to each project.</p>
  <% [ [ "Revenue", "Stripe, RevenueCat" ], [ "Visits", "Plausible" ], [ "Downloads", "npm, the App Store, itch.io" ] ].each do |what, from| %>
    <div class="os-row os-between py-2">
      <span><span class="block text-sm font-bold"><%= what %></span><span class="os-xs os-muted"><%= from %></span></span>
      <button type="button" class="os-btn2 sm" disabled>Soon</button>
    </div>
  <% end %>
</section>
