<%# The Entries tab: What's new, Commits, what the builder hid, and the
    private ones, a switch a row and the rest in its menu. One search and one
    repo narrow every list; they redraw the lists in one frame, and a click
    on a row redraws only what it changed (entries/changed), so the page
    never reloads or jumps. The lists are links and the buttons plain forms,
    so it all works without JavaScript too. %>
<% active = entry_tab_active(@entry_tabs) %>
<section id="entries" class="os-panel dt-panel" aria-label="Entries"
         data-controller="tabs entries-filter" data-tabs-active-value="<%= active %>" data-tabs-param-value="list"
         data-tabs-default-value="<%= entry_tab_default(@entry_tabs) %>"
         data-action="submit->entries-filter#carry:capture">
  <div class="dt-tools">
    <%= render "dashboard/entry_tabs", tabs: @entry_tabs, active: active %>
    <%= render "dashboard/entries_filter", active: active %>
  </div>
  <%= render "dashboard/entry_lists", tabs: @entry_tabs %>
</section>
