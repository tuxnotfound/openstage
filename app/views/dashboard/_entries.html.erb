<%# Every entry, findable without scrolling the whole history, then what was
    hidden and what only the builder sees. One search, type and repo narrow
    every tab; they redraw the tabs and lists in one frame, and a click on a
    row redraws only what it changed (entries/changed), so the page never
    reloads or jumps. The tabs are links and the buttons plain forms, so it
    all works without JavaScript too. %>
<section id="entries" class="os-panel scroll-mt-4" aria-label="Entries"
         data-controller="tabs entries-filter" data-tabs-active-value="<%= entry_tab_active(@entry_tabs) %>" data-tabs-param-value="tab"
         data-action="submit->entries-filter#carry:capture">
  <%= render "dashboard/entries_filter" %>
  <%= render "dashboard/entry_lists", tabs: @entry_tabs %>
</section>
