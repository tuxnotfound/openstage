<%# Search, type and repo narrow every tab. The form sits outside the
    frame of the tabs and lists, so the field keeps its focus and caret while
    they redraw as the builder types; the URL follows, with the tab shown
    (entries_filter controller). Without JavaScript it is a plain GET. Only
    repos with entries are offered. %>
<% filter = entries_filter %>
<%= form_with url: dashboard_path(anchor: "entries"), method: :get, class: "flex flex-wrap items-center gap-2",
      data: { entries_filter_target: "form", turbo_frame: "entries-lists", turbo_action: "advance" } do %>
  <%= hidden_field_tag :tab, entry_tab_active(@entry_tabs), id: nil, data: { entries_filter_target: "tab", entries_filter_default: "timeline" } %>
  <%= search_field_tag :q, filter.query, placeholder: "Search your entries…", enterkeyhint: "search", autocomplete: "off",
        aria: { label: "Search your entries" }, data: { action: "input->entries-filter#search" }, class: "os-field h-9 min-w-48 flex-1 text-sm" %>
  <%= select_tag :type, options_for_select([ [ "All types", "" ] ] + Entry.entry_types.keys.map { |t| [ t.humanize, t ] }, filter.type),
        data: { action: "change->entries-filter#change" }, aria: { label: "Type" }, class: "os-field h-9 w-auto cursor-pointer text-sm" %>
  <% if filter.repos.many? %>
    <%= select_tag :repo, options_for_select([ [ "All repos", "" ] ] + filter.repos.map { |name| [ name.split("/").last, name ] }, filter.repo),
          data: { action: "change->entries-filter#change" }, aria: { label: "Repo" }, class: "os-field h-9 w-auto cursor-pointer text-sm" %>
  <% end %>
  <%= submit_tag "Search", name: nil, class: "os-btn2 sm max-sm:hidden" %>
  <%= link_to "Clear", dashboard_path(tab: entry_tab_active(@entry_tabs), anchor: "entries"), hidden: !filter.any?,
        data: { entries_filter_target: "clear", action: "entries-filter#clear" }, class: "os-link text-sm" %>
<% end %>
