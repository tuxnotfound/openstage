<%# Search and repo narrow every list. The form sits outside the frame of
    the lists, so the field keeps its focus and caret while they redraw as
    the builder types; the address follows, with the list shown
    (entries_filter controller). Without JavaScript it is a plain GET. Only
    repos with entries are offered. %>
<% filter = entries_filter %>
<%= form_with url: dashboard_path, method: :get, class: "dt-filter",
      data: { entries_filter_target: "form", turbo_frame: "entries-lists", turbo_action: "advance" } do %>
  <%= hidden_field_tag :tab, "entries", id: nil %>
  <%= hidden_field_tag :list, active, id: nil, data: { entries_filter_target: "tab", entries_filter_default: entry_tab_default(@entry_tabs) } %>
  <%= search_field_tag :q, filter.query, placeholder: "Search your entries…", enterkeyhint: "search", autocomplete: "off",
        aria: { label: "Search your entries" }, data: { action: "input->entries-filter#search" }, class: "os-field dt-find" %>
  <% if filter.repos.many? %>
    <%= select_tag :repo, options_for_select([ [ "All repos", "" ] ] + filter.repos.map { |name| [ name.split("/").last, name ] }, filter.repo),
          data: { action: "change->entries-filter#change" }, aria: { label: "Repo" }, class: "os-field dt-select" %>
  <% end %>
<% end %>
