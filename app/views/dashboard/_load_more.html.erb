<%# The next ten, appended under these (index.turbo_stream), so the scroll
    stays put. It starts past the last row shown, by value, so rows hidden or
    restored above it since never shift it. Without JavaScript it opens that
    page. %>
<div id="entries-more-<%= tab.key %>" class="dt-more">
  <%= link_to "Load more", dashboard_path(**entries_filter.to_params, tab: "entries", list: tab.key, before: tab.cursor),
        class: "os-btn2 sm", data: { turbo_stream: true, turbo_frame: "_top" } %>
</div>
