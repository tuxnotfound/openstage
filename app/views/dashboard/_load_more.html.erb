<%# The next page, appended under this one (index.turbo_stream), so the
    scroll stays put. It starts past the last row shown, by value, so rows
    hidden or restored above it since never shift it. Without JavaScript it
    opens that page. %>
<div id="entries-more-<%= tab.key %>" class="mt-3 text-center">
  <%= link_to "Load more", dashboard_path(**entries_filter.to_params, tab: tab.key, before: tab.cursor, anchor: "entries"),
        class: "os-btn2 sm", data: { turbo_stream: true, turbo_frame: "_top" } %>
</div>
