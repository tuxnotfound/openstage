<section class="os-panel" aria-labelledby="upgrade">
  <h2 id="upgrade" class="os-h3">Keep the audience you build</h2>
  <p class="os-xs os-muted mt-1">Pro gives you your subscriber list, analytics, private entries and pins.</p>
  <div class="mt-3 flex items-center gap-2">
    <%= button_to "$49 once", checkout_path(plan: "lifetime"), method: :post, form: { data: { turbo: false } }, class: "os-btn sm" %>
    <%= button_to "or $7/mo", checkout_path(plan: "monthly"), method: :post, form: { data: { turbo: false } }, class: "os-btn2 sm" %>
  </div>
</section>
