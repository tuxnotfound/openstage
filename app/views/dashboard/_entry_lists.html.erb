<%# The tabs, with how many entries the filters match in each, and a panel
    per tab: one frame, which the filters redraw whole. %>
<% active = entry_tab_active(tabs) %>
<%= turbo_frame_tag "entries-lists", class: "mt-3.5 block" do %>
  <%= render "dashboard/entry_tabs", tabs: tabs, active: active %>
  <% tabs.each do |tab| %>
    <div data-tabs-target="panel" data-tabs-panel="<%= tab.key %>" role="tabpanel" aria-label="<%= DashboardHelper::ENTRY_TABS[tab.key] %>"
         class="<%= "hidden" unless tab.key == active %>">
      <%= render "dashboard/entry_list", tab: tab %>
    </div>
  <% end %>
<% end %>
