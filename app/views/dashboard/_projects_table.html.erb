<%# Your projects, under the chart: each with Edit up front, whether the
    chart draws it, whether the builder's page shows it, and its value in the
    window for each number. A project counting no site visits offers to set
    them up; one hidden from the page comes last. On a phone each row stacks,
    each control under its label. table: a DashboardProjectsSerializer's
    attributes; kept: the dashboard's other params. %>
<% range = (section.labels.range unless section.labels.range == DashboardController::ACTIVITY_RANGE) %>
<div class="mt-6" id="activity-lines">
  <% if table[:rows].empty? %>
    <p class="os-sm os-ink2">No repo has commits here yet. Your public repos appear once the first sync is done.</p>
  <% else %>
    <table class="w-full table-fixed border-collapse text-sm max-sm:block">
      <caption class="sr-only">Your projects: what this chart and your page show of each</caption>
      <thead class="max-sm:hidden">
        <tr class="text-xs text-ink-3">
          <th scope="col" class="py-2 text-left font-bold">Your projects</th>
          <th scope="col" class="w-24 py-2 text-right font-bold">On the chart</th>
          <th scope="col" class="w-24 py-2 text-right font-bold">Your page</th>
          <% table[:columns].each do |column| %>
            <th scope="col" class="w-28 py-2 text-right font-bold"><%= column[:label] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="max-sm:block">
        <% table[:rows].each do |row| %>
          <% off = row[:page] && !row[:page][:on] %>
          <tr class="border-t border-line max-sm:grid max-sm:grid-cols-4 max-sm:gap-x-2 max-sm:gap-y-2.5 max-sm:py-3" data-line-row="<%= row[:repo] %>">
            <th scope="row" class="py-2.5 text-left font-bold max-sm:col-span-4 max-sm:py-0">
              <span class="flex min-w-0 items-center gap-2.5">
                <span class="os-dot <%= project_class(row[:rank]) %> bg-(--project) shrink-0 <%= 'opacity-40' if off || row[:chart] == false %>"></span>
                <span class="truncate <%= 'text-ink-3' if off %>"><%= row[:name] %></span>
                <%= link_to "Edit", row[:edit], class: "os-btn2 sm shrink-0", aria: { label: "Edit #{row[:name]}" } if row[:edit] %>
              </span>
            </th>
            <td class="py-2.5 text-right max-sm:py-0 max-sm:text-left">
              <span class="os-xs os-muted mb-1 block sm:hidden">On the chart</span>
              <% unless row[:chart].nil? %>
                <%= link_to "", dashboard_chart_path(kept, section, row[:repo]), role: "switch", class: "os-switch inline-block align-middle",
                      aria: { checked: row[:chart], label: "Draw #{row[:name]} on the chart" } %>
              <% end %>
            </td>
            <td class="py-2.5 text-right max-sm:py-0 max-sm:text-left">
              <span class="os-xs os-muted mb-1 block sm:hidden">Your page</span>
              <% if row[:page] %>
                <%= form_with url: row[:page][:path], method: :patch, class: "inline-flex", data: { turbo: false } do %>
                  <%= hidden_field_tag :included, (!row[:page][:on]).to_s, id: nil %>
                  <%= hidden_field_tag :range, range, id: nil if range %>
                  <button type="submit" role="switch" aria-checked="<%= row[:page][:on] %>" aria-label="Show <%= row[:name] %> on your page" class="os-switch"></button>
                <% end %>
              <% end %>
            </td>
            <% table[:columns].each do |column| %>
              <% value = row[:values][column[:key]] %>
              <td class="py-2.5 text-right max-sm:py-0 max-sm:text-left">
                <span class="os-xs os-muted mb-1 block sm:hidden"><%= column[:label] %></span>
                <% if value %>
                  <span class="os-num tabular-nums"><%= value %></span>
                <% elsif column[:key] == "visits" && row[:setup] %>
                  <%= link_to "Set up", row[:setup], aria: { label: "Set up #{row[:name]}'s site visits" },
                        class: "inline-flex h-[22px] items-center rounded-full border border-line px-2.5 text-[11px] font-bold text-ink-2 hover:border-accent hover:text-accent-ink" %>
                <% else %>
                  <span class="os-xs os-muted">–</span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="os-note mt-2">Values are the <%= section.labels.words %>. On the chart picks what it draws; Your page, what visitors see.</p>
  <% end %>
</div>
