<% content_for :title, "Dashboard — Openstage" %>
<% content_for :main_class, "os-wrap os-stack pt-1.5" %>

<% if @show_pro_activated %>
  <p role="status" class="rounded-control bg-accent-soft px-4 py-3 os-sm font-semibold">🎉 You're Pro! All features are now unlocked.</p>
<% end %>

<div class="flex items-center gap-2.5">
  <h1 class="os-h2 text-[30px]">Dashboard</h1>
  <% if current_user.pro? %><span class="os-tag pro">✦ Pro</span><% end %>
</div>

<%= render "dashboard/this_week", section: @activity %>
<%= render "dashboard/composer" %>

<%# The chart over the table of projects that switches it: hiding a project
    from the page reloads the page here, and its line is gone. %>
<div id="activity" class="scroll-mt-4">
  <%= render "dashboard/activity", chart: @chart if @chart %>
</div>
<% if @badge_nudge || !current_user.pro? %>
  <div class="grid items-start gap-4 lg:grid-cols-2">
    <%= render "dashboard/badge" if @badge_nudge %>
    <%= render "dashboard/upgrade" unless current_user.pro? %>
  </div>
<% end %>

<%= render "dashboard/entries" %>
