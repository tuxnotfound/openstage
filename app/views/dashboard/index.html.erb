<% content_for :title, "Dashboard — Openstage" %>
<% content_for :main_class, "os-wrap os-stack pt-1.5" %>

<% if @show_pro_activated %>
  <p role="status" class="rounded-control bg-accent-soft px-4 py-3 os-sm font-semibold">🎉 You're Pro! All features are now unlocked.</p>
<% end %>

<div class="flex items-center gap-2.5">
  <h1 class="os-h2 text-[30px]">Dashboard</h1>
  <% if current_user.pro? %><span class="os-tag pro">✦ Pro</span><% end %>
</div>

<%= render "dashboard/composer" %>
<%= render "dashboard/upgrade" unless current_user.pro? %>

<%# Two tabs, each with its count, and whether GitHub is synced at the end of
    their line. Links, so a tab opens without JavaScript; with it, the tabs
    controller switches in place and keeps the tab in the address. %>
<div class="os-stack" data-controller="tabs" data-tabs-active-value="<%= @tab %>" data-tabs-param-value="tab">
  <div class="dt-tabsrow">
    <div class="dt-tabs" role="tablist" aria-label="Dashboard">
      <% [ [ "projects", "Projects", dashboard_projects.count("all") ], [ "entries", "Entries", entries_total(@entry_tabs) ] ].each do |key, label, count| %>
        <%= link_to dashboard_path(tab: (key unless key == DashboardController::TABS.first)), id: "tab-#{key}", class: "dt-tab", role: "tab",
              aria: { selected: key == @tab, controls: "panel-#{key}" }, data: { tabs_target: "tab", tabs_tab: key, action: "tabs#show" } do %><%= label %> <span class="dt-count"><%= number_with_delimiter(count) %></span><% end %>
      <% end %>
    </div>
    <%= render "dashboard/sync" %>
  </div>
  <% if (error = @sync_logs.first&.error_message).present? %>
    <p class="os-xs -mt-2 line-clamp-2 font-semibold <%= @sync_logs.first.failed? ? 'text-down' : 'text-warn' %>" title="<%= error %>"><%= error %></p>
  <% end %>

  <div id="panel-projects" role="tabpanel" aria-labelledby="tab-projects" data-tabs-target="panel" data-tabs-panel="projects" class="<%= "hidden" unless @tab == "projects" %>">
    <%= react_island("dashboard_projects",
                     { initial: DashboardProjectsSerializer.new(dashboard_projects).as_json, endpoint: api_dashboard_projects_path,
                       open: (DashboardLinesSerializer.new(@open_lines, color_class: dashboard_projects.color_class(@open_lines.repo)).as_json if @open_lines),
                       row: params[:row].presence&.to_i, history: sync_history(@sync_logs) },
                     id: "dashboard-projects") %>
  </div>
  <div id="panel-entries" role="tabpanel" aria-labelledby="tab-entries" data-tabs-target="panel" data-tabs-panel="entries" class="<%= "hidden" unless @tab == "entries" %>">
    <%= render "dashboard/entries" %>
  </div>
</div>
