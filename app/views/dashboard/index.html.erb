<% content_for :title, "Dashboard — Openstage" %>

<% if @show_pro_activated %>
  <div class="bg-emerald-50 border border-emerald-200 rounded-xl px-5 py-4 mb-6 flex items-center gap-3">
    <span class="text-lg">🎉</span>
    <p class="text-sm font-medium text-emerald-800">You're Pro! All features are now unlocked.</p>
  </div>
<% end %>

<!-- Header -->
<div class="flex items-center justify-between mb-6">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-bold">Dashboard</h1>
      <% if current_user.pro? %>
        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">✦ Pro</span>
      <% end %>
    </div>
    <% if @streak > 0 %>
      <div class="flex items-center gap-1.5 mt-1 text-sm text-gray-500">
        <span><%= streak_emoji(@streak) %></span>
        <span class="font-medium text-gray-700"><%= @streak %>-day streak</span>
        <% unless @logged_today %>
          <span class="text-amber-500 text-xs">· Log something to keep it alive</span>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-3 text-sm text-gray-500">
      <% if @last_github_sync %>
        <span>Synced <%= time_ago_in_words(@last_github_sync) %> ago</span>
      <% else %>
        <span>Never synced</span>
      <% end %>
      <%= button_to "Sync now", sync_github_path, method: :post,
          class: "text-xs bg-gray-900 text-white px-3 py-1.5 rounded-md hover:bg-gray-700 transition-colors" %>
    </div>
    <%= link_to "View Timeline", profile_path(current_user.username), class: "text-sm text-gray-400 hover:text-gray-900 transition-colors" %>
  </div>
</div>

<!-- Analytics (free: 7-day sparkline + unique visitors; Pro: full breakdown) -->
<%= render "dashboard/analytics" %>

<!-- Upgrade CTA (free users only) -->
<% unless current_user.pro? %>
  <div class="bg-gradient-to-r from-gray-900 to-gray-800 rounded-xl px-6 py-5 mb-6 flex items-center justify-between">
    <div>
      <p class="text-white font-semibold text-sm">Upgrade to Pro</p>
      <p class="text-gray-400 text-xs mt-1">Analytics, private entries, pinned posts, and more.</p>
    </div>
    <div class="flex items-center gap-2">
      <%= button_to "Monthly — $7/mo", checkout_path(plan: "monthly"), method: :post,
          form: { data: { turbo: false } },
          class: "text-xs bg-white text-gray-900 px-4 py-2 rounded-lg font-medium hover:bg-gray-100 transition-colors cursor-pointer" %>
      <%= button_to "Lifetime — $49", checkout_path(plan: "lifetime"), method: :post,
          form: { data: { turbo: false } },
          class: "text-xs bg-amber-400 text-gray-900 px-4 py-2 rounded-lg font-medium hover:bg-amber-300 transition-colors cursor-pointer" %>
    </div>
  </div>
<% end %>

<!-- Stats bar -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
  <div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
    <div class="text-xl font-bold text-gray-900"><%= @stats[:total] %></div>
    <div class="text-xs text-gray-400 mt-0.5">Total entries</div>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
    <div class="text-xl font-bold text-gray-900"><%= @stats[:this_week] %></div>
    <div class="text-xs text-gray-400 mt-0.5">This week</div>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
    <div class="text-xl font-bold text-gray-900"><%= @stats[:github] %></div>
    <div class="text-xs text-gray-400 mt-0.5">From GitHub</div>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
    <div class="text-xl font-bold text-gray-900"><%= @stats[:manual] %></div>
    <div class="text-xs text-gray-400 mt-0.5">Manual posts</div>
  </div>
</div>



<!-- Entry composer (collapsible) -->
<div class="mb-6" data-controller="toggle">
  <button data-action="click->toggle#toggle"
          class="w-full flex items-center justify-between bg-white border border-gray-200 rounded-xl px-5 py-3.5 hover:border-gray-300 transition-colors group">
    <span class="text-sm font-medium text-gray-700 group-hover:text-gray-900">+ Post an update</span>
    <svg data-toggle-target="openIcon" class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
    <svg data-toggle-target="closeIcon" class="w-4 h-4 text-gray-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
    </svg>
  </button>

  <div data-toggle-target="content" class="hidden">
    <div class="bg-white border border-gray-200 border-t-0 rounded-b-xl px-6 py-5">
      <%= form_with url: entries_path, method: :post, scope: :entry do |f| %>
        <div class="flex flex-wrap gap-2 mb-4">
          <% [
            ["milestone", "Milestone"],
            ["shipped",   "Shipped"],
            ["note",      "Note"],
            ["link",      "Link"],
            ["released",  "Released"],
          ].each do |value, label| %>
            <label class="cursor-pointer">
              <%= f.radio_button :entry_type, value, id: "entry_type_#{value}", class: "peer sr-only", checked: value == "milestone" %>
              <span class="peer-checked:bg-gray-900 peer-checked:text-white inline-block px-3 py-1.5 rounded-full text-xs font-medium border border-gray-200 text-gray-600 hover:border-gray-400 transition-colors">
                <%= label %>
              </span>
            </label>
          <% end %>
        </div>

        <%= f.text_field :title,
            placeholder: "What did you do?",
            class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent mb-3" %>

        <%= f.text_area :body,
            placeholder: "More detail (optional)",
            rows: 3,
            class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent mb-3 resize-none" %>

        <div class="flex flex-col sm:flex-row gap-3 mb-3">
          <%= f.url_field :url,
              placeholder: "Link (optional)",
              class: "flex-1 border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          <%= f.datetime_local_field :occurred_at,
              value: Time.current.strftime("%Y-%m-%dT%H:%M"),
              class: "border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
        </div>

        <%= f.text_field :repo_name,
            list: "project-suggestions",
            placeholder: "Project / repo (optional)",
            class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent mb-4" %>
        <datalist id="project-suggestions">
          <% current_user.project_names.each do |name| %><option value="<%= name %>"></option><% end %>
        </datalist>

        <%= f.submit "Post entry",
            class: "bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Sync history (collapsible, only shown if logs exist) -->
<% if @sync_logs.any? %>
  <div class="mb-6" data-controller="toggle">
    <button data-action="click->toggle#toggle"
            class="flex items-center gap-2 text-xs font-semibold text-gray-400 uppercase tracking-wide mb-0 hover:text-gray-600 transition-colors">
      <span>Sync history</span>
      <svg data-toggle-target="openIcon" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
      <svg data-toggle-target="closeIcon" class="w-3 h-3 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
      </svg>
    </button>

    <div data-toggle-target="content" class="hidden mt-3">
      <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100 overflow-hidden">
        <% @sync_logs.each do |log| %>
          <div class="flex items-center justify-between px-4 py-2.5">
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full <%= log.success? ? 'bg-green-500' : log.failed? ? 'bg-red-400' : 'bg-yellow-400' %>"></span>
              <span class="text-xs text-gray-600 capitalize"><%= log.source %></span>
              <% if log.success? && log.entries_added > 0 %>
                <span class="text-xs text-gray-400">+<%= log.entries_added %> entries</span>
              <% end %>
              <% if log.error_message.present? %>
                <span class="text-xs <%= log.failed? ? 'text-red-400' : 'text-amber-600' %> truncate max-w-xs" title="<%= log.error_message %>"><%= log.error_message %></span>
              <% end %>
            </div>
            <time class="text-xs text-gray-400"><%= time_ago_in_words(log.ran_at) %> ago</time>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<!-- Timeline + Hidden + Private tabs -->
<div data-controller="tabs">
  <!-- Tab bar -->
  <div class="flex items-center gap-1 border-b border-gray-100 mb-4">
    <button data-tabs-target="tab"
            data-tabs-tab="timeline"
            data-action="click->tabs#show"
            class="px-4 py-2 text-sm font-medium transition-colors data-[active=true]:text-gray-900 data-[active=true]:border-b-2 data-[active=true]:border-gray-900 data-[active=true]:-mb-px data-[active=false]:text-gray-500 data-[active=false]:hover:text-gray-900">
      Timeline (<%= @timeline_count %>)
    </button>
    <% if @hidden_entries.any? %>
      <button data-tabs-target="tab"
              data-tabs-tab="hidden"
              data-action="click->tabs#show"
              class="px-4 py-2 text-sm font-medium transition-colors data-[active=true]:text-gray-900 data-[active=true]:border-b-2 data-[active=true]:border-gray-900 data-[active=true]:-mb-px data-[active=false]:text-gray-500 data-[active=false]:hover:text-gray-900">
        Hidden (<%= @hidden_entries.size %>)
      </button>
    <% end %>
    <% if @private_entries.any? %>
      <button data-tabs-target="tab"
              data-tabs-tab="private"
              data-action="click->tabs#show"
              class="px-4 py-2 text-sm font-medium transition-colors data-[active=true]:text-gray-900 data-[active=true]:border-b-2 data-[active=true]:border-gray-900 data-[active=true]:-mb-px data-[active=false]:text-gray-500 data-[active=false]:hover:text-gray-900">
        Private (<%= @private_entries.size %>)
      </button>
    <% end %>
  </div>

  <!-- Timeline panel -->
  <div data-tabs-target="panel" data-tabs-panel="timeline">

    <!-- Find an entry without scrolling the whole history -->
    <%= form_with url: dashboard_path, method: :get, data: { controller: "autosubmit" },
                  class: "flex flex-wrap items-center gap-2 mb-4" do %>
      <div class="relative flex-1 min-w-48">
        <%= search_field_tag :q, @query, placeholder: "Search your entries…", enterkeyhint: "search",
              autocomplete: "off",
              class: "w-full text-base sm:text-sm rounded-lg border border-gray-200 pl-9 pr-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900" %>
        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/>
        </svg>
      </div>

      <%= select_tag :type,
            options_for_select([ [ "All types", "" ] ] + Entry.entry_types.keys.map { |t| [ t.humanize, t ] }, @type_filter),
            data: { action: "change->autosubmit#submit" },
            class: "text-sm rounded-lg border border-gray-200 px-2.5 py-2 text-gray-600 bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 cursor-pointer" %>

      <%= submit_tag "Search", class: "text-sm px-3 py-2 rounded-lg border border-gray-200 text-gray-700 hover:bg-gray-50 cursor-pointer" %>

      <% if @query.present? || @type_filter %>
        <%= link_to "Clear", dashboard_path, class: "text-sm text-gray-500 hover:text-gray-900 px-2" %>
      <% end %>
    <% end %>

    <% if @query.present? || @type_filter %>
      <p class="text-xs text-gray-400 mb-3">
        <%= pluralize(@filtered_count, "entry") %> of <%= @timeline_count %>
      </p>
    <% end %>

    <% if @entries.empty? %>
      <div class="text-center py-12 text-gray-400 text-sm border border-dashed border-gray-200 rounded-xl">
        <% if @query.present? || @type_filter %>
          No entries match that. <%= link_to "Clear the filters", dashboard_path, class: "underline hover:text-gray-600" %>.
        <% else %>
          Nothing here yet — post your first update above.
        <% end %>
      </div>
    <% else %>
      <div id="dashboard-entries" class="border border-gray-200 rounded-xl divide-y divide-gray-100 overflow-hidden">
        <% @entries.each do |entry| %>
          <%= render "dashboard/entry_row", entry: entry %>
        <% end %>
      </div>

      <% if @entries.next_page %>
        <div id="dashboard-load-more" class="mt-4 text-center">
          <%= link_to "Load more",
              dashboard_path(page: @entries.next_page, q: @query.presence, type: @type_filter),
              class: "text-sm text-gray-500 hover:text-gray-900 border border-gray-200 rounded-lg px-5 py-2.5 inline-block transition-colors",
              data: { turbo_stream: true } %>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Hidden panel -->
  <% if @hidden_entries.any? %>
    <div data-tabs-target="panel" data-tabs-panel="hidden" class="hidden">
      <div class="border border-gray-200 rounded-xl divide-y divide-gray-100 overflow-hidden">
        <% @hidden_entries.each do |entry| %>
          <div class="group flex gap-4 p-4 hover:bg-gray-50 transition-colors">
            <div class="shrink-0 mt-0.5">
              <%= render "profiles/entry_icon", type: entry.entry_type %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5">
                    <%= render "profiles/entry_badge", type: entry.entry_type, source: entry.source %>
                    <% if entry.repo_name.present? %>
                      <span class="text-xs text-gray-400 truncate"><%= entry.repo_name.split("/").last %></span>
                    <% end %>
                  </div>
                  <p class="text-sm font-medium text-gray-900"><%= entry.title %></p>
                  <% if entry.body.present? %>
                    <p class="text-sm text-gray-500 mt-0.5 line-clamp-2"><%= entry.body %></p>
                  <% end %>
                  <% if entry.url.present? %>
                    <a href="<%= entry_click_out_path(entry) %>" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-1 text-xs text-gray-400 hover:text-gray-700 mt-1 transition-colors">
                      <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                      </svg>
                      <span class="truncate max-w-xs"><%= entry.url.gsub(%r{\Ahttps?://}, '') %></span>
                    </a>
                  <% end %>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <time class="text-xs text-gray-400"><%= entry.occurred_at.strftime("%-d %b %Y") %></time>
                  <%= button_to entry_path(entry), method: :patch, params: { hidden: false },
                      class: "text-xs text-gray-500 hover:text-gray-900 bg-white border border-gray-200 px-2 py-1 rounded transition-colors" do %>
                    Restore
                  <% end %>
                  <%= button_to entry_path(entry), method: :delete,
                      data: { turbo_confirm: "Permanently delete this entry?" },
                      class: "text-gray-300 hover:text-red-500 transition-colors bg-transparent border-0 cursor-pointer p-0" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Private panel -->
  <% if @private_entries.any? %>
    <div data-tabs-target="panel" data-tabs-panel="private" class="hidden">
      <div class="border border-gray-200 rounded-xl divide-y divide-gray-100 overflow-hidden">
        <% @private_entries.each do |entry| %>
          <div class="group flex gap-4 p-4 hover:bg-gray-50 transition-colors">
            <div class="shrink-0 mt-0.5">
              <%= render "profiles/entry_icon", type: entry.entry_type %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5">
                    <%= render "profiles/entry_badge", type: entry.entry_type, source: entry.source %>
                    <span class="text-xs text-gray-400">🔒</span>
                    <% if entry.repo_name.present? %>
                      <span class="text-xs text-gray-400 truncate"><%= entry.repo_name.split("/").last %></span>
                    <% end %>
                  </div>
                  <p class="text-sm font-medium text-gray-900"><%= entry.title %></p>
                  <% if entry.body.present? %>
                    <p class="text-sm text-gray-500 mt-0.5 line-clamp-2"><%= entry.body %></p>
                  <% end %>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <time class="text-xs text-gray-400"><%= entry.occurred_at.strftime("%-d %b %Y") %></time>
                  <%= button_to entry_path(entry), method: :patch, params: { visibility: "public" },
                      class: "text-xs text-gray-500 hover:text-gray-900 bg-white border border-gray-200 px-2 py-1 rounded transition-colors" do %>
                    Make public
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
