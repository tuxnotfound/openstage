  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Connected accounts</h2>
  <div class="flex flex-col gap-2">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
        </svg>
        <div>
          <p class="text-sm font-medium text-gray-900">GitHub</p>
          <p class="text-xs text-gray-400">@<%= current_user.github_username %></p>
        </div>
      </div>
      <span class="flex items-center gap-1.5 text-xs text-green-600 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
        Connected
      </span>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <div>
          <p class="text-sm font-medium text-gray-400">X / Twitter</p>
          <p class="text-xs text-gray-300">Coming soon</p>
        </div>
      </div>
      <span class="text-xs text-gray-400">Not connected</span>
    </div>
  </div>
</div>

<!-- GitHub repos -->
<div class="bg-white border border-gray-200 rounded-xl p-5 mb-6">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">GitHub repos</h2>
    <div class="flex items-center gap-3">
      <% if @last_github_sync %>
        <span class="text-xs text-gray-400">Synced <%= time_ago_in_words(@last_github_sync) %> ago</span>
      <% end %>
      <%= button_to "Sync now", sync_github_path, method: :post,
          class: "text-xs bg-gray-900 text-white px-3 py-1.5 rounded-md hover:bg-gray-700 transition-colors" %>
    </div>
  </div>

  <% if @github_repos.empty? %>
    <p class="text-sm text-gray-400">No repos synced yet.</p>
  <% else %>
    <div class="flex flex-col divide-y divide-gray-100">
      <% @github_repos.each do |repo| %>
        <%= turbo_frame_tag dom_id(repo) do %>
          <div class="flex items-center justify-between py-2">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-gray-800 truncate"><%= repo.name %></p>
              <% if repo.description.present? %>
                <p class="text-xs text-gray-400 truncate"><%= repo.description %></p>
              <% end %>
            </div>
            <%= button_to github_repo_path(repo), method: :patch,
                params: { included: (!repo.included?).to_s },
                class: "ml-4 shrink-0 text-xs px-3 py-1 rounded-full border transition-colors #{repo.included? ? 'border-green-300 text-green-700 bg-green-50 hover:bg-green-100' : 'border-gray-200 text-gray-400 bg-white hover:border-gray-400'}" do %>
              <%= repo.included? ? "Included" : "Excluded" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Entry composer -->
<div class="bg-white border border-gray-200 rounded-xl p-6 mb-6">
  <h2 class="text-sm font-semibold text-gray-700 mb-4">Post an update</h2>

  <%= form_with url: entries_path, method: :post, scope: :entry do |f| %>
    <div class="flex flex-wrap gap-2 mb-4">
      <% [
        ["milestone", "Milestone"],
        ["shipped",   "Shipped"],
        ["note",      "Note"],
        ["link",      "Link"],
        ["released",  "Released"],
      ].each do |value, label| %>
        <label class="cursor-pointer">
          <%= f.radio_button :entry_type, value, id: "entry_type_#{value}", class: "peer sr-only", checked: value == "milestone" %>
          <span class="peer-checked:bg-gray-900 peer-checked:text-white inline-block px-3 py-1.5 rounded-full text-xs font-medium border border-gray-200 text-gray-600 hover:border-gray-400 transition-colors">
            <%= label %>
          </span>
        </label>
      <% end %>
    </div>

    <%= f.text_field :title,
        placeholder: "What did you do?",
        class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent mb-3" %>

    <%= f.text_area :body,
        placeholder: "More detail (optional)",
        rows: 3,
        class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent mb-3 resize-none" %>

    <div class="flex flex-col sm:flex-row gap-3 mb-4">
      <%= f.url_field :url,
          placeholder: "Link (optional)",
          class: "flex-1 border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
      <%= f.datetime_local_field :occurred_at,
          value: Time.current.strftime("%Y-%m-%dT%H:%M"),
          class: "border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
    </div>

    <%= f.submit "Post entry",
        class: "bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors cursor-pointer" %>
  <% end %>
</div>

