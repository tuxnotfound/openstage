<%# Onboarding step 3, gone once a badge has rendered anywhere. %>
<section class="os-panel" data-badge-nudge data-controller="clipboard" aria-labelledby="readme-badge">
  <h2 id="readme-badge" class="os-h3">Put your page in a README</h2>
  <p class="os-xs os-muted mt-1 mb-2.5">A live badge with your streak and commit count, linking here.</p>
  <code data-clipboard-target="source" class="os-code block truncate"><%= @badge_markdown %></code>
  <button type="button" data-action="clipboard#copy" data-clipboard-target="button" class="os-btn2 sm mt-2.5">Copy badge</button>
</section>
