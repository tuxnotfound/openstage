<%# One entry: what it is, with its mark; its title, a link when it has one;
    its project; its day; its switch, On your stage; and its menu. Off, an
    entry is in Hidden or stays private; on puts it back on the stage. A row
    its project keeps off the stage has no switch: it names what is off
    there, and leads to the switch for it in Projects. Its frame is where
    Edit opens the form. Its buttons answer with Turbo Streams; they target
    _top, so a stray HTML answer reloads the page instead of leaving "Content
    missing" in the frame. alert: why the last click was refused. %>
<% repo = dashboard_projects.find(entry.repo_name)&.repo %>
<% lock = entry_lock(entry, repo) %>
<% on = lock.nil? && %w[news commits].include?(list) %>
<% color = dashboard_projects.color_class(repo) || ProgressChart::Palette::INK_CLASS %>
<% badge = entry_badge(entry) %>
<%= turbo_frame_tag entry_row_id(entry, list) do %>
  <div id="entry-<%= entry.id %>" class="dt-row dt-egrid<%= " off" unless on %>">
    <span class="dt-kind <%= color %>">
      <% if badge %>
        <i aria-hidden="true"><%= mark_icon(badge, css: "") %></i><span><%= ProgressHelper::BADGE_WORDS.fetch(badge) %></span>
      <% else %>
        <span class="os-tag" title="<%= "On #{entry.branch}, not yet on the default branch" if entry.branch.present? %>"><%= entry_kind(entry) %></span>
      <% end %>
    </span>
    <p class="dt-title">
      <% if entry.url.present? %>
        <a href="<%= entry_click_out_path(entry) %>" target="_blank" rel="noopener" class="t" title="<%= entry.url %>"><%= entry.title %><span class="dt-out" aria-hidden="true"> ↗</span></a>
      <% else %>
        <span class="t"><%= entry.title %></span>
      <% end %>
      <% if entry.pinned? && on %><span class="os-tag">Pinned</span><% end %>
    </p>
    <span class="dt-proj <%= color %>"><% if entry.repo_name %><span class="os-dot" aria-hidden="true"></span><%= entry.repo_name.split("/").last %><% end %></span>
    <span class="dt-date"><%= entry_day(entry) %></span>
    <div class="dt-cell">
      <% if lock %>
        <%= link_to lock[:words], lock[:path], class: "dt-lock", title: lock[:title], data: { turbo_frame: "_top" } %>
      <% else %>
        <%= button_to entry_path(entry), method: :patch, params: entry_action_params(list, **entry_switch_params(list)), form: { data: { turbo_frame: "_top" } },
              role: "switch", aria: { checked: on, label: "Show #{entry.title} on your stage" }, class: "os-switch" do %><% end %>
      <% end %>
    </div>
    <%= render "dashboard/entry_menu", entry: entry, list: list, on: on %>
    <% if local_assigns[:alert] %><p role="alert" class="os-xs col-span-full font-semibold text-down"><%= alert %></p><% end %>
  </div>
<% end %>
