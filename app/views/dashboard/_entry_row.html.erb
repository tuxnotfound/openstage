<%# One timeline row. Extracted so the html and turbo_stream renders cannot
    drift apart, which is exactly how the settings repo row broke. Its frame
    is where Edit opens the form. Its buttons answer with Turbo Streams; they
    target _top, so a stray HTML answer reloads the page instead of leaving
    "Content missing" in the frame. alert: why the last click was refused. %>
<% icon = "cursor-pointer text-ink-3 hover:text-ink" %>
<% form = { data: { turbo_frame: "_top" } } %>
<%= turbo_frame_tag entry_row_id(entry, tab) do %>
  <div id="entry-<%= entry.id %>" class="os-row flex flex-wrap items-baseline gap-x-3.5 gap-y-1">
    <span class="os-tag max-w-48 flex-none truncate" title="<%= "On #{entry.branch}, not yet on the default branch" if entry.branch.present? %>"><%= entry_kind(entry) %></span>
    <div class="min-w-0 flex-[1_1_300px]">
      <p class="font-semibold"><%= entry.title %><% if entry.private_entry? %> <span class="os-xs os-muted" title="Private">· private</span><% end %></p>
      <% if entry.body.present? %>
        <p class="os-sm os-ink2 mt-0.5 line-clamp-2"><%= entry.body %></p>
      <% end %>
      <% if entry.url.present? %>
        <a href="<%= entry_click_out_path(entry) %>" target="_blank" rel="noopener" class="os-xs os-muted mt-0.5 block max-w-xs truncate underline hover:text-ink"><%= entry.url.gsub(%r{\Ahttps?://}, "") %></a>
      <% end %>
    </div>
    <span class="os-xs os-muted"><%= [ entry.repo_name&.split("/")&.last, entry.occurred_at.strftime("%b %-d") ].compact.join(" · ") %></span>

    <div class="flex items-center gap-2.5 self-center">
      <a href="<%= share_on_x_url(entry, current_user) %>" target="_blank" rel="noopener" title="Share on X" aria-label="Share on X" class="<%= icon %>">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <% if current_user.pro? %>
        <%= button_to entry_path(entry), method: :patch, params: entry_action_params(tab, pinned: (!entry.pinned?).to_s), form: form,
              title: entry.pinned? ? "Unpin" : "Pin to profile", aria: { label: entry.pinned? ? "Unpin" : "Pin to profile" },
              class: entry.pinned? ? "cursor-pointer text-accent-ink" : icon do %>
          <svg class="size-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M11.05 2.93c.3-.92 1.6-.92 1.9 0l1.52 4.67a1 1 0 00.95.69h4.92c.97 0 1.37 1.24.59 1.81l-3.98 2.89a1 1 0 00-.36 1.12l1.52 4.67c.3.92-.76 1.69-1.54 1.12l-3.98-2.89a1 1 0 00-1.18 0l-3.98 2.89c-.78.57-1.84-.2-1.54-1.12l1.52-4.67a1 1 0 00-.36-1.12L3.04 10.1c-.78-.57-.38-1.81.59-1.81h4.91a1 1 0 00.95-.69l1.52-4.67z"/></svg>
        <% end %>
        <%= button_to entry_path(entry), method: :patch, params: entry_action_params(tab, visibility: entry.private_entry? ? "public" : "private"), form: form,
              title: entry.private_entry? ? "Make public" : "Make private", aria: { label: entry.private_entry? ? "Make public" : "Make private" },
              class: entry.private_entry? ? "cursor-pointer text-accent-ink" : icon do %>
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <% end %>
      <% end %>
      <%= button_to entry_path(entry), method: :patch, params: entry_action_params(tab, hidden: true), form: form,
            title: "Hide from timeline", aria: { label: "Hide from timeline" }, class: icon do %>
        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.1A9.8 9.8 0 0 1 12 5c4.8 0 8.8 3.2 10 7a10.6 10.6 0 0 1-3 4.4M6.6 6.6A10.5 10.5 0 0 0 2 12c1.2 3.8 5.2 7 10 7 1.6 0 3.1-.3 4.4-.9"/></svg>
      <% end %>
      <% if entry.manual? %>
        <%= link_to "Edit", edit_entry_path(entry), class: "os-xs font-bold underline hover:text-accent-ink", data: { turbo_frame: entry_row_id(entry, tab) } %>
        <%= button_to entry_path(entry), method: :delete, params: entry_action_params(tab), form: form, data: { turbo_confirm: "Permanently delete this entry?" },
              title: "Delete", aria: { label: "Delete" }, class: "cursor-pointer text-ink-3 hover:text-down" do %>
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12M9 7V5h6v2m-8 0 1 12h8l1-12"/></svg>
        <% end %>
      <% end %>
    </div>
    <% if local_assigns[:alert] %><p role="alert" class="os-xs w-full font-semibold text-down"><%= alert %></p><% end %>
  </div>
<% end %>
