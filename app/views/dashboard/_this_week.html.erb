<%# The one thing to do this week. A week with something to say points at the
    picker; a quiet week points at the composer right below instead of nagging. %>
<section class="os-panel" <%= "data-recap-prompt" if @recap_prompt %>>
  <div class="os-between">
    <h2 class="os-h2">This week</h2>
    <span class="os-xs os-muted">Last 7 days</span>
  </div>

  <% if @recap_prompt %>
    <% by_repo = @recap_prompt.candidates_by_repo.transform_values(&:size).sort_by { |repo, n| [ -n, repo.to_s ] } %>
    <% commits = by_repo.sum(&:last) %>
    <% updates = @recap_prompt.highlights.size %>
    <p class="os-p mt-2 text-lg text-ink">
      <% if commits.positive? %>
        You shipped <b><%= pluralize(commits, "commit") %></b> <%= by_repo.size == 1 ? "in #{by_repo.first.first}" : "across #{by_repo.size} repos" %>.
      <% end %>
      <%= updates.positive? ? "You logged #{pluralize(updates, 'update')}." : "You logged no updates yet." %>
    </p>
    <% if commits.positive? %>
      <% projects = section&.tally&.projects&.all || [] %>
      <div class="os-sharebar mt-3.5" role="img" aria-label="Commits this week by repo">
        <% by_repo.each do |repo, n| %>
          <div class="<%= project_class(projects.find { |project| project.name == repo }&.rank) %> min-w-1.5 bg-(--project)" style="flex: <%= n %> 1 0" title="<%= repo %>: <%= pluralize(n, 'commit') %>"></div>
        <% end %>
      </div>
      <div class="mt-2 flex flex-wrap gap-x-[18px] gap-y-1 text-[13px] text-ink-2">
        <% by_repo.each do |repo, n| %><span><b class="text-ink"><%= n %></b> <%= repo %></span><% end %>
      </div>
    <% end %>
    <div class="os-between mt-[18px]">
      <p class="os-sm os-ink2">Turn it into a post. You pick the lines and write the words; nothing is posted for you.</p>
      <%= link_to "Pick what to share", recap_path, class: "os-btn sm" %>
    </div>
  <% else %>
    <p class="os-p mt-2 text-lg font-semibold text-ink">Quiet week so far.</p>
    <p class="os-sm os-ink2 mt-1">A milestone or a note, added below, tells visitors what the commits don't.</p>
  <% end %>

  <% if @streak > 0 %>
    <p class="os-xs os-muted mt-3">
      <%= @streak %>-day streak<% unless @logged_today %> · <span class="font-semibold text-warn">log something today to keep it</span><% end %>
    </p>
  <% end %>
</section>
