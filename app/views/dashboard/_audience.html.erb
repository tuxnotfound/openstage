<%# Who is paying attention: page views, and the subscriber list, which is the
    audience mechanic. Free sees how many; Pro sees who. The full breakdown
    lives on /analytics, not here. %>
<% is_pro = current_user.pro? %>
<% sparkline = is_pro ? @analytics[:sparkline_30d] : @analytics[:sparkline_7d] %>
<% peak = [ sparkline.values.max.to_f, 1.0 ].max %>
<section class="os-panel" aria-labelledby="audience">
  <div class="os-between">
    <h2 id="audience" class="os-h3">Audience</h2>
    <% if is_pro %><%= link_to "Full analytics →", analytics_path, class: "os-link text-[13px]" %><% end %>
  </div>

  <div class="mt-3 flex h-7 items-end gap-[3px]" aria-hidden="true">
    <% sparkline.each_value do |count| %>
      <span class="flex-1 rounded-[2px] <%= count.positive? ? 'bg-accent' : 'bg-line' %>" style="height: <%= [ (100.0 * count / peak).round, 8 ].max %>%"></span>
    <% end %>
  </div>
  <p class="os-xs os-muted mt-2">
    <span class="os-num font-bold text-ink"><%= @analytics[:unique_7d] %></span> unique visitors this week · <%= @analytics[:total_views] %> views all time
  </p>

  <div class="mt-3.5 border-t border-line pt-3" data-subscribers data-count="<%= @subscribers_count %>">
    <div class="os-between">
      <p class="os-sm font-bold"><%= pluralize(@subscribers_count, "subscriber") %></p>
      <% unless is_pro %><%= link_to "See who, with Pro", pricing_path, class: "os-link text-[13px]" %><% end %>
    </div>
    <p class="os-xs os-muted mt-0.5">People who confirmed they want your updates, from the box on your page or one project's. They get that week by email on Fridays, when it has three or more things in it.</p>
    <% if @subscribers&.any? %>
      <ul class="mt-2">
        <% @subscribers.each do |sub| %>
          <li class="os-row os-xs flex items-center justify-between gap-2 py-1.5">
            <span class="truncate font-mono"><%= sub.email %></span>
            <span class="os-muted shrink-0"><%= sub.github_repo ? "#{sub.github_repo.name} · " : "" %><%= sub.confirmed_at.strftime("%b %-d") %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
