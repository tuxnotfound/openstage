<%# "Load more" appends onto the existing list rather than re-rendering the
    whole dashboard, so your scroll position survives. %>
<%= turbo_stream.append "dashboard-entries" do %>
  <% @entries.each do |entry| %>
    <%= render "dashboard/entry_row", entry: entry %>
  <% end %>
<% end %>

<% if @entries.next_page %>
  <%= turbo_stream.replace "dashboard-load-more" do %>
    <div id="dashboard-load-more" class="mt-4 text-center">
      <%= link_to "Load more",
          dashboard_path(page: @entries.next_page, q: @query.presence, type: @type_filter),
          class: "text-sm text-gray-500 hover:text-gray-900 border border-gray-200 rounded-lg px-5 py-2.5 inline-block transition-colors",
          data: { turbo_stream: true } %>
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.remove "dashboard-load-more" %>
<% end %>
