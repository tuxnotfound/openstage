<%# "Load more" appends onto its tab's list rather than re-rendering the
    whole dashboard, so your scroll position survives. %>
<% tab = @entries_page %>
<%= turbo_stream.append "entries-list-#{tab.key}" do %>
  <%= render partial: DashboardHelper::ENTRY_ROWS[tab.key], collection: tab.entries, as: :entry, locals: { tab: tab.key } %>
<% end %>

<% if tab.more? %>
  <%= turbo_stream.replace "entries-more-#{tab.key}", partial: "dashboard/load_more", locals: { tab: tab } %>
<% else %>
  <%= turbo_stream.remove "entries-more-#{tab.key}" %>
<% end %>
