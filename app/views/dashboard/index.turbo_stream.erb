<%# "Load more" appends onto its list rather than re-rendering the whole
    dashboard, so your scroll position survives. %>
<% tab = @entries_page %>
<%= turbo_stream.append "entries-list-#{tab.key}" do %>
  <%= render partial: "dashboard/entry_row", collection: tab.entries, as: :entry, locals: { list: tab.key } %>
<% end %>

<% if tab.more? %>
  <%= turbo_stream.replace "entries-more-#{tab.key}", partial: "dashboard/load_more", locals: { tab: tab } %>
<% else %>
  <%= turbo_stream.remove "entries-more-#{tab.key}" %>
<% end %>
