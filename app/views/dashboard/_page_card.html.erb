<%# The product is the page, so the dashboard keeps it one glance away: the
    link to share, and whether it is up to date. %>
<% last_log = @sync_logs.first %>
<section class="os-panel" data-page-card aria-labelledby="your-page">
  <h2 id="your-page" class="os-h3">Your page</h2>
  <%= link_to "openstage.dev/#{current_user.username}", profile_path(current_user.username), class: "os-field mt-2.5 flex items-center truncate text-sm hover:border-ink-3" %>
  <div class="mt-2.5 flex gap-2" data-controller="clipboard">
    <span data-clipboard-target="source" class="hidden"><%= profile_url(current_user.username) %></span>
    <button type="button" data-action="clipboard#copy" data-clipboard-target="button" class="os-btn sm">Copy link</button>
    <%= link_to "View page", profile_path(current_user.username), class: "os-btn2 sm" %>
  </div>

  <div class="os-between mt-3.5">
    <span class="os-xs os-muted"><%= @last_github_sync ? "Synced #{time_ago_in_words(@last_github_sync)} ago" : "Not synced yet" %></span>
    <% if last_log&.token_rejected? %>
      <%# A sign-in stores a new token; the old one cannot sync. %>
      <%= button_to "Reconnect GitHub", "/auth/github", method: :post, data: { turbo: false }, class: "os-btn sm" %>
    <% else %>
      <%= button_to "Sync now", sync_github_path, method: :post, class: "os-btn2 sm" %>
    <% end %>
  </div>

  <% if last_log&.error_message.present? %>
    <p class="os-xs mt-2 line-clamp-2 font-semibold <%= last_log.failed? ? 'text-down' : 'text-warn' %>" title="<%= last_log.error_message %>"><%= last_log.error_message %></p>
  <% end %>

  <% if @sync_logs.any? %>
    <details class="mt-2">
      <summary class="os-xs os-muted cursor-pointer list-none hover:text-ink [&::-webkit-details-marker]:hidden">Sync history</summary>
      <ul class="mt-2 space-y-1.5">
        <% @sync_logs.each do |log| %>
          <li class="os-xs flex items-center justify-between gap-2">
            <span class="flex min-w-0 items-center gap-2">
              <span class="size-1.5 shrink-0 rounded-full <%= log.success? ? 'bg-up' : log.failed? ? 'bg-down' : 'bg-warn' %>"></span>
              <span class="capitalize"><%= log.source %></span>
              <% if log.success? && log.entries_added > 0 %><span class="os-muted">+<%= log.entries_added %></span><% end %>
            </span>
            <time class="os-muted shrink-0"><%= time_ago_in_words(log.ran_at) %> ago</time>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
</section>
