<%# The lists, each with how many of its entries the search and repo match.
    Links, so a list opens without JavaScript; with it, the tabs controller
    switches in place and keeps the list in the address. %>
<div id="entries-tabs" class="os-pills" role="tablist" aria-label="Which entries">
  <% tabs.select { |tab| entry_tab_shown?(tab) }.each do |tab| %>
    <%= link_to "#{DashboardHelper::ENTRY_TABS[tab.key]} #{number_with_delimiter(tab.count)}",
          dashboard_path(**entries_filter.to_params, tab: "entries", list: tab.key), role: "tab", aria: { selected: tab.key == active },
          data: { tabs_target: "tab", tabs_tab: tab.key, action: "tabs#show" }, class: "os-pill" %>
  <% end %>
</div>
