<%# The section's tabs, each with how many entries its list holds. Links, so
    a tab opens without JavaScript; with it, the tabs controller switches in
    place and keeps the URL on the tab. %>
<div id="entries-tabs" class="os-pills" role="tablist" aria-label="Entries">
  <% tabs.select { |tab| entry_tab_shown?(tab) }.each do |tab| %>
    <%= link_to "#{DashboardHelper::ENTRY_TABS[tab.key]} (#{tab.total})", dashboard_path(**entries_filter.to_params, tab: tab.key, anchor: "entries"),
          role: "tab", aria: { selected: tab.key == active },
          data: { tabs_target: "tab", tabs_tab: tab.key, active: tab.key == active, action: "tabs#show" },
          class: "os-pill data-[active=true]:bg-accent data-[active=true]:text-on-accent" %>
  <% end %>
</div>
