<%# One list, ten rows at a time, newest first, in a frame of its own, which
    a click on a row redraws, or just the row (entries/changed); a page that
    starts past the newest rows leads back to them. What's new says first how
    many entries have no project. target _top: a link in it leaves the frame. %>
<%= turbo_frame_tag "entries-#{tab.key}", target: "_top" do %>
  <%= render "dashboard/entry_list_count", tab: tab %>
  <% if tab.key == "news" && @untagged && !entries_filter.any? %>
    <%= render "dashboard/untagged", **@untagged, back: { tab: "entries" } %>
  <% end %>
  <% if tab.past_newest? %>
    <p class="dt-note"><%= link_to "Back to the newest", dashboard_path(**entries_filter.to_params, tab: "entries", list: tab.key),
                                    data: { turbo_frame: "entries-lists", turbo_action: "advance" }, class: "os-link text-sm" %></p>
  <% end %>
  <div class="dt-head dt-egrid" aria-hidden="true"><span>Entry</span><span></span><span>Project</span><span>Day</span><span class="sw">On your stage</span><span></span></div>
  <% if tab.entries.empty? %>
    <p class="dt-empty"><%= entries_filter.any? ? "No entries match that." : (tab.key == "news" ? "Nothing here yet. Add a milestone above." : "Nothing here now.") %></p>
  <% else %>
    <div id="entries-list-<%= tab.key %>">
      <%= render partial: "dashboard/entry_row", collection: tab.entries, as: :entry, locals: { list: tab.key } %>
    </div>
    <%= render "dashboard/load_more", tab: tab if tab.more? %>
  <% end %>
<% end %>
