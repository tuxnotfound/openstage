<%# Whether the projects are up to date, and the way to fix it if not, at the
    end of the tabs' line. Its history is at the foot of Projects. %>
<div class="dt-sync" data-sync-status>
  <span class="os-xs os-muted"><%= @last_github_sync ? "Synced from GitHub #{time_ago_in_words(@last_github_sync)} ago" : "Not synced from GitHub yet" %></span>
  <% if @sync_logs.first&.token_rejected? %>
    <%# A sign-in stores a new token; the old one cannot sync. %>
    <%= button_to "Reconnect GitHub", "/auth/github", method: :post, data: { turbo: false }, class: "os-btn dt-small" %>
  <% else %>
    <%= button_to "Sync now", sync_github_path, method: :post, class: "os-btn2 dt-small" %>
  <% end %>
</div>
