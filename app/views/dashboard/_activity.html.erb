<%# The builder's own chart: every number they have, the picked ones stacked
    on the same points, over the table of their projects that picks what it
    draws, and whether GitHub's sync is up to date. The window, the numbers
    and the projects switch in the page's script. %>
<% kept = request.query_parameters.except("page", "range") %>
<section class="os-panel" aria-labelledby="your-activity">
  <%= react_island("progress", { initial: ProgressViewSerializer.new(section, numbers: numbers, table: table).as_json,
                                 endpoint: api_progress_path(current_user.username, dashboard: 1),
                                 mode: "dashboard", defaultRange: DashboardController::ACTIVITY_RANGE }, id: "activity-chart") do %>
    <div class="os-between">
      <h2 id="your-activity" class="os-h2">Your activity</h2>
      <nav class="os-pills" aria-label="Time range">
        <% ProgressHelper::RANGES.each do |range, label| %>
          <%= link_to label, dashboard_path(kept.merge("range" => (range unless range == DashboardController::ACTIVITY_RANGE)).compact),
                class: "os-pill max-sm:px-2", aria: { current: (section.labels.range == range ? "page" : nil) } %>
        <% end %>
      </nav>
    </div>
    <%= render "profiles/page/numbers", numbers: numbers.numbers, class: "mt-4",
               path_for: ->(show) { dashboard_path(kept.merge("show" => show).compact) } %>
    <div class="mt-5"><%= render "profiles/page/stack", section: section, numbers: numbers.numbers %></div>
    <%= render "dashboard/projects_table", table: table.attributes, section: section, kept: kept if table %>
  <% end %>
  <div class="mt-4 border-t border-line pt-3"><%= render "dashboard/sync" %></div>
</section>
