<%# The builder's own chart, as their visitors see it, over the table of
    their projects where they pick what visitors see, and whether GitHub's
    sync is up to date. The numbers, the window and the boxes switch in the
    page's script. chart: the dashboard's Progress::ChartService. %>
<% serializer = ProgressViewSerializer.new(chart) %>
<% view = serializer.attributes %>
<% kept = request.query_parameters.except("page", *ProgressHelper::PROGRESS_PARAMS.map(&:to_s)) %>
<% path_for = ->(changes) { dashboard_path(kept.merge(chart_params(view, default_range: Progress::Window::DEFAULT, **changes)).compact) } %>
<section class="os-panel" aria-labelledby="your-activity">
  <%= react_island("progress", { initial: serializer.as_json, endpoint: api_progress_path(current_user.username, dashboard: 1),
                                 mode: "dashboard", defaultRange: Progress::Window::DEFAULT }, id: "activity-chart") do %>
    <%= render "charts/filter", view: view, mode: "dashboard", path_for: path_for,
               back: chart_params(view, default_range: Progress::Window::DEFAULT).compact %>
  <% end %>
  <%# Outside the island, which never redraws it. %>
  <p class="os-note mt-2.5">The switches set what visitors see on your stage and your project pages, and this chart follows them; the boxes and the numbers above the chart change this chart only.</p>
  <%= render "dashboard/untagged", **@untagged, back: chart_params(view, default_range: Progress::Window::DEFAULT).compact %>
  <div class="mt-4 border-t border-line pt-3"><%= render "dashboard/sync" %></div>
</section>
