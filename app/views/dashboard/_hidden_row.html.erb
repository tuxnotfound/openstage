<%# One row the builder hid: off every list, still counted. Restore puts it
    back; delete is for good. Buttons as on the timeline's rows. %>
<% form = { data: { turbo_frame: "_top" } } %>
<div id="<%= entry_row_id(entry, tab) %>" class="os-row flex flex-wrap items-baseline gap-x-3.5 gap-y-1">
  <span class="os-tag flex-none"><%= entry_kind(entry) %></span>
  <span class="min-w-0 flex-[1_1_300px] font-semibold"><%= entry.title %></span>
  <span class="os-xs os-muted"><%= [ entry.repo_name&.split("/")&.last, entry.occurred_at.strftime("%b %-d, %Y") ].compact.join(" · ") %></span>
  <%= button_to "Restore", entry_path(entry), method: :patch, params: entry_action_params(tab, hidden: false), form: form, class: "os-btn2 sm h-8" %>
  <%= button_to entry_path(entry), method: :delete, params: entry_action_params(tab), form: form, data: { turbo_confirm: "Permanently delete this entry?" },
        aria: { label: "Delete" }, title: "Delete", class: "cursor-pointer text-ink-3 hover:text-down" do %>
    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12M9 7V5h6v2m-8 0 1 12h8l1-12"/></svg>
  <% end %>
  <% if local_assigns[:alert] %><p role="alert" class="os-xs w-full font-semibold text-down"><%= alert %></p><% end %>
</div>
