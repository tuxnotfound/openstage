<%# Your projects, under Your activity's chart: each with Edit, whether the
    builder's page shows it, and a cell per number with the window's value
    and the switch that draws it, the number's line in its column's head. A
    project hidden from the page comes last, with no line to draw. The
    chart's script redraws in place; without it, each switch is a form. On a
    phone each row stacks, each switch under its label.
    lines: the DashboardLinesSerializer's attributes. %>
<% range = (section.labels.range unless section.labels.range == DashboardController::ACTIVITY_RANGE) %>
<div class="mt-5" id="activity-lines">
  <% if lines[:rows].empty? %>
    <p class="os-sm os-ink2">No repo has commits here yet. Your public repos appear once the first sync is done.</p>
  <% else %>
    <table class="w-full table-fixed border-collapse text-sm max-sm:block">
      <caption class="sr-only">Your projects: what your page and this chart show of each</caption>
      <thead class="max-sm:hidden">
        <tr class="text-xs text-ink-3">
          <th scope="col" class="py-2 text-left font-bold">Your projects</th>
          <th scope="col" class="w-24 py-2 text-right font-bold">Your page</th>
          <% SiteVisitsHelper::CHART_NUMBERS.each do |number, label| %>
            <th scope="col" class="w-34 py-2 text-right font-bold">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-3.5 border-t-[3px] border-current <%= 'border-dotted' if number == 'visits' %>" aria-hidden="true"></span><%= label %>
              </span>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="max-sm:block">
        <% lines[:rows].each do |row| %>
          <% off = row[:page] && !row[:page][:on] %>
          <tr class="border-t border-line max-sm:grid max-sm:grid-cols-3 max-sm:gap-x-3 max-sm:gap-y-2.5 max-sm:py-3" data-line-row="<%= row[:repo] %>">
            <th scope="row" class="py-2.5 text-left font-bold max-sm:col-span-3 max-sm:py-0">
              <span class="flex min-w-0 items-center gap-2.5">
                <span class="os-dot <%= project_class(row[:rank]) %> bg-(--project) shrink-0 <%= 'opacity-40' if off %>"></span>
                <span class="truncate <%= 'text-ink-3' if off %>"><%= row[:name] %></span>
                <%= link_to "Edit", row[:edit], class: "os-btn2 sm shrink-0", aria: { label: "Edit #{row[:name]}" } if row[:edit] %>
              </span>
            </th>
            <td class="py-2.5 text-right max-sm:py-0 max-sm:text-left">
              <span class="os-xs os-muted mb-1 block sm:hidden">Your page</span>
              <% if row[:page] %>
                <%= form_with url: row[:page][:path], method: :patch, class: "inline-flex", data: { turbo: false } do %>
                  <%= hidden_field_tag :included, (!row[:page][:on]).to_s, id: nil %>
                  <%= hidden_field_tag :range, range, id: nil if range %>
                  <button type="submit" role="switch" aria-checked="<%= row[:page][:on] %>" aria-label="Show <%= row[:name] %> on your page" class="os-switch"></button>
                <% end %>
              <% end %>
            </td>
            <% SiteVisitsHelper::CHART_NUMBERS.each do |number, label| %>
              <% cell = row[number.to_sym] %>
              <td class="py-2.5 text-right max-sm:py-0 max-sm:text-left">
                <span class="os-xs os-muted mb-1 block sm:hidden"><%= label %></span>
                <% if cell[:setup] %>
                  <%= link_to "Set up", cell[:setup], aria: { label: "Set up #{row[:name]}'s site visits" },
                        class: "inline-flex h-[22px] items-center rounded-full border border-line px-2.5 text-[11px] font-bold text-ink-2 hover:border-accent hover:text-accent-ink" %>
                <% elsif cell[:value].nil? %>
                  <span class="os-xs os-muted">–</span>
                <% elsif row[:switch].nil? %>
                  <span class="os-num tabular-nums"><%= cell[:value] %></span>
                <% else %>
                  <span class="inline-flex items-center gap-2.5">
                    <span class="os-num tabular-nums <%= cell[:on] ? 'text-ink' : 'text-ink-3' %>"><%= cell[:value] %></span>
                    <%= button_to "", row[:switch], method: :patch, params: { number: number, on: (!cell[:on]).to_s },
                          role: "switch", aria: { checked: cell[:on], label: "Draw #{row[:name]}'s #{label.downcase}" }, class: "os-switch",
                          form: { data: { turbo: false } } %>
                  </span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="os-note mt-2">Values are the <%= section.labels.words %>. Your page switches what visitors see; the others, this chart only.</p>
  <% end %>
</div>
