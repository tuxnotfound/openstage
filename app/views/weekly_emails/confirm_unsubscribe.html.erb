<% content_for :dark_mode, true %>
<% content_for :main_class, "os-wrap pt-7.5" %>

<section class="os-panel mx-auto max-w-[560px] p-9 text-center">
  <h1 class="os-h2 text-[30px]">Stop the weekly email?</h1>
  <p class="os-p mt-2.5">No more Friday email with your week. Settings turns it back on.</p>
  <%= button_to "Stop the weekly email", weekly_email_unsubscribe_path, method: :post, params: { token: @token },
      form: { class: "mt-5" }, class: "os-btn" %>
</section>
