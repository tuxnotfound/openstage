<% section = @section %>
<% labels = section.labels %>
<% journey = @layout.is_a?(CardLayout::Journey) %>
<% items = journey ? @layout.items : @layout.fit.notes.map(&:item) %>
<% left_out = @layout.left_out %>
<% swapped = section.pick.swapped_ids %>
<% here = { range: params[:range].presence, offset: params[:offset].presence, repo: Array(params[:repo]).compact_blank.presence, chart: params[:chart].presence } %>
<% theme = @layout.theme %>
<%= turbo_frame_tag "progress_card" do %>
  <%# Outside the SVG: the download embeds its own copies of these files. %>
  <style>
    <% card_fonts(@layout.class.fonts).each do |font| %>
      @font-face { font-family: '<%= font[:family] %>'; font-style: <%= font[:style] %>; font-weight: <%= font[:weight] %>; font-display: swap; src: url('<%= font[:url] %>') format('woff2'); }
    <% end %>
  </style>
  <div data-controller="card-export clipboard"
       data-card-export-fonts-value="<%= { (journey ? "journey" : "footnotes") => card_fonts(@layout.class.fonts) }.to_json %>"
       data-card-export-filename-value="openstage-<%= labels.file_name %>.png"
       data-card-export-track-url-value="<%= recap_track_path %>" data-card-export-event-value="progress_card_downloaded"
       data-card-export-detail-value="<%= journey ? 'journey' : 'footnotes' %>"
       data-clipboard-track-url-value="<%= recap_track_path %>" data-clipboard-event-value="progress_post_copied"
       data-clipboard-detail-value="<%= journey ? 'journey' : 'footnotes' %>">
    <p class="text-sm text-gray-500"><%= [ (section.selection_name if section.filtered?), labels.title, labels.subtitle ].compact.join(" · ") %></p>

    <div id="card_preview" class="mt-4 rounded-[10px] overflow-hidden ring-1 ring-gray-200 [&_svg]:block [&_svg]:w-full [&_svg]:h-auto">
      <%= render(journey ? "progress_cards/journey" : "progress_cards/footnotes", layout: @layout) %>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <nav aria-label="Card theme" class="inline-flex gap-0.5 p-[3px] bg-gray-100 rounded-[10px]">
        <% { "light" => "Light", "dark" => "Dark" }.each do |key, label| %>
          <%= link_to label, progress_card_path(**here, theme: key, swap: swapped.join(",").presence),
                aria: { current: (theme == key ? "true" : nil) },
                class: "rounded-lg px-3.5 py-1.5 text-[13px] font-medium #{theme == key ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-900'}" %>
        <% end %>
      </nav>
      <div class="flex gap-2">
        <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
                class="min-h-10 px-3.5 text-sm font-medium rounded-lg border border-gray-200 bg-white text-gray-900 cursor-pointer hover:border-gray-400">Copy post</button>
        <button type="button" data-action="card-export#download" data-card-export-target="button"
                class="min-h-10 px-3.5 text-sm font-medium rounded-lg bg-gray-900 text-white cursor-pointer hover:bg-gray-700">Download PNG</button>
      </div>
    </div>

    <% if section.filtered? && section.tally.untagged.any? %>
      <p class="mt-3 text-xs text-gray-500">
        <%= pluralize(section.tally.untagged.size, "entry") %> <%= labels.word %> <%= section.tally.untagged.size == 1 ? "has" : "have" %>
        no project and <%= section.tally.untagged.size == 1 ? "is" : "are" %> not on this card.
        <%= link_to "Tag them", profile_path(current_user.username, **here.except(:repo).compact, tag: "1"), data: { turbo_frame: "_top" }, class: "text-gray-900 underline" %>
      </p>
    <% end %>

    <div class="mt-4">
      <p class="mb-1.5 text-xs font-semibold text-gray-500">Post to go with it</p>
      <div data-clipboard-target="source" class="whitespace-pre-line text-sm/normal text-gray-900 bg-gray-50 border border-gray-200 rounded-[10px] px-3.5 py-3"><%= progress_card_draft(section, items) %></div>
    </div>

    <% if left_out.any? %>
      <div class="mt-4">
        <p class="mb-1 text-xs font-semibold text-gray-500">Not on the card</p>
        <% if journey %>
          <p class="mb-1 text-xs text-gray-500">This card puts words only where the line has room for them, so an entry swapped in may still stay off.</p>
        <% end %>
        <ul class="list-none m-0 p-0">
          <% left_out.each do |item| %>
            <li class="flex items-center gap-2 py-1.5 border-b border-gray-100 text-[13px]">
              <svg class="size-2 shrink-0" viewBox="0 0 10 10" role="img" aria-label="<%= item.shipped? ? 'Shipped' : 'Published' %>">
                <% if item.shipped? %><circle cx="5" cy="5" r="4.5" fill="#111827"/><% else %><circle cx="5" cy="5" r="3.9" fill="#ffffff" stroke="#111827" stroke-width="1.3"/><% end %>
              </svg>
              <span class="flex-1 min-w-0 truncate text-gray-700"><%= item.title %></span>
              <span class="text-xs text-gray-400 whitespace-nowrap tabular-nums"><%= item.date.strftime("%b %-d") %></span>
              <%= link_to "Swap in", progress_card_path(**here, theme: theme, swap: (swapped + [ item.id ]).join(",")),
                    class: "shrink-0 text-xs font-medium text-gray-900 underline" %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
<% end %>
