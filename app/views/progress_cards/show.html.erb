<% section = @section %>
<% labels = section.labels %>
<% items = @layout.notes.map(&:item) %>
<% left_out = @layout.left_out %>
<% swapped = section.pick.swapped.map(&:id) %>
<% here = { range: labels.range, repo: Array(params[:repo]).compact_blank.presence } %>
<% theme = @layout.theme %>
<%= turbo_frame_tag "progress_card" do %>
  <%# Outside the SVG: the download embeds its own copies of these files. %>
  <style>
    <% card_fonts(CardLayout::Progress.fonts).each do |font| %>
      @font-face { font-family: '<%= font[:family] %>'; font-style: <%= font[:style] %>; font-weight: <%= font[:weight] %>; font-display: swap; src: url('<%= font[:url] %>') format('woff2'); }
    <% end %>
  </style>
  <div data-controller="card-export clipboard"
       data-card-export-fonts-value="<%= { "progress" => card_fonts(CardLayout::Progress.fonts) }.to_json %>"
       data-card-export-filename-value="openstage-<%= labels.file_name %>.png"
       data-card-export-track-url-value="<%= events_path %>" data-card-export-event-value="progress_card_downloaded"
       data-card-export-detail-value="lines"
       data-clipboard-track-url-value="<%= events_path %>" data-clipboard-event-value="progress_post_copied"
       data-clipboard-detail-value="lines"
       class="flex flex-wrap items-start gap-5">
    <div class="min-w-0 flex-[999_1_560px]">
      <div id="card_preview" class="overflow-hidden rounded-card ring-1 ring-line [&_svg]:block [&_svg]:h-auto [&_svg]:w-full">
        <%= render "progress_cards/card", layout: @layout %>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <nav class="os-pills" aria-label="Card theme">
          <% { "light" => "Light", "dark" => "Dark" }.each do |key, label| %>
            <%= link_to label, progress_card_path(**here.compact, theme: key, swap: swapped.join(",").presence),
                  class: "os-pill", aria: { current: (theme == key ? "true" : nil) } %>
          <% end %>
        </nav>
        <button type="button" data-action="card-export#download" data-card-export-target="button" class="os-btn sm">Download PNG</button>
        <button type="button" data-action="clipboard#copy" data-clipboard-target="button" class="os-btn2 sm">Copy post</button>
      </div>
      <% if section.filtered? && section.tally.untagged.any? %>
        <p class="os-xs os-muted mt-3">
          <%= pluralize(section.tally.untagged.size, "entry") %> <%= labels.word %> <%= section.tally.untagged.size == 1 ? "has" : "have" %>
          no project and <%= section.tally.untagged.size == 1 ? "is" : "are" %> not on this card.
          <%= link_to "Tag them", profile_path(current_user.username, **here.except(:repo).compact, tag: "1"), data: { turbo_frame: "_top" }, class: "os-link text-[13px]" %>
        </p>
      <% end %>
    </div>

    <div class="os-stack min-w-0 flex-[1_1_300px]">
      <div>
        <h3 class="os-h3">Post to go with it</h3>
        <div data-clipboard-target="source" class="os-area mt-2 min-h-[150px] whitespace-pre-line"><%= progress_card_draft(section, items) %></div>
      </div>
      <% if left_out.any? %>
        <div>
          <h3 class="os-h3">Not on the card</h3>
          <p class="os-xs os-muted mt-1 mb-1.5"><%= left_out.size %> more shipped and published <%= labels.word %>. Swap one in for a numbered one.</p>
          <% left_out.each do |item| %>
            <div class="os-row os-between py-2">
              <span class="os-sm min-w-0"><span class="font-semibold"><%= item.title %></span> <span class="os-xs os-muted"><%= item.date.strftime("%b %-d") %></span></span>
              <%= link_to "Swap in", progress_card_path(**here.compact, theme: theme, swap: (swapped + [ item.id ]).join(",")), class: "os-btn2 sm" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
