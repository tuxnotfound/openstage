<%# The Footnotes card, 1200x630. CardLayout::Footnotes measures and places
    every line, since SVG cannot flow text; this writes what it drew, in its
    order. Text stays on one line inside each <text>: a line break there would
    print as a space. %>
<% t = layout.palette %>
<% avatar = layout.avatar %>
<% num = CardLayout::Shapes.method(:num) %>
<% paths = layout.canvas.paths %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630" role="img"
     aria-label="<%= layout.section.labels.title %> progress card for <%= layout.user.display_name %>" data-week-card="footnotes">
  <defs>
    <style><%= card_face_css(CardLayout::Footnotes) %></style>
    <% if avatar %><clipPath id="footnotes-avatar"><circle cx="88" cy="80" r="28"/></clipPath><% end %>
  </defs>
  <rect width="1200" height="630" fill="<%= t[:bg] %>"/>
  <% if avatar %>
    <circle cx="88" cy="80" r="30" fill="<%= t[:ring] %>"/>
    <image href="<%= avatar[:url] %>" x="60" y="52" width="56" height="56" preserveAspectRatio="xMidYMid slice" clip-path="url(#footnotes-avatar)"/>
  <% end %>
  <% CardLayout::Footnotes::UNDER.each do |layer, paint| %>
    <% if paths[layer].present? %><%= tag.path(d: paths[layer], **card_paint(paint, t)) %><% end %>
  <% end %>
  <% layout.fills.each do |d, fill| %><%= tag.path(d: d, fill: fill) %><% end %>
  <% layout.canvas.dots.each do |dot| %>
    <circle cx="<%= num.call(dot.cx) %>" cy="<%= num.call(dot.cy) %>" r="<%= num.call(dot.r) %>" fill="<%= dot.fill %>"/>
  <% end %>
  <% CardLayout::Footnotes::OVER.each do |layer, paint| %>
    <% if paths[layer].present? %><%= tag.path(d: paths[layer], **card_paint(paint, t)) %><% end %>
  <% end %>
  <% layout.canvas.icons.each do |icon| %>
    <svg x="<%= num.call(icon.x) %>" y="<%= num.call(icon.y) %>" width="<%= icon.size %>" height="<%= icon.size %>" viewBox="<%= icon.view_box %>"><path d="<%= icon.path %>" fill="<%= icon.fill %>"/></svg>
  <% end %>
  <% layout.canvas.runs.each do |run| %>
    <%= card_run(run) %>
  <% end %>
</svg>
