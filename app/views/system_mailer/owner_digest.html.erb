<p>The last 7 days on Openstage, builders other than you.</p>

<p><strong>Signups: <%= @signups %></strong></p>
<ul>
  <% @numbers[:signups_by_ref].sort_by { |_ref, count| -count }.each do |ref, count| %>
    <li><%= ref %>: <%= count %></li>
  <% end %>
</ul>

<p>
  Activated (page has entries): <%= @numbers[:activated] %><br>
  Subscribes confirmed, any page: <%= @numbers[:subscribes] %><br>
  Opened a compose box from the recap: <%= @numbers[:recap_intents] %><br>
  Weekly email: <%= @numbers[:weekly_mailed] %> mailed, <%= @numbers[:weekly_opened] %> opened the picker from it
</p>

<p><strong>Failed jobs: <%= @numbers[:failed_jobs].zero? ? "none" : @numbers[:failed_jobs] %></strong></p>
<% if @numbers[:failed_job_classes].any? %>
  <ul>
    <% @numbers[:failed_job_classes].each do |job_class, count| %>
      <li><%= job_class %>: <%= count %></li>
    <% end %>
  </ul>
<% end %>

<p><%= link_to "Everything else on /admin", @admin_url %></p>
