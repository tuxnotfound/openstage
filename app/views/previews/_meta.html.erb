<%# What a shared preview's link shows, the same for a visitor's page and
    for the card a bot reads (previews/card): the login, not the GitHub
    name, which only a read from GitHub knows, and their GitHub picture,
    in X's small square card. login: theirs. %>
<% content_for :title, "@#{login}'s stage, built from public GitHub — Openstage" %>
<% content_for :meta_description, "Projects and a year of commits from @#{login}'s public GitHub, on Openstage. No sign-in needed to preview." %>
<% content_for :og_image, "https://avatars.githubusercontent.com/#{ERB::Util.url_encode(login)}?size=400" %>
<% content_for :twitter_card, "summary" %>
<% content_for :head do %><meta name="robots" content="noindex, nofollow"><% end %>
