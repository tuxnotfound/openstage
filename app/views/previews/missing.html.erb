<% content_for :title, "No GitHub user @#{@login} — Openstage" %>
<% content_for :head do %><meta name="robots" content="noindex, nofollow"><% end %>
<% content_for :main_class, "os-wrap pt-9" %>

<section class="os-panel mx-auto max-w-[680px] p-6 text-center sm:p-11">
  <h1 class="os-h1 text-[clamp(28px,4vw,40px)] [overflow-wrap:anywhere]">No GitHub user named @<%= @login %></h1>
  <%= render "previews/form", id: "preview-login", form_class: "mx-auto mt-5.5 justify-center" %>
</section>
