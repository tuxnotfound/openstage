<%# The preview's card alone, for a bot: its tags (previews/_meta) and a
    link to the preview, with no read from GitHub. %>
<%= render "previews/meta", login: @login %>
<% content_for :main_class, "os-wrap pt-9" %>

<section class="os-panel mx-auto max-w-[680px] p-6 text-center sm:p-11">
  <h1 class="os-h2">@<%= @login %>'s stage, built from public GitHub</h1>
  <%= link_to "Preview @#{@login}'s stage", preview_path(@login), class: "os-btn mt-5.5" %>
</section>
