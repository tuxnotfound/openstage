<%# A card per project with a colour, as the stage draws them (profiles/page/
    _projects), from GitHub alone: its name opens the repo, as a preview has
    no project pages. The rest follow by name, busiest first, as many as
    Preview::LISTED. %>
<section class="os-panel" aria-labelledby="projects">
  <h2 id="projects" class="os-h2">Projects</h2>
  <div class="os-grid2 mt-4">
    <% preview.cards.each do |card| %>
      <div class="os-card flex flex-col <%= ProgressChart::Palette.alone_class(card.rank) %>">
        <span class="inline-flex flex-wrap items-center gap-2">
          <a href="<%= card.url %>" target="_blank" rel="noopener" class="os-h3 inline-flex items-center gap-2 text-xl hover:underline">
            <span class="os-dot size-[11px] bg-(--project)"></span><%= card.name %>
          </a>
          <% if card.homepage %><span class="os-tag soft">Live</span><% end %>
          <% if card.archived? %><span class="os-tag">Archived</span><% end %>
        </span>
        <% if card.description %>
          <p class="os-p mt-1 text-[15px]"><%= card.description %></p>
        <% end %>
        <div class="mt-auto">
          <% if card.commits.positive? %>
            <% line, area = progress_sparkline(card.weeks) %>
            <svg viewBox="0 0 400 56" preserveAspectRatio="none" aria-hidden="true" class="mt-3 block h-14 w-full overflow-visible">
              <path d="<%= area %>" class="fill-(--project)" fill-opacity="0.16"/>
              <path d="<%= line %>" class="stroke-(--project)" fill="none" stroke-width="2.5" vector-effect="non-scaling-stroke"/>
            </svg>
            <p class="os-sm os-ink2 mt-2.5">
              <span class="os-num font-bold text-ink"><%= card.commits %></span> <%= card.commits == 1 ? "commit" : "commits" %> in 12 months<% if card.last_commit %> · last commit <%= progress_ago(card.last_commit) %><% end %>
            </p>
          <% end %>
          <% if (website = safe_external_url(card.homepage)) %>
            <div class="mt-1.5">
              <a href="<%= website %>" target="_blank" rel="ugc nofollow noopener" class="os-link text-sm"><%= URI(website).host %> <span aria-hidden="true">↗</span></a>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <% if preview.rest.any? %>
    <div class="mt-6">
      <h3 class="os-h3"><%= pluralize(preview.rest.size, "more project") %></h3>
      <div class="mt-2 grid gap-x-6 sm:grid-cols-2">
        <% preview.rest.first(Preview::LISTED).each do |project| %>
          <div class="os-row os-between gap-3 py-2">
            <span class="os-sm min-w-0 truncate font-semibold"><%= project.name %></span>
            <span class="os-xs os-muted shrink-0"><%= pluralize(project.commits, "commit") %></span>
          </div>
        <% end %>
      </div>
      <% if preview.rest.size > Preview::LISTED %>
        <a href="https://github.com/<%= preview.login %>?tab=repositories" target="_blank" rel="noopener" class="os-link mt-3 inline-block text-sm">
          <%= preview.rest.size - Preview::LISTED %> more on GitHub <span aria-hidden="true">↗</span>
        </a>
      <% end %>
    </div>
  <% end %>
</section>
