<% content_for :title, "Preview unavailable — Openstage" %>
<% content_for :head do %><meta name="robots" content="noindex, nofollow"><% end %>
<% content_for :main_class, "os-wrap pt-9" %>

<section class="os-panel mx-auto max-w-[680px] p-6 text-center sm:p-11">
  <h1 class="os-h1 text-[clamp(28px,4vw,40px)]"><%= @busy ? "Too many previews this hour" : "GitHub isn't answering right now" %></h1>
  <p class="os-p mt-2.5 text-lg">Try again in a few minutes, or sign in and your stage builds from your account.</p>
  <%= button_to "/auth/github", method: :post, params: { ref: "preview" }, data: { turbo: false }, form: { class: "mt-5.5" }, class: "os-btn" do %>
    <%= brand_icon(:github) %><span>Sign in with GitHub</span>
  <% end %>
</section>
