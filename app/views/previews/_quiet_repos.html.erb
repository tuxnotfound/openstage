<%# A preview with no commits in the 12 months: the public repos the stage
    would show once each gets one, the last updated first. No stars or
    other numbers a stage does not show. %>
<section class="os-panel" aria-labelledby="public-repos">
  <h2 id="public-repos" class="os-h2">Public repos</h2>
  <div class="os-grid2 mt-4">
    <% repos.each do |repo| %>
      <div class="os-card flex flex-col">
        <a href="<%= repo.url %>" target="_blank" rel="noopener" class="os-h3 text-xl hover:underline"><%= repo.name %></a>
        <% if repo.description %>
          <p class="os-p mt-1 text-[15px]"><%= repo.description %></p>
        <% end %>
        <div class="mt-auto pt-3">
          <p class="os-sm os-muted"><%= safe_join([ repo.language, "updated #{repo.updated_at.strftime('%b %Y')}" ].compact, " · ") %></p>
          <% if (website = safe_external_url(repo.homepage)) %>
            <a href="<%= website %>" target="_blank" rel="ugc nofollow noopener" class="os-link mt-1.5 inline-block text-sm"><%= URI(website).host %> <span aria-hidden="true">↗</span></a>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
