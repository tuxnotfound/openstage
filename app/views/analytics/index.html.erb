<% content_for :title, "Analytics — Openstage" %>
<% content_for :main_class, "os-wrap pt-1.5" %>
<% serializer = AnalyticsViewSerializer.new(@report) %>
<% view = serializer.attributes %>
<% default_range = Analytics::ReportService::DEFAULT_RANGE %>
<% path_for = ->(changes) { analytics_path(chart_params(view, default_range: default_range, **changes).compact) } %>

<%# The chart filter every chart page shares, as the page's script draws it
    (AnalyticsIsland) and as it reads without the script: the window beside
    the title; the numbers in their groups, each with its change; the chart;
    and the pages under it, each value with its change. Then where visitors
    came from, the links they followed and the badge and embed, for the same
    window and pages. %>
<%= react_island("analytics", { initial: serializer.as_json, endpoint: api_analytics_path, defaultRange: default_range }, id: "analytics", class: "os-stack") do %>
  <div class="os-between">
    <div class="flex items-center gap-2.5">
      <h1 class="os-h2 text-[30px]">Analytics</h1>
      <span class="os-tag pro">✦ Pro</span>
    </div>
    <%= render "charts/window", view: view, path_for: path_for, css: "max-md:flex max-md:w-full max-md:justify-between" %>
  </div>

  <section class="os-panel" aria-label="Numbers">
    <%= render "charts/toggles", view: view, path_for: path_for, changes: true, groups: true %>
    <%= render "charts/chart", view: view, height: "h-[260px]" %>
    <% if view[:changes_note] %>
      <p class="os-xs os-muted mt-5.5"><%= view[:changes_note] %></p>
    <% end %>
    <%= render "charts/table", view: view, path_for: path_for, label: "Pages" %>
    <p class="os-note mt-0 border-t border-line pt-2.5">Commits: yours, public, merges and dependency bumps left out. Site visits: page views on a project's own website, counted by Openstage's script. On Openstage, your page and your project pages: a visitor is one browser on one day; views count every page load; new followers confirmed by email, for your page or one project; clicks out are a project's Visit and View on GitHub buttons and the links in your entries. Your own visits and bots are left out.</p>
  </section>

  <%= render "analytics/panels", view: view %>
<% end %>
