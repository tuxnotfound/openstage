<%# A value of a website panel and its count, as AnalyticsPanels draws it: a
    long host, tag or path wraps rather than pushing the page sideways, and
    a page has its project under it while pages of several projects count.
    row: { label:, count:, project: }; css: the label's weight. %>
<div class="flex items-baseline justify-between gap-3">
  <span class="os-sm min-w-0 wrap-anywhere <%= local_assigns[:css] %>"><%= row[:label] %><% if row[:project] %><span class="os-xs os-muted block"><%= row[:project] %></span><% end %></span>
  <span class="os-sm os-num font-bold"><%= row[:count] %></span>
</div>
