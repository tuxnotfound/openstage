<%# Under the chart filter, for its window and its pages: the panels of the
    builder's websites, or of their pages on Openstage, as the switch above
    them picks, with a line saying what they count and where. Each option
    links to its view; the page's script swaps the panels in place
    (AnalyticsPanels). view: an AnalyticsViewSerializer's attributes; panels:
    the set shown (AnalyticsHelper::PANELS); path_for: the page's address for
    some params changed. %>
<div class="os-stack">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <div class="os-pills" role="group" aria-label="Panels">
      <% AnalyticsHelper::PANELS.each do |key, label| %>
        <%= link_to label, path_for.call(panels: key), class: "os-pill", aria: { current: ("page" if key == panels) } %>
      <% end %>
    </div>
    <p class="os-xs os-muted">
      <%= panels == "websites" ? "Visitors and page views on your websites, counted by Openstage's script." : "Views and clicks out on your stage and your project pages, and where your badge and embed were shown." %>
    </p>
  </div>
  <%= render panels == "websites" ? "analytics/websites" : "analytics/openstage", view: view %>
</div>
