<%# Under the chart filter, for its window and its pages: where visitors came
    from, the links they followed, and where the badge and embed showed, as
    the page's script draws them (AnalyticsIsland).
    view: an AnalyticsViewSerializer's attributes. %>
<div class="grid items-start gap-4 lg:grid-cols-3">
  <section class="os-panel" aria-labelledby="visitors-from">
    <h2 id="visitors-from" class="os-h3">Where visitors came from</h2>
    <p class="os-xs os-muted mt-1 mb-2">Views of your Openstage pages, by the site they came from, <%= view[:words] %>.</p>
    <% if view[:sources].empty? %>
      <p class="os-note">No visits <%= view[:quiet] %>.</p>
    <% end %>
    <% view[:sources].each do |source| %>
      <div class="os-row py-2">
        <div class="os-between"><span class="os-sm font-semibold"><%= source[:label] %></span><span class="os-sm os-num font-bold"><%= source[:count] %></span></div>
        <div class="mt-1.5 h-1 rounded-sm bg-accent" style="width: <%= source[:width] %>%" aria-hidden="true"></div>
      </div>
    <% end %>
    <% if view[:countries].any? %>
      <h3 class="os-label mt-4.5">Countries</h3>
      <% view[:countries].each do |country| %>
        <div class="os-row os-between py-2"><span class="os-sm"><%= country[:label] %></span><span class="os-sm os-num font-bold"><%= country[:count] %></span></div>
      <% end %>
    <% end %>
  </section>

  <section class="os-panel" aria-labelledby="links-followed">
    <h2 id="links-followed" class="os-h3">Links they followed</h2>
    <p class="os-xs os-muted mt-1 mb-2">Clicks from your pages, <%= view[:words] %>.</p>
    <% view[:links].each do |link| %>
      <div class="os-row os-between gap-3 py-2.5">
        <span class="min-w-0"><span class="block text-[15px] font-semibold"><%= link[:title] %></span><span class="os-xs os-muted"><%= link[:page] %></span></span>
        <span class="os-num font-bold"><%= link[:count] %></span>
      </div>
    <% end %>
    <% if view[:links].empty? %>
      <p class="os-note">No clicks out <%= view[:quiet] %>.</p>
    <% end %>
  </section>

  <section class="os-panel" aria-labelledby="badge-embed">
    <h2 id="badge-embed" class="os-h3">README badge and embed</h2>
    <p class="os-xs os-muted mt-1 mb-2">Times they were shown on other sites, <%= view[:words] %>.</p>
    <% view[:badges].each do |badge| %>
      <div class="os-row os-between py-2.5">
        <span class="os-sm font-semibold"><%= badge[:label] %></span>
        <span class="os-sm"><span class="os-num font-bold"><%= badge[:count] %></span> <span class="os-muted">· <%= badge[:sites] %></span></span>
      </div>
    <% end %>
  </section>
</div>
