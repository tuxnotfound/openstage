<%# The panels of the builder's websites (analytics/panels), as Openstage's
    script counted them there: where visitors came from and their countries,
    their ref tags, and the busiest pages, each page with its project while
    pages of several count, each list with Other last, what it leaves out, as the page's script draws them (AnalyticsPanels). With none of
    them, one line says why, with a link to set up site visits while none of
    the projects in view counts them.
    view: an AnalyticsViewSerializer's attributes. %>
<% site = view[:websites] %>
<% if site[:empty] %>
  <div class="os-panel">
    <p class="os-note"><%= site[:empty] %>
      <%= link_to site[:setup][:text], site[:setup][:path], class: "os-link text-[13px]" if site[:setup] %></p>
  </div>
<% else %>
  <div class="grid items-start gap-4 lg:grid-cols-3">
    <section class="os-panel" aria-labelledby="site-sources">
      <h2 id="site-sources" class="os-h3">Where visitors came from</h2>
      <p class="os-xs os-muted mt-1 mb-2">Visitors to your websites, by the site they came from, <%= view[:words] %>.</p>
      <% if site[:sources].empty? %>
        <p class="os-note">No sources <%= view[:quiet] %>.</p>
      <% end %>
      <% site[:sources].each do |source| %>
        <div class="os-row py-2">
          <%= render "analytics/count", row: source, css: "font-semibold" %>
          <div class="mt-1.5 h-1 rounded-sm bg-accent" style="width: <%= source[:width] %>%" aria-hidden="true"></div>
        </div>
      <% end %>
      <% if site[:countries].any? %>
        <h3 class="os-label mt-4.5">Countries</h3>
        <% site[:countries].each do |country| %>
          <div class="os-row py-2"><%= render "analytics/count", row: country %></div>
        <% end %>
      <% end %>
    </section>

    <section class="os-panel" aria-labelledby="site-refs">
      <h2 id="site-refs" class="os-h3">Ref tags</h2>
      <p class="os-xs os-muted mt-1 mb-2">Visitors by the ref or utm_source tag in their link, <%= view[:words] %>.</p>
      <% site[:refs].each do |ref| %>
        <div class="os-row py-2"><%= render "analytics/count", row: ref %></div>
      <% end %>
      <% if site[:refs].empty? %>
        <p class="os-note">No ref tags <%= view[:quiet] %>.</p>
      <% end %>
    </section>

    <section class="os-panel" aria-labelledby="site-pages">
      <h2 id="site-pages" class="os-h3">Top pages</h2>
      <p class="os-xs os-muted mt-1 mb-2">Page views on your websites, by path, <%= view[:words] %>.</p>
      <% site[:pages].each do |page| %>
        <div class="os-row py-2"><%= render "analytics/count", row: page %></div>
      <% end %>
      <% if site[:pages].empty? %>
        <p class="os-note">No page views <%= view[:quiet] %>.</p>
      <% end %>
    </section>
  </div>
<% end %>
