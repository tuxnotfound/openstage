<%# The switch that shows a number on a project's page, on its own view. %>
<%= form_with url: project_numbers_path(repo), method: :patch, data: { turbo: false } do %>
  <%= hidden_field_tag :number, number, id: nil %>
  <%= hidden_field_tag :shown, (!repo.picks?(number)).to_s, id: nil %>
  <%= hidden_field_tag :back, "project", id: nil %>
  <button type="submit" role="switch" aria-checked="<%= repo.picks?(number) %>" aria-label="Show <%= word %> on <%= repo.name %>'s page" class="os-switch"></button>
<% end %>
