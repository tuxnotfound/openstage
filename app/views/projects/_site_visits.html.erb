<%# A project's Site visits row: the last 30 days, where they stand, and the
    switch that shows them on its page. Change source opens the setup under
    it: Openstage's script and its line to paste, or Free's one site. %>
<% host = repo.site_host %>
<% line, state = site_visits_status(repo, overview) %>
<div id="site-visits" class="scroll-mt-6" data-controller="toggle" data-toggle-open-value="<%= params[:site] == "open" %>">
  <div class="os-row flex items-center gap-3.5 py-3">
    <span class="min-w-0 flex-auto">
      <span class="font-bold">Site visits</span>
      <span class="os-num os-muted text-sm"><%= overview.site_visits.positive? ? number_with_delimiter(overview.site_visits) : "–" %></span>
      <span class="os-xs os-muted block"><%= line %></span>
    </span>
    <button type="button" class="os-link whitespace-nowrap text-[13px]" aria-controls="site-source" aria-expanded="false"
            data-toggle-target="trigger" data-action="toggle#toggle">
      <span data-toggle-target="openIcon"><%= repo.site_source ? "Change source" : "Set up" %></span><span data-toggle-target="closeIcon" class="hidden">Close</span>
    </button>
    <span class="os-xs os-muted whitespace-nowrap"><%= state %></span>
    <%= form_with url: project_site_visits_path(repo), method: :patch, data: { turbo: false } do %>
      <%= hidden_field_tag :shown, (!repo.site_visits_shown?).to_s, id: nil %>
      <button type="submit" role="switch" aria-checked="<%= repo.site_visits_shown? %>" aria-label="Show site visits on <%= repo.name %>'s page" class="os-switch"></button>
    <% end %>
  </div>

  <div id="site-source" data-toggle-target="content" class="os-card mb-3 hidden">
    <% if overview.site_state == :no_website %>
      <p class="os-sm m-0">Add <%= repo.name %>'s website under What it is first: the script counts only there.</p>
    <% elsif overview.free_site %>
      <p class="os-sm m-0">Free counts one site, and <%= overview.free_site.site_host || overview.free_site.name %> counts now. Count <%= host %> instead, or go Pro to count both.</p>
      <div class="mt-3 flex flex-wrap gap-2.5">
        <%= button_to "Count this one instead", project_site_visits_path(repo), method: :patch, params: { source: "script", count_here: 1 },
              class: "os-btn2 sm", form: { data: { turbo: false } } %>
        <%= link_to "Upgrade to Pro", pricing_path, class: "os-btn sm" %>
      </div>
    <% else %>
      <p class="os-label">Where <%= host %>'s visits come from</p>
      <div class="os-pills mt-2" role="group" aria-label="Source">
        <% [ [ "script", "Openstage's script" ], [ "off", "Off" ] ].each do |source, label| %>
          <% on = source == "off" ? repo.site_source.nil? : repo.site_source == source %>
          <%= button_to label, project_site_visits_path(repo), method: :patch, params: { source: source },
                class: "os-pill", aria: { pressed: on }, form: { data: { turbo: false } } %>
        <% end %>
      </div>
      <% if repo.site_source == "script" %>
        <div data-controller="clipboard">
          <p class="os-sm mt-3.5 mb-2">Paste this line into the head of every page on <%= host %>:</p>
          <div class="os-code whitespace-pre-wrap break-all" data-clipboard-target="source"><%= site_script_tag(repo) %></div>
          <div class="os-between mt-2.5">
            <% if repo.site_first_visit_at %>
              <span class="os-sm font-bold text-up">First visit received <%= site_first_visit(repo) %></span>
            <% else %>
              <span class="os-sm os-muted">Waiting for the first visit: open <%= host %> once the line is in.</span>
            <% end %>
            <button type="button" class="os-btn2 sm" data-clipboard-target="button" data-action="clipboard#copy">Copy</button>
          </div>
        </div>
        <p class="os-note mt-2">
          It counts only on <%= host %>. No cookie: a visitor is one browser on one day, and only the day's totals are kept.
          <%= link_to "What it counts", privacy_path(anchor: "builders-sites"), class: "os-link text-[13px]" %>
        </p>
      <% else %>
        <p class="os-sm os-muted mt-3.5 mb-0">Nothing is counted for <%= repo.name %>.</p>
      <% end %>
    <% end %>
  </div>
</div>
