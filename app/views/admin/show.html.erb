<% content_for :title, "Admin" %>
<% content_for :dark_mode, true %>
<% content_for :main_class, "os-wrap os-stack pt-1.5" %>

<% peak = [ @signups_by_day.values.max, 1 ].max %>


  <div>
    <h1 class="os-h2 text-[30px]">Admin</h1>
    <p class="os-sm os-muted mt-0.5">Last <%= AdminController::DAYS %> days. The numbers the gates are scored on, and nothing else.</p>
  </div>

  <!-- Gate numbers -->
  <section class="grid grid-cols-2 gap-3 sm:grid-cols-5" aria-label="Gate numbers">
    <% [
         [ "Signups", @cohort, "in window" ],
         [ "Activated", @activated, "#{@cohort.zero? ? 0 : (100.0 * @activated / @cohort).round}% of signups" ],
         [ "Recaps posted", @posted_recaps, "by #{pluralize(@posted_by_user, 'builder')}" ],
         [ "With email", @with_email, "of #{@cohort} signups" ],
         [ "Subscribes", @subscribes, "confirmed, any page" ]
       ].each do |label, value, sub| %>
      <div class="os-card">
        <p class="os-label"><%= label %></p>
        <p class="os-num mt-0.5 text-[32px] leading-none"><%= value %></p>
        <p class="os-xs os-muted mt-1"><%= sub %></p>
      </div>
    <% end %>
  </section>

  <div class="os-grid3 items-start">
  <!-- Attribution -->
  <section class="os-panel">
    <h2 class="os-h3">Signups by first touch</h2>
    <% if @signups_by_ref.any? %>
      <div class="mt-2.5">
        <% @signups_by_ref.each do |ref, count| %>
          <div class="os-row os-between py-2" data-ref="<%= ref %>" data-count="<%= count %>">
            <span class="os-sm"><%= ref %></span>
            <span class="os-sm os-num font-bold"><%= count %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="os-sm os-muted mt-2.5">No signups in the window.</p>
    <% end %>
    <p class="os-xs os-muted mt-2">Tagged links carry <code>?ref=</code>. Older rows predate the tagging and read as "unattributed".</p>
  </section>

  <!-- Signups per day -->
  <section class="os-panel">
    <h2 class="os-h3">Signups per day</h2>
    <div class="mt-2.5 flex h-16 items-end gap-0.5">
      <% @signups_by_day.each do |date, count| %>
        <div class="flex-1 rounded-sm <%= count.positive? ? "bg-accent" : "bg-line" %>"
             style="height: <%= count.zero? ? 2 : (100.0 * count / peak).round %>%"
             title="<%= date %>: <%= pluralize(count, 'signup') %>"></div>
      <% end %>
    </div>
  </section>

  <!-- Returns: the Gate 1 north star -->
  <section class="os-panel">
    <h2 class="os-h3">Did they come back</h2>
    <div class="mt-2.5">
      <div class="os-row os-between py-2" data-metric="returned" data-count="<%= @returned %>">
        <span class="os-sm">Came back on a later day</span>
        <span class="os-sm os-num font-bold"><%= @returned %> of <%= @strangers %></span>
      </div>
      <div class="os-row os-between py-2" data-metric="second-week" data-count="<%= @second_week %>">
        <span class="os-sm">Came back in their second week</span>
        <span class="os-sm os-num font-bold"><%= @second_week %> of <%= @week_old %> old enough</span>
      </div>
    </div>
    <p class="os-xs os-muted mt-2">Signups in the window, not counting you. Counted from 2026-09-21; earlier visits were never recorded.</p>
  </section>

  <!-- Tagged link visits -->
  <section class="os-panel">
    <h2 class="os-h3">Visits from tagged links</h2>
    <% if @ref_visits.any? %>
      <div class="mt-2.5">
        <% @ref_visits.each do |ref, count| %>
          <div class="os-row os-between py-2" data-ref-visit="<%= ref %>" data-count="<%= count %>">
            <span class="os-sm"><%= ref %></span>
            <span class="os-sm os-num font-bold"><%= count %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="os-sm os-muted mt-2.5">No tagged visits yet.</p>
    <% end %>
    <p class="os-xs os-muted mt-2">One per browser session, signed-out humans only. This is the top of the funnel that "signups by first touch" is the bottom of.</p>
  </section>

  <!-- Recap funnel -->
  <section class="os-panel">
    <h2 class="os-h3">Recap, builders other than you</h2>
    <div class="mt-2.5">
      <% labels = { "recap_opened" => "Opened the picker", "recap_picked" => "Ticked at least one commit",
                    "recap_copied" => "Copied the post", "recap_intent" => "Opened a compose box" } %>
      <% @recap_funnel.each do |name, builders| %>
        <div class="os-row os-between py-2" data-recap-step="<%= name %>" data-count="<%= builders %>">
          <span class="os-sm"><%= labels[name] %></span>
          <span class="os-sm os-num font-bold"><%= builders %></span>
        </div>
      <% end %>
      <div class="os-row os-between py-2" data-recap-step="recap_quiet" data-count="<%= @recap_quiet %>">
        <span class="os-sm os-muted">Saw the quiet-week state instead</span>
        <span class="os-sm os-muted font-bold"><%= @recap_quiet %></span>
      </div>
    </div>
    <p class="os-xs os-muted mt-2">Distinct builders per step. A page that merely rendered is never counted.</p>
  </section>

  <!-- Progress cards: the Make a card dialog on a builder's own page -->
  <section class="os-panel">
    <h2 class="os-h3">Progress cards, builders other than you</h2>
    <div class="mt-2.5">
      <% labels = { "progress_card_downloaded" => "Downloaded a card", "progress_post_copied" => "Copied the post" } %>
      <% @card_funnel.each do |name, builders| %>
        <div class="os-row os-between py-2" data-card-step="<%= name %>" data-count="<%= builders %>">
          <span class="os-sm"><%= labels[name] %></span>
          <span class="os-sm os-num font-bold"><%= builders %></span>
        </div>
      <% end %>
    </div>
    <p class="os-xs os-muted mt-2">Distinct builders per step, to set beside the recap's.</p>
  </section>

  <!-- Weekly email (F2) -->
  <section class="os-panel">
    <h2 class="os-h3">Weekly email, builders other than you</h2>
    <div class="mt-2.5">
      <% [ [ "weekly_mailed", "Got the weekly email", @weekly_mailed ],
           [ "weekly_opened", "Opened the picker from it", @weekly_opened ],
           [ "digests_mailed", "Subscribers sent a digest", @digests_mailed ] ].each do |key, label, count| %>
        <div class="os-row os-between py-2" data-weekly-step="<%= key %>" data-count="<%= count %>">
          <span class="os-sm"><%= label %></span>
          <span class="os-sm os-num font-bold"><%= count %></span>
        </div>
      <% end %>
    </div>
    <p class="os-xs os-muted mt-2">Last send per builder and per subscriber. The picker step above shows what they did next.</p>
  </section>

  <!-- Repos with more than one builder -->
  <section class="os-panel">
    <h2 class="os-h3">Repos with more than one builder</h2>
    <% if @shared_repos.any? %>
      <div class="mt-2.5">
        <% @shared_repos.each do |repo, builders| %>
          <div class="os-row os-between py-2" data-shared-repo="<%= repo %>" data-builders="<%= builders %>">
            <span class="os-sm truncate font-mono"><%= repo %></span>
            <span class="os-sm ml-3 shrink-0 font-bold"><%= pluralize(builders, "builder") %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="os-sm os-muted mt-2.5">None yet.</p>
    <% end %>
    <p class="os-xs os-muted mt-2">A second builder on a repo was recruited by a teammate, not by you. This is the earliest audience signal there is.</p>
  </section>

  <!-- All time -->
  <section class="os-panel">
    <h2 class="os-h3">All time</h2>
    <div class="mt-2.5">
      <div class="os-row os-between py-2">
        <span class="os-sm">Builders</span><span class="os-sm os-num font-bold"><%= @total_users %></span>
      </div>
      <div class="os-row os-between py-2">
        <span class="os-sm">Public entries</span><span class="os-sm os-num font-bold"><%= @total_entries %></span>
      </div>
      <div class="os-row os-between py-2">
        <span class="os-sm">Pro</span><span class="os-sm os-num font-bold"><%= @pro_users %></span>
      </div>
    </div>
  </section>

  </div>

  <!-- Email smoke test -->
  <section class="os-panel">
    <h2 class="os-h3">Email</h2>
    <div class="mt-3 flex flex-wrap gap-2.5">
      <%= button_to "Send myself a test email", admin_test_email_path,
            class: "os-btn2 sm" %>
      <%= button_to "Send myself both weekly emails", admin_test_weekly_email_path,
            class: "os-btn2 sm" %>
    </div>
    <p class="os-xs os-muted mt-2">Delivery stays off until <code>RESEND_API_KEY</code> is set in Render.</p>
    <p class="os-xs os-muted mt-1">The weekly emails show my own week as it stands, the builder's and a subscriber's, marked [Test]. Friday still sends.</p>
  </section>

  <p class="os-xs os-muted">
    Gate 0 is Sep 21 &middot; Gate 1 Oct 12 &middot; Gate 2 Oct 26 &middot; Gate 3 Nov 15.
    See <code>control-tower/projects/openstage/REBIRTH_PLAN.md</code>.
  </p>
