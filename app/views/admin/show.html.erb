<% content_for :title, "Admin" %>
<% content_for :main_class, "os-wrap os-stack pt-1.5" %>

<% peak = [ @signups_by_day.values.max, 1 ].max %>
<% old = @gates.old_enough %>

  <div class="os-between">
    <div>
      <h1 class="os-h2 text-[30px]">Admin</h1>
      <p class="os-sm os-muted mt-0.5">Last <%= @days %> days. The numbers the gates are scored on, and nothing else.</p>
    </div>
    <nav class="os-pills" aria-label="Window">
      <% AdminController::WINDOWS.each do |days| %>
        <%= link_to "#{days} days", admin_path(days: (days unless days == AdminController::DAYS)), class: "os-pill",
              aria: { current: (days == @days ? "page" : nil) } %>
      <% end %>
    </nav>
  </div>

  <!-- Gate numbers -->
  <section class="grid grid-cols-2 gap-3 sm:grid-cols-5" aria-label="Gate numbers">
    <% [
         [ "Signups", @cohort, "in window" ],
         [ "Activated", @activated, "#{@cohort.zero? ? 0 : (100.0 * @activated / @cohort).round}% of signups" ],
         [ "Recaps posted", @posted_recaps, "by #{pluralize(@posted_by_user, 'builder')}" ],
         [ "With email", @with_email, "of #{@cohort} signups" ],
         [ "Subscribes", @subscribes, "confirmed, any page" ]
       ].each do |label, value, sub| %>
      <div class="os-card">
        <p class="os-label"><%= label %></p>
        <p class="os-num mt-0.5 text-[32px] leading-none"><%= value %></p>
        <p class="os-xs os-muted mt-1"><%= sub %></p>
      </div>
    <% end %>
  </section>

  <div class="os-grid3 items-start">
  <!-- Attribution -->
  <section class="os-panel">
    <h2 class="os-h3">Signups by first touch</h2>
    <% if @signups_by_ref.any? %>
      <div class="mt-2.5">
        <% @signups_by_ref.each do |ref, count| %>
          <div class="os-row os-between py-2" data-ref="<%= ref %>" data-count="<%= count %>">
            <span class="os-sm"><%= ref %></span>
            <span class="os-sm os-num font-bold"><%= count %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="os-sm os-muted mt-2.5">No signups in the window.</p>
    <% end %>
    <p class="os-xs os-muted mt-2">Tagged links carry <code>?ref=</code>. Older rows predate the tagging and read as "unattributed".</p>
  </section>

  <!-- Signups per day -->
  <section class="os-panel">
    <h2 class="os-h3">Signups per day</h2>
    <div class="mt-2.5 flex h-16 items-end gap-0.5">
      <% @signups_by_day.each do |date, count| %>
        <div class="flex-1 rounded-sm <%= count.positive? ? "bg-accent" : "bg-line" %>"
             style="height: <%= count.zero? ? 2 : (100.0 * count / peak).round %>%"
             title="<%= date %>: <%= pluralize(count, 'signup') %>"></div>
      <% end %>
    </div>
  </section>

  <!-- Returns: the Gate 1 north star -->
  <section class="os-panel">
    <h2 class="os-h3">Did they come back</h2>
    <div class="mt-2.5">
      <div class="os-row os-between py-2" data-metric="returned" data-count="<%= @returned %>">
        <span class="os-sm">Came back on a later day</span>
        <span class="os-sm os-num font-bold"><%= @returned %> of <%= @strangers %></span>
      </div>
      <div class="os-row os-between py-2" data-metric="second-week" data-count="<%= @second_week %>">
        <span class="os-sm">Came back in their second week</span>
        <span class="os-sm os-num font-bold"><%= @second_week %> of <%= @week_old %> old enough</span>
      </div>
    </div>
    <p class="os-xs os-muted mt-2">Signups in the window, not counting you. Counted from 2026-09-21; earlier visits were never recorded.</p>
  </section>

  <!-- The second week by the retention rule's three clauses: Gate 4's bar 2 -->
  <section class="os-panel">
    <h2 class="os-h3">Kept in their second week</h2>
    <div class="mt-2.5">
      <% [ [ "any", "By any of the three", old.count(&:retained?) ],
           [ "came-back", "Came back, signed in", old.count(&:came_back) ],
           [ "seen", "Seen twice by others", old.count(&:seen?) ],
           [ "shown", "A badge or an embed shown", old.count(&:shown?) ] ].each do |key, label, count| %>
        <div class="os-row os-between py-2" data-kept="<%= key %>" data-count="<%= count %>">
          <span class="os-sm"><%= label %></span>
          <span class="os-sm os-num font-bold"><%= count %><%= " of #{old.size} old enough" if key == "any" %></span>
        </div>
      <% end %>
    </div>
    <p class="os-xs os-muted mt-2">Days 7 to 13 after signup, not counting you. A view is someone else's: a builder's own and a bot's are never recorded.</p>
  </section>

  <!-- What the builders in the window set up, and Revamp bar 3 -->
  <section class="os-panel">
    <h2 class="os-h3">What they set up</h2>
    <div class="mt-2.5">
      <% [ [ "sites", "Set up site visits", @gates.rows.count { |row| row.sites.positive? } ],
           [ "counting", "Counted a first visit", @gates.rows.count { |row| row.counting.positive? } ],
           [ "stripe", "Connected Stripe", @gates.rows.count(&:stripe) ],
           [ "pro", "On Pro", @gates.rows.count { |row| row.user.pro? } ],
           [ "outside", "From GitHub or their own site", @gates.rows.count { |row| row.outside.positive? } ] ].each do |key, label, count| %>
        <div class="os-row os-between py-2" data-set-up="<%= key %>" data-count="<%= count %>">
          <span class="os-sm"><%= label %></span>
          <span class="os-sm os-num font-bold"><%= count %> of <%= @gates.rows.size %></span>
        </div>
      <% end %>
    </div>
    <p class="os-xs os-muted mt-2">Builders who signed up in the window, not counting you, since their signup. The last row: a project's page seen by someone who came from there.</p>
  </section>

  <!-- Tagged link visits -->
  <section class="os-panel">
    <h2 class="os-h3">Visits from tagged links</h2>
    <% if @ref_visits.any? %>
      <div class="mt-2.5">
        <% @ref_visits.each do |ref, count| %>
          <div class="os-row os-between py-2" data-ref-visit="<%= ref %>" data-count="<%= count %>">
            <span class="os-sm"><%= ref %></span>
            <span class="os-sm os-num font-bold"><%= count %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="os-sm os-muted mt-2.5">No tagged visits yet.</p>
    <% end %>
    <p class="os-xs os-muted mt-2">One per browser session, signed-out humans only. This is the top of the funnel that "signups by first touch" is the bottom of.</p>
  </section>

  <!-- Sign-in starts -->
  <section class="os-panel">
    <h2 class="os-h3">Sign-ins started</h2>
    <% if @sign_in_starts.any? %>
      <div class="mt-2.5">
        <% @sign_in_starts.each do |ref, count| %>
          <div class="os-row os-between py-2" data-sign-in-start="<%= ref %>" data-count="<%= count %>">
            <span class="os-sm"><%= ref %></span>
            <span class="os-sm os-num font-bold"><%= count %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="os-sm os-muted mt-2.5">No sign-in started in the window.</p>
    <% end %>
    <p class="os-xs os-muted mt-2">Every click on Make your own stage or Sign in, before GitHub's screen, by first touch. Signed-out humans only; a member signing back in counts too.</p>
  </section>

  <section class="os-panel">
    <h2 class="os-h3">Stages previewed</h2>
    <% if @previews.any? %>
      <div class="mt-2.5">
        <% @previews.each do |ref, count| %>
          <div class="os-row os-between py-2" data-preview-count="<%= ref %>" data-count="<%= count %>">
            <span class="os-sm"><%= ref %></span>
            <span class="os-sm os-num font-bold"><%= count %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="os-sm os-muted mt-2.5">No stage previewed in the window.</p>
    <% end %>
    <p class="os-xs os-muted mt-2">A GitHub username typed to see its stage before sign-in, once per username per visitor, by first touch. Signed-out humans only. Their claims are sign-ins started from it, tagged preview when the visitor came with no tag.</p>
  </section>

  <!-- Weekly email (F2) -->
  <section class="os-panel">
    <h2 class="os-h3">Weekly email, builders other than you</h2>
    <div class="mt-2.5">
      <% [ [ "weekly_mailed", "Got the weekly email", @weekly_mailed ],
           [ "digests_mailed", "Subscribers sent a digest", @digests_mailed ] ].each do |key, label, count| %>
        <div class="os-row os-between py-2" data-weekly-step="<%= key %>" data-count="<%= count %>">
          <span class="os-sm"><%= label %></span>
          <span class="os-sm os-num font-bold"><%= count %></span>
        </div>
      <% end %>
    </div>
    <p class="os-xs os-muted mt-2">Last send per builder and per subscriber.</p>
  </section>

  <!-- Analytics opens -->
  <section class="os-panel">
    <h2 class="os-h3">Analytics, builders other than you</h2>
    <div class="mt-2.5">
      <div class="os-row os-between py-2" data-analytics-tab="any" data-count="<%= @analytics.builders %>">
        <span class="os-sm">Opened any tab</span>
        <span class="os-sm os-num font-bold"><%= @analytics.builders %></span>
      </div>
      <% @analytics.tabs.each do |tab| %>
        <div class="os-row os-between py-2" data-analytics-tab="<%= tab.key %>" data-count="<%= tab.builders %>">
          <span class="os-sm"><%= tab.label %></span>
          <span class="os-sm os-num font-bold"><%= tab.builders %></span>
        </div>
      <% end %>
    </div>
    <p class="os-xs os-muted mt-2">Each builder once per tab. On Free, MRR and Openstage views count the Go Pro view. Counted since this count went live.</p>
  </section>

  <!-- Repos with more than one builder -->
  <section class="os-panel">
    <h2 class="os-h3">Repos with more than one builder</h2>
    <% if @shared_repos.any? %>
      <div class="mt-2.5">
        <% @shared_repos.each do |repo, builders| %>
          <div class="os-row os-between py-2" data-shared-repo="<%= repo %>" data-builders="<%= builders %>">
            <span class="os-sm truncate font-mono"><%= repo %></span>
            <span class="os-sm ml-3 shrink-0 font-bold"><%= pluralize(builders, "builder") %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="os-sm os-muted mt-2.5">None yet.</p>
    <% end %>
    <p class="os-xs os-muted mt-2">A second builder on a repo was recruited by a teammate, not by you. This is the earliest audience signal there is.</p>
  </section>

  <!-- All time -->
  <section class="os-panel">
    <h2 class="os-h3">All time</h2>
    <div class="mt-2.5">
      <div class="os-row os-between py-2">
        <span class="os-sm">Builders</span><span class="os-sm os-num font-bold"><%= @total_users %></span>
      </div>
      <div class="os-row os-between py-2">
        <span class="os-sm">Public entries</span><span class="os-sm os-num font-bold"><%= @total_entries %></span>
      </div>
      <div class="os-row os-between py-2">
        <span class="os-sm">Pro</span><span class="os-sm os-num font-bold"><%= @pro_users %></span>
      </div>
    </div>
  </section>

  </div>

  <!-- Each builder, as the gates read them -->
  <section class="os-panel" aria-labelledby="each-builder">
    <h2 id="each-builder" class="os-h3">Each builder in the window</h2>
    <% if @gates.rows.any? %>
      <div class="mt-2.5 overflow-x-auto">
        <table class="os-sm w-full border-collapse text-left">
          <thead>
            <tr class="os-muted">
              <% [ "Builder", "Signed up", "First touch", "Second week", "Came back", "Views by others", "Badge or embed", "Kept",
                   "From GitHub or own site", "Site visits", "Stripe", "Plan" ].each do |head| %>
                <th scope="col" class="max-w-24 py-2 pr-4 align-bottom font-normal"><%= head %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @gates.rows.each do |row| %>
              <%= render "admin/builder", row: row %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="os-sm os-muted mt-2.5">No signups in the window.</p>
    <% end %>
    <p class="os-xs os-muted mt-2">The second week's columns count days 7 to 13 after signup. The last four count since signup.</p>
  </section>

  <!-- Email smoke test -->
  <section class="os-panel">
    <h2 class="os-h3">Email</h2>
    <div class="mt-3 flex flex-wrap gap-2.5">
      <%= button_to "Send myself a test email", admin_test_email_path,
            class: "os-btn2 sm" %>
      <%= button_to "Send myself both weekly emails", admin_test_weekly_email_path,
            class: "os-btn2 sm" %>
    </div>
    <p class="os-xs os-muted mt-2">Delivery stays off until <code>RESEND_API_KEY</code> is set in Render.</p>
    <p class="os-xs os-muted mt-1">The weekly emails show my own week as it stands, the builder's and a subscriber's, marked [Test]. Friday still sends.</p>
  </section>

  <p class="os-xs os-muted">
    Gate 0 is Sep 21 &middot; Gate 1 Oct 12 &middot; Gate 2 Oct 26 &middot; Gate 3 Nov 15 &middot; the Revamp read Nov 30 &middot; Gate 4 Dec 14.
    See <code>control-tower/projects/openstage/PLAN.md</code>.
  </p>
