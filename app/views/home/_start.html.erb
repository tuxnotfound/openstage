<%# A signed-out visitor's way in: the box first, for the stage their GitHub
    username makes before any sign-in, then GitHub's sign-in as a link for
    whoever is ready, and what that sign-in asks (note: true, as in the
    hero). A live stage is the demo card's own link (home/_demo). While
    previews are off, the sign-in leads, so a deploy before the token never
    loses the way in. id: the box's field, unique on the page; center:
    centred, as at the landing's end. %>
<% email = "Asks only for your email. Your public repos show up on your stage, and you can hide any of them. Private ones only if you add them. Never posts to your X or other accounts." %>
<% if previews_on? %>
  <%= render "previews/form", id: id, form_class: ("mx-auto justify-center" if local_assigns[:center]) %>
  <p class="os-note mt-2.5">No sign-in needed to preview.</p>
  <%= button_to "/auth/github", method: :post, data: { turbo: false, sign_up: true }, form: { class: "mt-3" },
                class: "os-link cursor-pointer text-[15px]" do %>Or sign in with GitHub and skip the preview.<% end %>
  <% if local_assigns[:note] %>
    <p class="os-note mt-2"><%= email %></p>
  <% end %>
<% else %>
  <div class="flex <%= "justify-center" if local_assigns[:center] %>">
    <%= button_to "/auth/github", method: :post, data: { turbo: false, sign_up: true }, class: "os-btn" do %>
      <%= brand_icon(:github) %><span>Make your own stage</span>
    <% end %>
  </div>
  <% if local_assigns[:note] %>
    <p class="os-note mt-3.5"><%= email %></p>
  <% end %>
<% end %>
