<%# GitHub's sign-in as a link, the preview's fallback for whoever is ready
    (the header's button does the same). form_class: its form's. %>
<%= button_to "/auth/github", method: :post, data: { turbo: false, sign_up: true }, form: { class: local_assigns[:form_class] },
              class: "os-link cursor-pointer text-[15px]" do %>Or sign in with GitHub and skip the preview.<% end %>
