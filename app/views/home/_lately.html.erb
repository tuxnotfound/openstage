<%# Recent work from the feed, one entry at a time in a random order, the
    next fading in every few seconds (rotate_controller). Each opens its
    project's page, or the builder's for an entry with no project. %>
<section class="os-panel py-4" aria-labelledby="lately" data-controller="rotate"
         data-action="mouseenter->rotate#hold mouseleave->rotate#release focusin->rotate#hold focusout->rotate#release">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <h2 id="lately" class="os-label shrink-0">Lately on Openstage</h2>
    <div class="relative h-11 min-w-0 flex-[1_1_320px]">
      <% entries.each_with_index do |entry, i| %>
        <% user = entry.user %>
        <% slug = entry.repo_name&.split("/")&.last %>
        <%= link_to (slug ? project_page_path(user.username, slug) : profile_path(user.username)), inert: i.positive?, data: { rotate_target: "item" },
              class: "absolute inset-0 flex items-center gap-3 transition-opacity duration-700 motion-reduce:transition-none #{'opacity-0' if i.positive?}" do %>
          <img src="<%= user.avatar_url %>" alt="" class="os-avatar size-9 shrink-0">
          <span class="min-w-0">
            <span class="block truncate text-[15px] font-semibold"><%= entry.title %></span>
            <span class="os-xs os-muted block truncate">@<%= user.username %><%= " · #{slug}" if slug %> · <%= feed_day(entry.occurred_at.to_date) %></span>
          </span>
        <% end %>
      <% end %>
    </div>
    <div class="flex shrink-0 items-center gap-3">
      <button type="button" class="os-chip h-8.5 px-3 text-ink-2 motion-reduce:hidden" aria-pressed="false"
              data-rotate-target="button" data-action="rotate#toggle">Pause</button>
      <%= link_to "See the feed →", feed_path, class: "os-link text-sm" %>
    </div>
  </div>
</section>
