<% content_for :title, "Openstage — Build in public without the second job" %>
<% content_for :meta_description, "Openstage turns the commits you already push into a public page that keeps itself current, and pre-fills your \"what I shipped\" posts. You pick the lines. Free for indie builders." %>

<%
  # Four questions, each one an objection a builder has before signing in.
  # The FAQPage JSON-LD below mirrors these, so the markup matches visible text.
  faqs = [
    { q: "What is Openstage?",
      a: "A public page that builds itself from your GitHub commits and the milestones and notes you add, plus a recap picker that pre-fills your \"here's what I shipped\" post for the last week, month or 90 days. It is for indie and side-project builders who want to build in public without it becoming a second job." },
    { q: "What does it read from GitHub?",
      a: "Sign-in asks only for your email address. Public repos you push to sync every 2 hours. Private repos stay out unless you connect them in Settings and include each one, and even then only commit messages appear, never links to the code." },
    { q: "Does it post for me?",
      a: "No. It lists the commits in the window you pick; you tick the lines worth saying, edit the text and post it yourself on X or Bluesky. Openstage never writes, ranks or posts anything for you." },
    { q: "What does it cost?",
      a: "The page, the sync, the recap picker and a subscribe box on your page are free for good. Pro is $49 once, or $7 a month, and adds your subscriber list, profile analytics, private entries and pins." }
  ]
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org",
      "@type" => "SoftwareApplication",
      "name" => "Openstage",
      "applicationCategory" => "DeveloperApplication",
      "operatingSystem" => "Web",
      "url" => root_url,
      "description" => SeoHelper::DEFAULT_DESCRIPTION,
      "offers" => [
        { "@type" => "Offer", "name" => "Free", "price" => "0", "priceCurrency" => "USD" },
        { "@type" => "Offer", "name" => "Pro Monthly", "price" => "7", "priceCurrency" => "USD" },
        { "@type" => "Offer", "name" => "Pro Lifetime", "price" => "49", "priceCurrency" => "USD" }
      ]
    }.to_json.html_safe %>
  </script>
  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org",
      "@type" => "FAQPage",
      "mainEntity" => faqs.map { |f|
        {
          "@type" => "Question",
          "name" => f[:q],
          "acceptedAnswer" => { "@type" => "Answer", "text" => f[:a] }
        }
      }
    }.to_json.html_safe %>
  </script>
<% end %>

<%# The friction, stated once: showing your work is a second job. The page and
    the recap are two outputs of the same commits, not two products. %>

<!-- Hero -->
<section class="grid gap-10 lg:grid-cols-2 lg:items-center pt-6 sm:pt-10 pb-12">
  <div>
    <p class="text-sm font-medium text-gray-500 mb-3">For indie and side-project builders</p>
    <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 tracking-tight leading-[1.1]">Keep shipping.<br>Openstage does the showing.</h1>
    <p class="text-lg text-gray-600 mt-5 max-w-lg">The commits you already push become a public page that keeps itself current, and a &ldquo;here's what I shipped&rdquo; post you only pick lines for.</p>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 mt-8">
      <% if user_signed_in? %>
        <%= link_to "Go to your dashboard", dashboard_path, class: "inline-flex items-center gap-2 bg-gray-900 text-white px-6 py-3 rounded-lg text-sm font-medium hover:bg-gray-700" %>
      <% else %>
        <%= button_to "/auth/github", method: :post, data: { turbo: false }, class: "inline-flex items-center gap-2 bg-gray-900 text-white px-6 py-3 rounded-lg text-sm font-medium hover:bg-gray-700 border-0 cursor-pointer" do %>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          Start free with GitHub
        <% end %>
      <% end %>
      <% if @demo_user %>
        <%= link_to "See a live page →", profile_path(@demo_user.username), class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
      <% end %>
    </div>

    <p class="text-xs text-gray-400 mt-4 max-w-md">Public repos sync on their own. Private ones only if you add them. Nothing is ever posted for you.</p>
  </div>

  <% if @demo_user && (@demo_highlight || @demo_entries.any?) %>
    <% kind = { "milestone" => "milestone", "note" => "note", "released" => "release" }[@demo_highlight&.entry_type] %>
    <div>
      <%# The whole card is the link, so the only text link to the live page is
          the one beside the sign-in button. %>
      <%= link_to profile_path(@demo_user.username),
            class: "block rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden hover:border-gray-300 hover:shadow-md transition",
            aria: { label: "Open #{@demo_user.display_name}'s live Openstage page" } do %>
        <div class="flex items-center gap-3 px-5 py-4 border-b border-gray-100">
          <img src="<%= @demo_user.avatar_url %>" alt="" class="w-9 h-9 rounded-full shrink-0">
          <div class="min-w-0">
            <p class="text-sm font-semibold text-gray-900 truncate"><%= @demo_user.display_name %></p>
            <p class="text-xs text-gray-400 font-mono truncate">openstage.dev/<%= @demo_user.username %></p>
          </div>
        </div>

        <div class="divide-y divide-gray-100">
          <% if @demo_highlight %>
            <div class="px-5 py-3" data-demo-highlight>
              <p class="text-xs font-medium text-amber-700 mb-1"><%= @demo_highlight.pinned? ? "Pinned #{kind}" : kind.capitalize %>, written by hand</p>
              <p class="text-sm font-medium text-gray-900 leading-snug"><%= truncate(@demo_highlight.title, length: 90) %></p>
              <p class="text-xs text-gray-400 mt-1"><%= time_ago_in_words(@demo_highlight.occurred_at) %> ago</p>
            </div>
          <% end %>
          <% @demo_entries.each do |entry| %>
            <div class="px-5 py-3">
              <p class="text-sm text-gray-800 leading-snug"><%= truncate(entry.title, length: 90) %></p>
              <p class="text-xs text-gray-400 mt-1">
                <% if entry.repo_name.present? %><%= entry.repo_name.split("/").last %> &middot; <% end %>
                <%= time_ago_in_words(entry.occurred_at) %> ago
              </p>
            </div>
          <% end %>
        </div>
      <% end %>

      <p class="mt-3 text-center text-sm text-gray-400">
        <% if @demo_highlight %>
          A real Openstage page: the commits synced on their own, the <%= kind %> took one line.
        <% else %>
          A real Openstage page, kept current by its commits.
        <% end %>
      </p>
    </div>
  <% end %>
</section>

<!-- How it works -->
<section class="py-12 border-t border-gray-100" aria-labelledby="how">
  <h2 id="how" class="text-2xl font-bold text-gray-900 tracking-tight">How it works</h2>
  <p class="text-gray-500 mt-2 max-w-xl">One sign-in and the page builds itself. The rest is optional, and quick.</p>

  <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mt-8">
    <li>
      <div class="text-xs font-mono text-gray-400 mb-1">01</div>
      <h3 class="font-semibold text-gray-900">Push code like you already do</h3>
      <p class="text-sm text-gray-500 mt-1">Sign in with GitHub. Your public repos sync every 2 hours, and a day of commits folds into one work session. Nothing to install.</p>
    </li>
    <li>
      <div class="text-xs font-mono text-gray-400 mb-1">02</div>
      <h3 class="font-semibold text-gray-900">Add what commits can't say</h3>
      <p class="text-sm text-gray-500 mt-1">A launch, a decision, a lesson. Milestones and notes take one line, sit next to your commits, and land in your recaps.</p>
    </li>
    <li>
      <div class="text-xs font-mono text-gray-400 mb-1">03</div>
      <h3 class="font-semibold text-gray-900">Recap a week or a month</h3>
      <p class="text-sm text-gray-500 mt-1">Openstage lists your commits from the last 7, 30 or 90 days. You tick the lines worth saying, edit freely, and post it yourself on X or Bluesky.</p>
    </li>
    <li>
      <div class="text-xs font-mono text-gray-400 mb-1">04</div>
      <h3 class="font-semibold text-gray-900">Share one link</h3>
      <p class="text-sm text-gray-500 mt-1">Put your page in your bio and a live badge in your README; every recap you post brings people back to it. Visitors can subscribe to your page.</p>
    </li>
  </ol>

  <%# Step 3 with the founder's real week and the post that came out of it.
      Nothing is mocked: no logged post, no example. %>
  <% if @recap_post %>
    <% picked, rest = @recap_lines.partition { |c| @recap_post.body.include?(c.title) } %>
    <% shown = (picked + rest).first(5) %>
    <div class="mt-10" data-landing-recap>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-gray-200 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">The week's commits</p>
          <ul class="space-y-1.5" aria-label="Example commits, with the shared ones ticked">
            <% shown.each do |line| %>
              <% on = picked.include?(line) %>
              <li class="flex items-start gap-2 text-sm <%= on ? 'text-gray-900' : 'text-gray-400' %>">
                <span aria-hidden="true" class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded border text-[10px] <%= on ? 'bg-gray-900 border-gray-900 text-white' : 'border-gray-300' %>"><%= "✓" if on %></span>
                <span class="leading-snug"><%= line.title %></span>
              </li>
            <% end %>
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">The post</p>
          <p class="whitespace-pre-line text-sm text-gray-800 leading-relaxed"><%= @recap_post.body %></p>
          <% if (post_url = safe_external_url(@recap_post.url)) %>
            <%= link_to "See it where it was posted →", post_url, target: "_blank", rel: "noopener",
                  class: "inline-block text-xs text-gray-500 hover:text-gray-900 mt-3" %>
          <% end %>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-3">Step 3 from a real week of <%= link_to "@#{@demo_user.username}", profile_path(@demo_user.username), class: "underline hover:text-gray-700" %>, not a mockup.</p>
    </div>
  <% end %>
</section>

<!-- FAQ (visible content mirrors the FAQPage schema above) -->
<section class="py-12 border-t border-gray-100" aria-labelledby="faq">
  <div class="max-w-2xl">
    <h2 id="faq" class="text-2xl font-bold text-gray-900 tracking-tight mb-4">Frequently asked questions</h2>
    <%# Native <details>: collapsible, keyboard- and screen-reader-correct, no JS. %>
    <div class="divide-y divide-gray-100">
      <% faqs.each_with_index do |f, i| %>
        <details class="group py-4" <%= "open" if i.zero? %>>
          <summary class="flex items-start justify-between gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <h3 class="font-medium text-gray-900"><%= f[:q] %></h3>
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-gray-400 transition-transform group-open:rotate-90"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </summary>
          <p class="text-sm text-gray-600 mt-1.5 leading-relaxed"><%= f[:a] %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>

<!-- Closing CTA -->
<section class="py-14 border-t border-gray-100 text-center">
  <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">Your commits already tell the story.</h2>
  <p class="text-gray-500 mt-2">Give them a page. Free, and it fills itself.</p>
  <div class="mt-6 flex flex-col items-center gap-3">
    <% if user_signed_in? %>
      <%= link_to "Go to your dashboard", dashboard_path, class: "inline-flex items-center gap-2 bg-gray-900 text-white px-6 py-3 rounded-lg text-sm font-medium hover:bg-gray-700" %>
    <% else %>
      <%= button_to "Start free with GitHub", "/auth/github", method: :post, data: { turbo: false }, class: "inline-flex items-center gap-2 bg-gray-900 text-white px-6 py-3 rounded-lg text-sm font-medium hover:bg-gray-700 border-0 cursor-pointer" %>
    <% end %>
    <%= link_to "Pro is $49 once. See pricing", pricing_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  </div>
</section>
