<% content_for :title, "Openstage: what you're building, project by project" %>
<% content_for :meta_description, "Connect GitHub once. Openstage keeps a public page of your projects: what each one is, how its commits move, and what shipped. Free for indie builders." %>
<% content_for :main_class, "os-wrap os-stack pt-1.5" %>

<%
  # Four questions, each one an objection a builder has before signing in.
  # The FAQPage JSON-LD below mirrors these, so the markup matches visible text.
  faqs = [
    { q: "What is Openstage?",
      a: "A public page of what you're building, project by project, kept current from GitHub. Each project shows what it is, how its commits move over time and what shipped. It is for indie and side-project builders who want their work seen without a second job." },
    { q: "What does it read from GitHub?",
      a: "Sign-in asks only for your email address. Public repos you push to sync every 2 hours, with the description, website and preview image you set on each. Private repos stay out unless you connect them in Settings and include each one, and even then only commit messages and release names appear, never links to the code." },
    { q: "Does it post for me?",
      a: "No. Openstage never posts, ranks or rewrites anything for you. Share your page wherever you like; it keeps itself current." },
    { q: "What does it cost?",
      a: "Your page, a page for each project, the sync and a subscribe box are free for good. Pro is $7 a month and adds your subscriber list, profile analytics, private entries and pins." }
  ]
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org",
      "@type" => "SoftwareApplication",
      "name" => "Openstage",
      "applicationCategory" => "DeveloperApplication",
      "operatingSystem" => "Web",
      "url" => root_url,
      "description" => SeoHelper::DEFAULT_DESCRIPTION,
      "offers" => [
        { "@type" => "Offer", "name" => "Free", "price" => "0", "priceCurrency" => "USD" },
        { "@type" => "Offer", "name" => "Pro Monthly", "price" => "7", "priceCurrency" => "USD" }
      ]
    }.to_json.html_safe %>
  </script>
  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org",
      "@type" => "FAQPage",
      "mainEntity" => faqs.map { |f|
        {
          "@type" => "Question",
          "name" => f[:q],
          "acceptedAnswer" => { "@type" => "Answer", "text" => f[:a] }
        }
      }
    }.to_json.html_safe %>
  </script>
<% end %>

<section class="os-panel p-6 sm:p-[52px]">
  <div class="os-grid2 items-center gap-9">
    <div>
      <span class="os-tag">For indie and side-project builders</span>
      <h1 class="os-h1 mt-4.5">Keep shipping.<br>Openstage does the showing.</h1>
      <p class="os-p mt-4 text-lg">Openstage keeps a public page of everything you're building, project by project. It stays current from your GitHub commits while you work.</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-4.5 gap-y-3">
        <% if user_signed_in? %>
          <%= link_to "Go to your dashboard", dashboard_path, class: "os-btn" %>
        <% else %>
          <%= button_to "/auth/github", method: :post, data: { turbo: false }, class: "os-btn" do %>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>Start free with GitHub</span>
          <% end %>
        <% end %>
        <% if @demo_user %>
          <%= link_to "See a live page →", profile_path(@demo_user.username), class: "os-link" %>
        <% end %>
      </div>
      <p class="os-note mt-3.5">Public repos sync on their own. Private ones only if you add them. Nothing is ever posted for you.</p>
    </div>

    <% if @demo %>
      <%= render "home/demo", user: @demo_user, section: @demo, chart: ProgressChart::Trend.new(@demo) %>
    <% end %>
  </div>
</section>

<%= render "home/lately", entries: @lately if @lately.any? %>

<section class="os-panel" aria-labelledby="how">
  <h2 id="how" class="os-h2">How it works</h2>
  <p class="os-p mt-1.5">One sign-in and the page fills itself. The rest is optional.</p>
  <ol class="os-grid2 mt-4.5">
    <% [ [ "Connect GitHub once", "Your public repos sync every 2 hours. Private ones join only if you add them in Settings. Nothing to install." ],
         [ "Every project gets its line", "Your page charts each project's commits over 30 days, 90 days or 12 months. Visitors see what you work on now and what came before, all together or one project at a time." ],
         [ "What each project is", "Its description, website and picture come from GitHub, or from its README when GitHub has none. Fill any gap once, from your dashboard." ],
         [ "Launches stand out", "Log a launch or a post in one line. It shows under What shipped, on your page and on the project's own page." ] ].each_with_index do |(title, about), i| %>
      <li class="os-card">
        <div class="os-num text-[28px] text-ink-3"><%= format("%02d", i + 1) %></div>
        <h3 class="os-h3 mt-1.5"><%= title %></h3>
        <p class="os-p mt-1.5 text-[15px]"><%= about %></p>
      </li>
    <% end %>
  </ol>
</section>

<%# FAQ: the visible text mirrors the FAQPage schema above. Native <details>
    collapse without JS and stay keyboard- and screen-reader-correct. %>
<section class="os-panel" aria-labelledby="faq">
  <h2 id="faq" class="os-h2">Frequently asked questions</h2>
  <div class="mt-2.5">
    <% faqs.each_with_index do |f, i| %>
      <details class="os-row group py-4" <%= "open" if i.zero? %>>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-3 [&::-webkit-details-marker]:hidden">
          <h3 class="os-h3"><%= f[:q] %></h3>
          <svg class="mt-1 h-4 w-4 shrink-0 text-ink-3 transition-transform group-open:rotate-90"
               fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </summary>
        <p class="os-p mt-1.5 text-[15px]"><%= f[:a] %></p>
      </details>
    <% end %>
  </div>
</section>

<section class="os-panel p-7 text-center sm:p-14">
  <h2 class="os-h1 text-[clamp(30px,4vw,46px)]">Your commits already tell the story.</h2>
  <p class="os-p mt-2.5 text-lg">Give them a page. Free, and it fills itself.</p>
  <div class="mt-5.5 flex flex-wrap items-center justify-center gap-x-4.5 gap-y-3">
    <% if user_signed_in? %>
      <%= link_to "Go to your dashboard", dashboard_path, class: "os-btn" %>
    <% else %>
      <%= button_to "Start free with GitHub", "/auth/github", method: :post, data: { turbo: false }, class: "os-btn" %>
    <% end %>
    <%= link_to "Pro is $7 a month. See pricing", pricing_path, class: "os-link" %>
  </div>
</section>
