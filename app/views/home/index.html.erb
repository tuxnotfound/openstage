<div class="flex flex-col items-center justify-center text-center py-24 px-4">
  <h1 class="text-4xl font-bold text-gray-900 mb-3">Your build, in public. One link.</h1>
  <p class="text-lg text-gray-500 mb-8">GitHub commits, milestones, and notes — one chronological timeline, automatically updated.</p>

  <% unless user_signed_in? %>
    <%= button_to "/auth/github", method: :post, data: { turbo: false }, class: "inline-flex items-center gap-2 bg-gray-900 text-white px-6 py-3 rounded-lg text-sm font-medium hover:bg-gray-700 border-0 cursor-pointer" do %>
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      Sign in with GitHub
    <% end %>
  <% else %>
    <%= link_to "Go to Dashboard", dashboard_path, class: "inline-flex items-center gap-2 bg-gray-900 text-white px-6 py-3 rounded-lg text-sm font-medium hover:bg-gray-700" %>
  <% end %>

  <p class="mt-6 text-sm text-gray-400">
    See it live: <%= link_to "@tuxnotfound", "/tuxnotfound", class: "text-gray-600 underline hover:text-gray-900" %>
  </p>
</div>

<section class="max-w-3xl mx-auto px-4 pb-20" aria-label="Recent public activity">
  <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Live public feed</h2>
      <p class="text-sm text-gray-500 mt-0.5">Recent entries from builders across Openstage.</p>
    </div>
    <span class="text-xs text-gray-400 uppercase tracking-wide">20 per page</span>
  </div>

  <div class="flex flex-wrap gap-1.5 mb-4" aria-label="Entry type filters">
    <% [[nil, "All"], ["shipped", "Shipped"], ["milestone", "Milestone"], ["note", "Note"], ["link", "Link"], ["released", "Released"], ["posted", "Posted"]].each do |value, label| %>
      <% active = @type_filter == value %>
      <%= link_to label,
          root_path(type: value.presence),
          class: "px-2.5 py-1 rounded-full text-xs font-medium transition-colors #{active ? 'bg-gray-900 text-white' : 'bg-white border border-gray-200 text-gray-600 hover:text-gray-900 hover:border-gray-300'}" %>
    <% end %>
  </div>

  <% if @recent_entries.any? %>
    <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
      <% @recent_entries.each do |entry| %>
        <article class="px-4 py-3 border-b border-gray-100 last:border-0">
          <a href="<%= profile_path(entry.user.username) %>" class="block hover:bg-gray-50 -mx-2 px-2 py-1 rounded-lg transition-colors">
            <div class="flex items-start gap-3">
              <img src="<%= entry.user.avatar_url %>"
                   alt="<%= entry.user.display_name %>"
                   class="w-9 h-9 rounded-full ring-1 ring-gray-200 shrink-0" />

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                  <span class="font-medium text-gray-900">@<%= entry.user.username %></span>
                  <%= render "profiles/entry_badge", type: entry.entry_type, source: nil %>
                  <span class="text-gray-300">•</span>
                  <time datetime="<%= entry.occurred_at.iso8601 %>" class="text-gray-500"><%= time_ago_in_words(entry.occurred_at) %> ago</time>
                </div>
                <p class="mt-1 text-sm text-gray-700"><%= entry.title %></p>
              </div>
            </div>
          </a>
        </article>
      <% end %>
    </div>

    <div class="mt-4 flex items-center justify-between">
      <div>
        <% if @recent_entries.prev_page %>
          <%= link_to "Newer",
              root_path(page: @recent_entries.prev_page, type: @type_filter.presence),
              class: "text-sm text-gray-500 hover:text-gray-900 border border-gray-200 rounded-lg px-4 py-2 inline-block transition-colors" %>
        <% end %>
      </div>
      <div>
        <% if @recent_entries.next_page %>
          <%= link_to "Older",
              root_path(page: @recent_entries.next_page, type: @type_filter.presence),
              class: "text-sm text-gray-500 hover:text-gray-900 border border-gray-200 rounded-lg px-4 py-2 inline-block transition-colors" %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-gray-200 bg-white px-6 py-12 text-center">
      <p class="text-sm text-gray-500">No public activity yet.</p>
    </div>
  <% end %>
</section>
