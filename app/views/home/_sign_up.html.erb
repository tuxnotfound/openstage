<%# The landing's way in while previews are off: GitHub's sign-in leads, so a
    deploy before the token never loses it. class: its row's. %>
<div class="flex <%= local_assigns[:class] %>">
  <%= button_to "/auth/github", method: :post, data: { turbo: false, sign_up: true }, class: "os-btn" do %>
    <%= brand_icon(:github) %><span>Make your own stage</span>
  <% end %>
</div>
