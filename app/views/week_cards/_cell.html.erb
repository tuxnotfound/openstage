<%# One cell of the week card's extras panel, inside the card's SVG. %>
<% left = cell[:x] + 16 %>
<% inner = cell[:width] - 32 %>
<% data = cell[:data] %>
<% title = { goal: "NEXT WEEK", audience: "AUDIENCE", hours: "WHEN I BUILD", code: "CODE", repos: "ON GITHUB" }.fetch(cell[:kind]) %>
<text x="<%= left %>" y="492" <%= mono %> font-size="10" letter-spacing="1.2" fill="<%= t[:muted] %>"><%= title %></text>
<% if cell[:kind] == :goal %>
  <% card_wrap(data, inner, max_lines: 3, size: 16, weight: 700).each_with_index do |line, i| %>
    <text x="<%= left %>" y="<%= 514 + (i * 19) %>" <%= sans %> font-size="16" font-weight="700" fill="<%= t[:text] %>"><%= line %></text>
  <% end %>
<% elsif cell[:kind] == :audience %>
  <% if data.visitors.positive? %>
    <% delta = card.week_card.shows?("compare") ? card_delta(data.visitors, data.visitors_before, percent: true) : nil %>
    <text x="<%= left %>" y="514" <%= sans %> font-size="18" font-weight="700" fill="<%= t[:text] %>"><%= card_number(data.visitors) %><tspan dx="5" font-size="13" font-weight="500" fill="<%= t[:muted] %>"><%= "page visitor".pluralize(data.visitors) %></tspan><% if delta %><tspan dx="5" font-size="12" font-weight="500" fill="<%= t[delta.last] %>"><%= delta.first %></tspan><% end %></text>
  <% end %>
  <% if data.subscribers.positive? %>
    <text x="<%= left %>" y="<%= data.visitors.positive? ? 536 : 514 %>" <%= sans %> font-size="13" fill="<%= t[:muted] %>"><tspan font-weight="700" fill="<%= t[:text] %>"><%= card_number(data.subscribers) %></tspan><tspan dx="4"><%= "new subscriber".pluralize(data.subscribers) %></tspan></text>
  <% end %>
<% elsif cell[:kind] == :hours %>
  <% card_hour_bars(data, left, inner, t).each do |bar| %>
    <rect x="<%= bar[:x] %>" y="<%= 532 - bar[:height] %>" width="<%= bar[:width] %>" height="<%= bar[:height] %>" rx="1.5" fill="<%= bar[:color] %>"/>
  <% end %>
  <text x="<%= left %>" y="550" <%= sans %> font-size="12" fill="<%= t[:muted] %>">most commits<tspan dx="4" font-weight="600" fill="<%= t[:text] %>"><%= card_hour_label(data) %></tspan></text>
<% elsif cell[:kind] == :code %>
  <text x="<%= left %>" y="514" <%= sans %> font-size="16" font-weight="700"><tspan fill="<%= t[:up] %>">+<%= card_number(data.additions) %></tspan><tspan dx="5" fill="<%= t[:down] %>">−<%= card_number(data.deletions) %></tspan><tspan dx="5" font-size="12" font-weight="500" fill="<%= t[:muted] %>">lines</tspan></text>
  <% if data.languages.any? %>
    <clipPath id="wc-languages"><rect x="<%= left %>" y="522" width="<%= inner %>" height="6" rx="3"/></clipPath>
    <g clip-path="url(#wc-languages)">
      <% card_language_blocks(data.languages, left, inner, t).each do |block| %>
        <rect x="<%= block[:x] %>" y="522" width="<%= block[:width] %>" height="6" fill="<%= block[:color] %>"/>
      <% end %>
    </g>
    <text x="<%= left %>" y="545" <%= sans %> font-size="11" fill="<%= t[:muted] %>"><%= card_language_text(data.languages, inner) %></text>
  <% end %>
<% elsif cell[:kind] == :repos %>
  <% card_repo_items(data).each_with_index do |(number, label), i| %>
    <text x="<%= left + ((i % 2) * (inner / 2)) %>" y="<%= 514 + ((i / 2) * 20) %>" <%= sans %> font-size="13" fill="<%= t[:muted] %>"><tspan font-weight="700" fill="<%= t[:text] %>"><%= number %></tspan><tspan dx="4"><%= label %></tspan></text>
  <% end %>
<% end %>
