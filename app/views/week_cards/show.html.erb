<% content_for :title, "Your week" %>
<% content_for :head do %>
  <style>
    @font-face { font-family: 'IBM Plex Sans Condensed'; font-weight: 600; font-display: swap; src: url('<%= asset_path("ibm-plex-sans-condensed-600.woff2") %>') format('woff2'); }
    @font-face { font-family: 'IBM Plex Sans Condensed'; font-weight: 700; font-display: swap; src: url('<%= asset_path("ibm-plex-sans-condensed-700.woff2") %>') format('woff2'); }
    @font-face { font-family: 'IBM Plex Mono'; font-weight: 400; font-display: swap; src: url('<%= asset_path("ibm-plex-mono-400.woff2") %>') format('woff2'); }
    @font-face { font-family: 'IBM Plex Mono'; font-weight: 500; font-display: swap; src: url('<%= asset_path("ibm-plex-mono-500.woff2") %>') format('woff2'); }
  </style>
<% end %>
<% wc = @card.week_card %>
<% fonts = [
     { family: "IBM Plex Sans Condensed", weight: 600, url: asset_path("ibm-plex-sans-condensed-600.woff2") },
     { family: "IBM Plex Sans Condensed", weight: 700, url: asset_path("ibm-plex-sans-condensed-700.woff2") },
     { family: "IBM Plex Mono", weight: 400, url: asset_path("ibm-plex-mono-400.woff2") },
     { family: "IBM Plex Mono", weight: 500, url: asset_path("ibm-plex-mono-500.woff2") }
   ] %>
<% previous_week = wc.week_start - 7 %>
<% next_week = wc.week_start + 7 %>
<% field = "w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900" %>
<% legend = "text-xs font-semibold uppercase tracking-wide text-gray-500 px-1" %>

<div class="max-w-6xl mx-auto px-4 py-8"
     data-controller="card-editor card-export"
     data-card-editor-save-url-value="<%= week_card_path(wc) %>"
     data-card-editor-preview-url-value="<%= week_card_preview_path(wc) %>"
     data-card-editor-track-url-value="<%= recap_track_path %>"
     data-card-export-fonts-value="<%= fonts.to_json %>"
     data-card-export-filename-value="openstage-<%= wc.to_param.downcase %>.png"
     data-card-export-track-url-value="<%= recap_track_path %>">

  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold">Your week</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @card.label %> · <%= @card.dates %>. Pick what goes on your card, say what mattered each day, then post it with the card.</p>
    </div>
    <nav class="flex items-center gap-2 text-sm" aria-label="Weeks">
      <%= link_to "‹ Week #{previous_week.cweek}", week_card_path(WeekCard.param_for(previous_week)), class: "px-3 py-2 rounded-lg border border-gray-200 bg-white hover:border-gray-400" %>
      <span class="px-3 py-2 rounded-lg bg-gray-900 text-white"><%= @card.label %></span>
      <% if next_week <= Date.current %>
        <%= link_to "Week #{next_week.cweek} ›", week_card_path(WeekCard.param_for(next_week)), class: "px-3 py-2 rounded-lg border border-gray-200 bg-white hover:border-gray-400" %>
      <% end %>
    </nav>
  </div>

  <%= form_with model: wc, scope: :week_card, url: week_card_path(wc), method: :patch,
        class: "grid gap-6 lg:grid-cols-[19rem_minmax(0,1fr)] items-start",
        data: { card_editor_target: "form", action: "input->card-editor#queue change->card-editor#queue submit->card-editor#save" } do %>

    <div class="space-y-5">
      <fieldset class="rounded-xl border border-gray-200 bg-white px-5 pt-3 pb-4">
        <legend class="<%= legend %>">Days</legend>
        <% [ [ "week", "All seven days" ], [ "active", "Only the days I worked" ] ].each do |value, label| %>
          <label class="flex items-center gap-3 min-h-10 text-sm cursor-pointer">
            <%= radio_button_tag "week_card[layout]", value, wc.layout == value, class: "text-gray-900 focus:ring-gray-900" %>
            <%= label %>
          </label>
        <% end %>
      </fieldset>

      <fieldset class="rounded-xl border border-gray-200 bg-white px-5 pt-3 pb-4">
        <legend class="<%= legend %>">On the card</legend>
        <% { "avatar" => "Profile picture", "name" => "Name and Pro badge", "github" => "GitHub handle", "streak" => "Streak",
             "totals" => "Week totals", "projects" => "Commits per project", "headlines" => "Day headlines" }.each do |section, label| %>
          <label class="flex items-center gap-3 min-h-10 text-sm cursor-pointer">
            <%= hidden_field_tag "week_card[sections][#{section}]", "0", id: nil %>
            <%= check_box_tag "week_card[sections][#{section}]", "1", wc.shows?(section), id: "section_#{section}", class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
            <%= label %>
          </label>
        <% end %>
      </fieldset>

      <fieldset class="rounded-xl border border-gray-200 bg-white px-5 pt-3 pb-4">
        <legend class="<%= legend %>">Projects</legend>
        <% if @card.projects.empty? %>
          <p class="text-sm text-gray-500 py-2">No commits this week.</p>
        <% end %>
        <% @card.projects.each_with_index do |project, i| %>
          <label class="flex items-center gap-3 min-h-10 text-sm cursor-pointer">
            <%= hidden_field_tag "week_card[projects][#{project.name}]", "0", id: nil %>
            <%= check_box_tag "week_card[projects][#{project.name}]", "1", project.shown, id: "project_#{i}", class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
            <span class="flex-1 min-w-0 truncate"><%= project.name %></span>
            <span class="text-gray-400 tabular-nums"><%= pluralize(project.n, "commit") %></span>
          </label>
        <% end %>
        <p class="text-xs text-gray-400 mt-2">Private repos you include in <%= link_to "Settings", settings_path(tab: "integrations"), class: "underline" %> show here by name.</p>
      </fieldset>

      <p class="text-xs text-gray-400 px-1">Want the old list of commits? <%= link_to "Open the commit picker", recap_path, class: "underline" %>.</p>
    </div>

    <div class="space-y-5 min-w-0">
      <section class="rounded-xl border border-gray-200 bg-white p-4" aria-label="Card preview">
        <%= render "week_cards/preview", card: @card %>
      </section>

      <section class="rounded-xl border border-gray-200 bg-white px-5 py-4">
        <h2 class="text-sm font-semibold">What mattered each day</h2>
        <p class="text-xs text-gray-500 mt-1">In your own words, up to <%= WeekCard::HEADLINE_LENGTH %> characters. Left empty, the card shows what you shipped or posted that day, or the day's commit count.</p>
        <div class="mt-3">
          <% @card.days.each do |day| %>
            <% written = wc.headline_on(day.date) %>
            <% shown = day.headline %>
            <% input_id = "headline_#{day.date.iso8601}" %>
            <div class="py-3 border-t border-gray-100" data-controller="headline">
              <div class="flex flex-wrap items-center gap-3">
                <label for="<%= input_id %>" class="w-24 shrink-0 text-sm font-medium">
                  <%= day.date.strftime("%a %-d") %>
                  <span class="block text-xs font-normal text-gray-400"><%= day.total.positive? ? pluralize(day.total, "commit") : (day.active ? "no commits" : "quiet") %></span>
                </label>
                <%= text_field_tag "week_card[headlines][#{day.date.iso8601}][text]", written&.dig("text"),
                      id: input_id, maxlength: WeekCard::HEADLINE_LENGTH,
                      placeholder: shown && !written ? "Now on the card: #{shown.text}" : "What mattered this day?",
                      class: "#{field} flex-1 min-w-48", data: { headline_target: "input" } %>
                <%= select_tag "week_card[headlines][#{day.date.iso8601}][kind]",
                      options_for_select([ [ "Built", "built" ], [ "Shipped", "shipped" ], [ "Published", "published" ] ], written&.dig("kind") || shown&.kind || "built"),
                      id: nil, "aria-label": "What kind of thing it was on #{day.date.strftime('%A')}",
                      class: "rounded-lg border border-gray-200 px-2 py-2 text-sm" %>
              </div>
              <% if day.suggestions.any? %>
                <div class="mt-2 flex flex-wrap items-center gap-1.5 sm:pl-27">
                  <span class="text-xs text-gray-400">Start from:</span>
                  <% day.suggestions.each do |suggestion| %>
                    <button type="button" class="text-xs px-2 py-1 rounded-md border border-gray-200 text-gray-600 hover:border-gray-400 hover:text-gray-900"
                            data-action="headline#use" data-headline-text-param="<%= suggestion %>"><%= suggestion.truncate(48) %></button>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="rounded-xl border border-gray-200 bg-white px-5 py-4 space-y-3">
        <div class="flex items-baseline justify-between">
          <label for="post_text" class="text-sm font-semibold">Your post</label>
          <span class="text-xs text-gray-400 tabular-nums" data-card-editor-target="counter"></span>
        </div>
        <%= text_area_tag "week_card[post_text]", wc.post_text.presence || @card.draft, id: "post_text", rows: 6,
              class: "#{field} leading-relaxed", data: { card_editor_target: "post", action: "input->card-editor#count" } %>
        <p class="text-xs text-gray-500">Drafted from your card. Every word is yours to change. <button type="button" class="underline" data-action="card-editor#useDraft">Rebuild from the card</button></p>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="px-4 py-2.5 rounded-lg bg-gray-900 text-white text-sm font-medium hover:bg-gray-700" data-action="card-export#download" data-card-export-target="button">Download card</button>
          <a href="https://x.com/intent/post" target="_blank" rel="noopener" class="px-4 py-2.5 rounded-lg border border-gray-200 text-sm hover:border-gray-400"
             data-card-editor-target="intent" data-base="https://x.com/intent/post?text=" data-network="x" data-action="card-editor#intent">Post on X</a>
          <a href="https://bsky.app/intent/compose" target="_blank" rel="noopener" class="px-4 py-2.5 rounded-lg border border-gray-200 text-sm hover:border-gray-400"
             data-card-editor-target="intent" data-base="https://bsky.app/intent/compose?text=" data-network="bluesky" data-action="card-editor#intent">Post on Bluesky</a>
          <button type="button" class="px-4 py-2.5 rounded-lg border border-gray-200 text-sm hover:border-gray-400" data-action="card-editor#copy" data-card-editor-target="copyButton">Copy post</button>
        </div>
        <p class="text-xs text-gray-500">Download the card first: X and Bluesky open with your text, and you attach the card there. Their share links cannot carry an image.</p>
      </section>
    </div>
  <% end %>
</div>
