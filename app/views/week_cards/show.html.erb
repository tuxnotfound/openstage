<% content_for :title, "Your week" %>
<% content_for :main_class, "os-wrap pt-1.5" %>
<% content_for :dark_mode, true %>
<% fonts = card_fonts %>
<% content_for :head do %>
  <style>
    <% fonts.each do |font| %>
      @font-face { font-family: '<%= font[:family] %>'; font-style: <%= font[:style] %>; font-weight: <%= font[:weight] %>; font-display: swap; src: url('<%= font[:url] %>') format('woff2'); }
    <% end %>
  </style>
<% end %>
<% wc = @card.week_card %>
<% template = wc.template %>
<% sections = {
     "Who" => { "avatar" => "Picture", "name" => "Name and Pro", "github" => "GitHub handle",
                "building" => "Time building", "streak" => "Streak" },
     "The week" => { "totals" => "Totals", "compare" => "Change from last week",
                     "activity" => "Commits per day", "projects" => "Commits per project", "headlines" => "Your words" },
     "Around it" => { "goal" => "Next week's goal", "history" => "Earlier commits", "audience" => "Visitors and subscribers",
                      "hours" => "When you build", "code" => "Lines and languages", "repos" => "PRs, releases, stars" }
   } %>
<% previous_week = wc.week_start - 7 %>
<% next_week = wc.week_start + 7 %>
<% field = "os-field h-9 text-sm" %>
<%# A segmented control: the radios stay in the form, the labels are the pills. %>
<% segments = "os-pills" %>
<% segment = "os-pill cursor-pointer select-none max-sm:px-3 has-checked:bg-accent has-checked:text-on-accent has-focus-visible:outline-2 has-focus-visible:outline-accent" %>
<% legend = "os-label mb-1.5" %>
<% option = "flex min-w-0 cursor-pointer items-center gap-2 py-1 text-sm" %>
<% box = "size-4 shrink-0 accent-(--color-accent)" %>

<div data-controller="card-editor card-export"
     data-action="turbo:frame-load->card-editor#follow"
     data-card-editor-save-url-value="<%= week_card_path(wc) %>"
     data-card-editor-preview-url-value="<%= week_card_preview_path(wc) %>"
     data-card-editor-track-url-value="<%= events_path %>"
     data-card-export-fonts-value="<%= card_export_fonts.to_json %>"
     data-card-export-filename-value="openstage-<%= wc.to_param.downcase %>.png"
     data-card-export-track-url-value="<%= events_path %>">

  <div class="os-between mb-3.5">
    <div>
      <h1 class="os-h2 text-[30px]">Your week</h1>
      <p class="os-sm os-muted mt-0.5"><%= @card.label %> · <%= @card.dates %></p>
    </div>
    <nav class="flex gap-2" aria-label="Weeks">
      <%= link_to "‹ Week #{previous_week.cweek}", week_card_path(WeekCard.param_for(previous_week)), class: "os-btn2 sm" %>
      <% if next_week <= Date.current %>
        <%= link_to "Week #{next_week.cweek} ›", week_card_path(WeekCard.param_for(next_week)), class: "os-btn2 sm" %>
      <% end %>
    </nav>
  </div>

  <%= form_with model: wc, scope: :week_card, url: week_card_path(wc), method: :patch,
        data: { card_editor_target: "form", action: "input->card-editor#queue change->card-editor#queue submit->card-editor#save" } do %>
    <%= hidden_field_tag "week_card[time_zone]", wc.time_zone, id: nil, data: { card_editor_target: "zone" } %>

    <div class="flex flex-wrap items-start gap-4">
      <%# The card stays in view while the builder edits: pinned to the top on a phone. %>
      <div class="sticky top-0 z-10 min-w-0 flex-[999_1_600px] bg-ground pt-2 pb-3 lg:top-4 lg:bg-transparent lg:p-0">
        <section class="os-panel" aria-label="Card preview">
          <%= render "week_cards/preview", card: @card %>
          <div class="mt-3.5 flex flex-wrap items-center gap-2">
            <button type="button" class="os-btn" data-action="card-export#download" data-card-export-target="button">Download card</button>
            <span class="os-xs os-muted max-sm:hidden">Every change saves and redraws the card.</span>
          </div>
        </section>
      </div>

      <aside class="os-stack min-w-0 flex-[1_1_420px]">
        <section class="os-panel" aria-labelledby="card-settings">
          <h2 id="card-settings" class="os-h3">Card</h2>
          <fieldset class="mt-3 min-w-0">
            <legend class="<%= legend %>">Template</legend>
            <div class="<%= segments %>">
              <% WeekCardTemplate.all.each do |choice| %>
                <label class="<%= segment %>">
                  <%= radio_button_tag "week_card[style]", choice.key, choice == template, class: "sr-only", data: { action: "change->card-editor#filter" } %>
                  <%= choice.name %>
                </label>
              <% end %>
            </div>
          </fieldset>
          <% WeekCardTemplate.all.each do |choice| %>
            <%= tag.p(choice.description, class: "os-xs os-muted mt-2", **card_choice_attributes([ choice ], template)) %>
          <% end %>
          <fieldset class="mt-3 min-w-0">
            <legend class="<%= legend %>">Mode</legend>
            <div class="<%= segments %>">
              <% [ [ "light", "Light" ], [ "dark", "Dark" ] ].each do |value, label| %>
                <label class="<%= segment %>">
                  <%= radio_button_tag "week_card[theme]", value, wc.theme == value, class: "sr-only" %>
                  <%= label %>
                </label>
              <% end %>
            </div>
          </fieldset>
          <%= tag.fieldset(class: "mt-3 min-w-0", **card_choice_attributes(WeekCardTemplate.all.select(&:days_choice), template)) do %>
            <legend class="<%= legend %>">Days</legend>
            <div class="<%= segments %>">
              <% [ [ "week", "All days" ], [ "active", "Worked days" ] ].each do |value, label| %>
                <label class="<%= segment %>">
                  <%= radio_button_tag "week_card[layout]", value, wc.layout == value, class: "sr-only" %>
                  <%= label %>
                </label>
              <% end %>
            </div>
          <% end %>
        </section>

        <section class="os-panel" data-controller="tabs" aria-label="What the card says">
          <div class="os-pills" role="tablist">
            <% [ [ "words", "Your words" ], [ "parts", "On the card" ] ].each do |key, label| %>
              <button type="button" role="tab" class="os-pill data-[active=true]:bg-accent data-[active=true]:text-on-accent"
                      data-tabs-target="tab" data-tabs-tab="<%= key %>" data-action="tabs#show"><%= label %></button>
            <% end %>
          </div>

          <div class="mt-3" data-tabs-target="panel" data-tabs-panel="words" role="tabpanel">
            <p class="os-xs os-muted pb-1">What mattered each day, up to <%= WeekCard::HEADLINE_LENGTH %> characters. Start from a commit or post with the list button. Left empty, the card shows the day's work.</p>
            <% @card.days.each do |day| %>
              <% written = wc.headline_on(day.date) %>
              <% shown = day.headline %>
              <% input_id = "headline_#{day.date.iso8601}" %>
              <%# On a phone the day sits above its words; wider, beside them. %>
              <div class="os-row grid grid-cols-[minmax(0,1fr)_2.25rem_auto] items-center gap-x-2 gap-y-1 py-2 sm:grid-cols-[4rem_minmax(0,1fr)_2.25rem_auto]" data-controller="headline">
                <label for="<%= input_id %>" class="col-span-3 text-sm font-bold leading-tight sm:col-span-1">
                  <%= day.date.strftime("%a %-d") %>
                  <span class="os-muted text-[11px] font-normal sm:block"><%= day.total.positive? ? pluralize(day.total, "commit") : (day.active ? "no commits" : "quiet") %></span>
                </label>
                <%= text_field_tag "week_card[headlines][#{day.date.iso8601}][text]", written&.dig("text"),
                      id: input_id, maxlength: WeekCard::HEADLINE_LENGTH,
                      placeholder: shown && !written ? "Now on the card: #{shown.text}" : "What mattered this day?",
                      class: field, data: { headline_target: "input" } %>
                <% if day.suggestions.any? %>
                  <%# A list button: the menu sits over the icon, so the browser opens it at full width. %>
                  <span class="relative flex size-9 items-center justify-center rounded-control border border-line text-ink-3 hover:border-ink-3 hover:text-ink has-focus-visible:outline-2 has-focus-visible:outline-accent" title="Fill in from a commit or post">
                    <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2.5 4h7M2.5 8h7M2.5 12h4M12 9.5l1.5 1.5 1.5-1.5M13.5 4v7"/></svg>
                    <select class="absolute inset-0 w-full cursor-pointer opacity-0" aria-label="Fill <%= day.date.strftime('%A') %>'s words from one of its commits or posts" data-action="change->headline#pick">
                      <option value="">Fill in from a commit or post, then edit it…</option>
                      <% day.suggestions.each do |suggestion| %>
                        <option value="<%= suggestion %>"><%= suggestion.truncate(90) %></option>
                      <% end %>
                    </select>
                  </span>
                <% else %>
                  <span></span>
                <% end %>
                <%= select_tag "week_card[headlines][#{day.date.iso8601}][kind]",
                      options_for_select([ [ "Built", "built" ], [ "Shipped", "shipped" ], [ "Published", "published" ] ], written&.dig("kind") || shown&.kind || "built"),
                      id: nil, "aria-label": "What kind of thing it was on #{day.date.strftime('%A')}",
                      class: "os-field h-9 w-[92px] px-2 text-xs" %>
              </div>
            <% end %>
            <div class="os-row grid items-center gap-x-2 gap-y-1 py-2 sm:grid-cols-[4rem_minmax(0,1fr)]">
              <label for="next_goal" class="text-sm font-bold leading-tight">Goal <span class="os-muted text-[11px] font-normal sm:block">next week</span></label>
              <%= text_field_tag "week_card[next_goal]", wc.next_goal, id: "next_goal", maxlength: WeekCard::GOAL_LENGTH,
                    placeholder: "One thing, up to #{WeekCard::GOAL_LENGTH} characters. It ends your post too.", class: field %>
            </div>
          </div>

          <div class="mt-3 hidden space-y-3" data-tabs-target="panel" data-tabs-panel="parts" role="tabpanel">
            <% sections.each do |group, choices| %>
              <%= tag.div(**card_choice_attributes(WeekCardTemplate.having(*choices.keys), template)) do %>
                <p class="os-label"><%= group %></p>
                <div class="grid grid-cols-2 gap-x-4">
                  <% choices.each do |section, label| %>
                    <%= tag.label(class: option, **card_choice_attributes(WeekCardTemplate.having(section), template)) do %>
                      <%= hidden_field_tag "week_card[sections][#{section}]", "0", id: nil %>
                      <%= check_box_tag "week_card[sections][#{section}]", "1", wc.shows?(section), id: "section_#{section}", class: box %>
                      <%= label %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            <% end %>
            <div>
              <p class="os-label">Projects</p>
              <% if @card.projects.empty? %>
                <p class="os-sm os-muted py-1">No commits this week.</p>
              <% end %>
              <div class="grid grid-cols-2 gap-x-4">
                <% @card.projects.each_with_index do |project, i| %>
                  <label class="<%= option %>">
                    <%= hidden_field_tag "week_card[projects][#{project.name}]", "0", id: nil %>
                    <%= check_box_tag "week_card[projects][#{project.name}]", "1", project.shown, id: "project_#{i}", class: box %>
                    <span class="truncate"><%= project.name %></span>
                    <span class="os-muted ml-auto tabular-nums"><%= project.n %></span>
                  </label>
                <% end %>
              </div>
            </div>
            <p class="os-xs os-muted">A part with nothing to show this week stays off the card. Private repos you include in <%= link_to "Settings", settings_path(tab: "integrations"), class: "underline" %> show here by name.</p>
          </div>
        </section>

        <section class="os-panel" aria-labelledby="your-post">
          <div class="os-between">
            <label id="your-post" for="post_text" class="os-h3">Your post</label>
            <span class="os-xs os-muted tabular-nums" data-card-editor-target="counter"></span>
          </div>
          <%= text_area_tag "week_card[post_text]", wc.post_text.presence || @card.draft, id: "post_text", rows: 5,
                class: "os-area mt-2.5 text-sm", data: { card_editor_target: "post", action: "input->card-editor#count" } %>
          <div class="mt-2.5 flex flex-wrap items-center gap-2">
            <button type="button" class="os-btn sm" data-action="card-editor#copy" data-card-editor-target="copyButton">Copy post</button>
            <a href="https://x.com/intent/post" target="_blank" rel="noopener" class="os-btn2 sm"
               data-card-editor-target="intent" data-base="https://x.com/intent/post?text=" data-network="x" data-action="card-editor#intent">Post on X</a>
          </div>
          <p class="os-xs os-muted mt-2">Drafted from your card, it changes with the card until you edit it. <button type="button" class="underline" data-action="card-editor#useDraft">Rebuild from the card</button></p>
          <p class="os-xs os-muted mt-1">Post on X opens X with your text only: download the card and attach it there yourself.</p>
        </section>
      </aside>
    </div>
  <% end %>
</div>
