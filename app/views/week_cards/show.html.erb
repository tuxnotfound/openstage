<% content_for :title, "Your week" %>
<% fonts = card_fonts %>
<% content_for :head do %>
  <style>
    <% fonts.each do |font| %>
      @font-face { font-family: '<%= font[:family] %>'; font-style: <%= font[:style] %>; font-weight: <%= font[:weight] %>; font-display: swap; src: url('<%= font[:url] %>') format('woff2'); }
    <% end %>
  </style>
<% end %>
<% wc = @card.week_card %>
<% template = wc.template %>
<% sections = {
     "Who" => { "avatar" => "Profile picture", "name" => "Name and Pro badge", "github" => "GitHub handle",
                "building" => "How long you have been building", "streak" => "Streak and best run" },
     "The week" => { "totals" => "Week totals", "compare" => "Change from last week",
                     "activity" => "Commits per day", "projects" => "Commits per project", "headlines" => "Day headlines" },
     "Around it" => { "goal" => "Next week's goal", "history" => "Your earlier commits", "audience" => "Visitors and new subscribers",
                      "hours" => "When you build", "code" => "Lines and languages", "repos" => "PRs, releases, deploys and stars" }
   } %>
<% previous_week = wc.week_start - 7 %>
<% next_week = wc.week_start + 7 %>
<% field = "w-full rounded-lg border border-gray-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900" %>
<% legend = "text-xs font-semibold uppercase tracking-wide text-gray-500 px-1" %>

<div class="max-w-6xl mx-auto px-4 py-8"
     data-controller="card-editor card-export"
     data-card-editor-save-url-value="<%= week_card_path(wc) %>"
     data-card-editor-preview-url-value="<%= week_card_preview_path(wc) %>"
     data-card-editor-track-url-value="<%= recap_track_path %>"
     data-card-export-fonts-value="<%= card_export_fonts.to_json %>"
     data-card-export-filename-value="openstage-<%= wc.to_param.downcase %>.png"
     data-card-export-track-url-value="<%= recap_track_path %>">

  <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold">Your week</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @card.label %> · <%= @card.dates %>. Pick what goes on your card, say what mattered each day, then post it with the card.</p>
    </div>
    <nav class="flex items-center gap-2 text-sm" aria-label="Weeks">
      <%= link_to "‹ Week #{previous_week.cweek}", week_card_path(WeekCard.param_for(previous_week)), class: "px-3 py-2 rounded-lg border border-gray-200 bg-white hover:border-gray-400" %>
      <span class="px-3 py-2 rounded-lg bg-gray-900 text-white"><%= @card.label %></span>
      <% if next_week <= Date.current %>
        <%= link_to "Week #{next_week.cweek} ›", week_card_path(WeekCard.param_for(next_week)), class: "px-3 py-2 rounded-lg border border-gray-200 bg-white hover:border-gray-400" %>
      <% end %>
    </nav>
  </div>

  <%= form_with model: wc, scope: :week_card, url: week_card_path(wc), method: :patch,
        class: "grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-start",
        data: { card_editor_target: "form", action: "input->card-editor#queue change->card-editor#queue submit->card-editor#save" } do %>

    <div class="sticky top-0 z-10 -mx-4 bg-white px-4 pb-3 pt-2 lg:top-4 lg:order-last lg:mx-0 lg:px-0 lg:pb-0 lg:pt-0 min-w-0">
      <section class="rounded-xl border border-gray-200 bg-white p-3 lg:p-4" aria-label="Card preview">
        <%= render "week_cards/preview", card: @card %>
      </section>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button type="button" class="px-4 py-2.5 rounded-lg bg-gray-900 text-white text-sm font-medium hover:bg-gray-700" data-action="card-export#download" data-card-export-target="button">Download card</button>
        <p class="text-xs text-gray-500">Every change saves and redraws the card.</p>
      </div>
    </div>

    <div class="space-y-5 min-w-0">
      <%= hidden_field_tag "week_card[time_zone]", wc.time_zone, id: nil, data: { card_editor_target: "zone" } %>
      <fieldset class="rounded-xl border border-gray-200 bg-white px-5 pt-3 pb-4">
        <legend class="<%= legend %>">Template</legend>
        <div class="space-y-2 pt-1">
          <% WeekCardTemplate.all.each do |choice| %>
            <label class="flex items-start gap-3 rounded-lg border border-gray-200 px-3 py-2.5 cursor-pointer hover:border-gray-400 has-[:checked]:border-gray-900 has-[:checked]:bg-gray-50">
              <%= radio_button_tag "week_card[style]", choice.key, choice == template, class: "mt-0.5 text-gray-900 focus:ring-gray-900",
                    data: { action: "change->card-editor#filter" } %>
              <span>
                <span class="block text-sm font-medium"><%= choice.name %></span>
                <span class="block text-xs text-gray-500 mt-0.5"><%= choice.description %></span>
              </span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="grid gap-5 sm:grid-cols-2">
        <fieldset class="rounded-xl border border-gray-200 bg-white px-5 pt-3 pb-4">
          <legend class="<%= legend %>">Look</legend>
          <% [ [ "light", "Light" ], [ "dark", "Dark" ] ].each do |value, label| %>
            <label class="flex items-center gap-3 min-h-10 text-sm cursor-pointer">
              <%= radio_button_tag "week_card[theme]", value, wc.theme == value, class: "text-gray-900 focus:ring-gray-900" %>
              <%= label %>
            </label>
          <% end %>
        </fieldset>

        <%= tag.fieldset(class: "rounded-xl border border-gray-200 bg-white px-5 pt-3 pb-4",
              **card_choice_attributes(WeekCardTemplate.all.select(&:days_choice), template)) do %>
          <legend class="<%= legend %>">Days</legend>
          <% [ [ "week", "All seven days" ], [ "active", "Only the days I worked" ] ].each do |value, label| %>
            <label class="flex items-center gap-3 min-h-10 text-sm cursor-pointer">
              <%= radio_button_tag "week_card[layout]", value, wc.layout == value, class: "text-gray-900 focus:ring-gray-900" %>
              <%= label %>
            </label>
          <% end %>
        <% end %>
      </div>

      <fieldset class="rounded-xl border border-gray-200 bg-white px-5 pt-3 pb-4">
        <legend class="<%= legend %>">On the card</legend>
        <% sections.each do |group, choices| %>
          <%= tag.p(group, class: "text-xs text-gray-400 pt-2", **card_choice_attributes(WeekCardTemplate.having(*choices.keys), template)) %>
          <% choices.each do |section, label| %>
            <%= tag.label(class: "flex items-center gap-3 min-h-10 text-sm cursor-pointer", **card_choice_attributes(WeekCardTemplate.having(section), template)) do %>
              <%= hidden_field_tag "week_card[sections][#{section}]", "0", id: nil %>
              <%= check_box_tag "week_card[sections][#{section}]", "1", wc.shows?(section), id: "section_#{section}", class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
              <%= label %>
            <% end %>
          <% end %>
        <% end %>
        <p class="text-xs text-gray-400 mt-2">A part with nothing to show this week stays off the card.</p>
      </fieldset>

      <fieldset class="rounded-xl border border-gray-200 bg-white px-5 pt-3 pb-4">
        <legend class="<%= legend %>">Projects</legend>
        <% if @card.projects.empty? %>
          <p class="text-sm text-gray-500 py-2">No commits this week.</p>
        <% end %>
        <% @card.projects.each_with_index do |project, i| %>
          <label class="flex items-center gap-3 min-h-10 text-sm cursor-pointer">
            <%= hidden_field_tag "week_card[projects][#{project.name}]", "0", id: nil %>
            <%= check_box_tag "week_card[projects][#{project.name}]", "1", project.shown, id: "project_#{i}", class: "rounded border-gray-300 text-gray-900 focus:ring-gray-900" %>
            <span class="flex-1 min-w-0 truncate"><%= project.name %></span>
            <span class="text-gray-400 tabular-nums"><%= pluralize(project.n, "commit") %></span>
          </label>
        <% end %>
        <p class="text-xs text-gray-400 mt-2">Private repos you include in <%= link_to "Settings", settings_path(tab: "integrations"), class: "underline" %> show here by name.</p>
      </fieldset>

      <section class="rounded-xl border border-gray-200 bg-white px-5 py-4">
        <h2 class="text-sm font-semibold">What mattered each day</h2>
        <p class="text-xs text-gray-500 mt-1">In your own words, up to <%= WeekCard::HEADLINE_LENGTH %> characters, or pick one of the day's commits or posts to start from and edit it. Left empty, the card shows what you shipped or posted that day, or the day's commit count.</p>
        <div class="mt-3">
          <% @card.days.each do |day| %>
            <% written = wc.headline_on(day.date) %>
            <% shown = day.headline %>
            <% input_id = "headline_#{day.date.iso8601}" %>
            <%# A grid: on a phone the day sits above its words and kind; wider, beside them. %>
            <div class="grid grid-cols-[minmax(0,1fr)_auto] sm:grid-cols-[5.5rem_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2 py-3 border-t border-gray-100" data-controller="headline">
              <label for="<%= input_id %>" class="col-span-2 sm:col-span-1 text-sm font-medium">
                <%= day.date.strftime("%a %-d") %>
                <span class="sm:block text-xs font-normal text-gray-400"><%= day.total.positive? ? pluralize(day.total, "commit") : (day.active ? "no commits" : "quiet") %></span>
              </label>
              <%= text_field_tag "week_card[headlines][#{day.date.iso8601}][text]", written&.dig("text"),
                    id: input_id, maxlength: WeekCard::HEADLINE_LENGTH,
                    placeholder: shown && !written ? "Now on the card: #{shown.text}" : "What mattered this day?",
                    class: field, data: { headline_target: "input" } %>
              <%= select_tag "week_card[headlines][#{day.date.iso8601}][kind]",
                    options_for_select([ [ "Built", "built" ], [ "Shipped", "shipped" ], [ "Published", "published" ] ], written&.dig("kind") || shown&.kind || "built"),
                    id: nil, "aria-label": "What kind of thing it was on #{day.date.strftime('%A')}",
                    class: "rounded-lg border border-gray-200 px-2 py-2 text-sm" %>
              <% if day.suggestions.any? %>
                <select class="col-span-2 sm:col-start-2 w-full rounded-lg border border-gray-200 px-3 py-1.5 text-xs text-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-900"
                        aria-label="Fill <%= day.date.strftime('%A') %>'s words from one of its commits or posts" data-action="change->headline#pick">
                  <option value="">Fill in from a commit or post, then edit it…</option>
                  <% day.suggestions.each do |suggestion| %>
                    <option value="<%= suggestion %>"><%= suggestion.truncate(90) %></option>
                  <% end %>
                </select>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="rounded-xl border border-gray-200 bg-white px-5 py-4">
        <label for="next_goal" class="text-sm font-semibold">Next week's goal</label>
        <p class="text-xs text-gray-500 mt-1">One thing, up to <%= WeekCard::GOAL_LENGTH %> characters. It also ends your post's draft.</p>
        <%= text_field_tag "week_card[next_goal]", wc.next_goal, id: "next_goal", maxlength: WeekCard::GOAL_LENGTH,
              placeholder: "Launch on Product Hunt", class: "#{field} mt-3" %>
      </section>

      <section class="rounded-xl border border-gray-200 bg-white px-5 py-4 space-y-3">
        <div class="flex items-baseline justify-between">
          <label for="post_text" class="text-sm font-semibold">Your post</label>
          <span class="text-xs text-gray-400 tabular-nums" data-card-editor-target="counter"></span>
        </div>
        <%= text_area_tag "week_card[post_text]", wc.post_text.presence || @card.draft, id: "post_text", rows: 6,
              class: "#{field} leading-relaxed", data: { card_editor_target: "post", action: "input->card-editor#count" } %>
        <p class="text-xs text-gray-500">Drafted from your card. Every word is yours to change. <button type="button" class="underline" data-action="card-editor#useDraft">Rebuild from the card</button></p>
        <div class="flex flex-wrap gap-2">
          <a href="https://bsky.app/intent/compose" target="_blank" rel="noopener" class="px-4 py-2.5 rounded-lg border border-gray-200 text-sm hover:border-gray-400"
             data-card-editor-target="intent" data-base="https://bsky.app/intent/compose?text=" data-network="bluesky" data-action="card-editor#intent">Post on Bluesky</a>
          <button type="button" class="px-4 py-2.5 rounded-lg bg-gray-900 text-white text-sm font-medium hover:bg-gray-700" data-action="card-editor#copy" data-card-editor-target="copyButton">Copy post</button>
        </div>
        <p class="text-xs text-gray-500">Download the card, copy your post, and attach the card where you post it: no share link can carry an image.</p>
      </section>
      <p class="text-xs text-gray-400 px-1">Want the old list of commits? <%= link_to "Open the commit picker", recap_path, class: "underline" %>.</p>
    </div>
  <% end %>
</div>
