<%# The Pixel Stage card, 1200x630. CardLayout::PixelStage builds the level on
    a 4px grid: its layers, back to front, one path per colour, and its texts,
    each with its hard drop shadow drawn first. %>
<% stage = CardLayout::PixelStage.new(card) %>
<% num = CardLayout::Shapes.method(:num) %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630" role="img" aria-label="<%= card.label %> card for <%= card.user.display_name %>" data-week-card="pixel_stage">
  <defs>
    <style><%= card_face_css(card.week_card.template) %>.cf-press-start,.cf-pixelify-medium,.cf-pixelify-semibold{font-kerning:none;font-variant-ligatures:none;font-synthesis:none}</style>
  </defs>
  <rect width="1200" height="630" fill="<%= stage.sky[:bands].first %>"/>
  <g shape-rendering="crispEdges">
    <% stage.layers.each do |d, fill, opacity| %>
      <path d="<%= d %>" fill="<%= fill %>"<%= %( fill-opacity="#{opacity}").html_safe unless opacity == 1 %>/>
    <% end %>
  </g>
  <% if stage.shows?("avatar") && card.user.avatar_url.present? %>
    <image href="<%= card.user.avatar_url %>" x="20" y="16" width="76" height="76" preserveAspectRatio="xMidYMid slice"/>
  <% end %>
  <% stage.texts.each do |text| %>
    <% x, anchor = stage.anchor(text) %>
    <% y = stage.baseline(text) %>
    <% if text.shadow %>
      <%= tag.text(text.text, x: num.call(x + text.shadow.first), y: num.call(y + text.shadow.first), class: card_face_class(text.face), "font-size": text.size, fill: text.shadow.last, "text-anchor": (anchor unless anchor == "start")) %>
    <% end %>
    <%= tag.text(text.text, x: num.call(x), y: num.call(y), class: card_face_class(text.face), "font-size": text.size, fill: text.color, "text-anchor": (anchor unless anchor == "start")) %>
  <% end %>
</svg>
