<%# The Changelog card, 1200x630. CardLayout::Changelog measures and places
    every line, since SVG cannot flow text; this writes what it drew, in its
    order. Text stays on one line inside each <text>: a line break there would
    print as a space. %>
<% layout = CardLayout::Changelog.new(card) %>
<% t = layout.palette %>
<% avatar = layout.avatar %>
<% num = CardLayout::Shapes.method(:num) %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630" role="img" aria-label="<%= card.label %> card for <%= card.user.display_name %>" data-week-card="changelog">
  <defs>
    <style><%= card_face_css(card.week_card.template) %></style>
    <% if avatar %>
      <clipPath id="changelog-avatar"><circle cx="<%= avatar[:x] + 23 %>" cy="<%= avatar[:y] + 23 %>" r="23"/></clipPath>
    <% end %>
  </defs>
  <rect width="1200" height="630" fill="<%= t[:bg] %>"/>
  <% layout.canvas.paths.each do |layer, d| %>
    <% if d.present? %><%= tag.path(d: d, **card_paint(CardLayout::Changelog::LAYERS.fetch(layer), t)) %><% end %>
  <% end %>
  <% if avatar %>
    <image href="<%= avatar[:url] %>" x="<%= avatar[:x] %>" y="<%= avatar[:y] %>" width="<%= avatar[:size] %>" height="<%= avatar[:size] %>" preserveAspectRatio="xMidYMid slice" clip-path="url(#changelog-avatar)"/>
    <circle cx="<%= avatar[:x] + 23 %>" cy="<%= avatar[:y] + 23 %>" r="22.5" fill="none" stroke="<%= t[:avatar_ring] %>"/>
  <% end %>
  <% layout.canvas.dots.each do |dot| %>
    <circle cx="<%= num.call(dot.cx) %>" cy="<%= num.call(dot.cy) %>" r="<%= num.call(dot.r) %>" fill="<%= dot.fill %>"/>
  <% end %>
  <% layout.canvas.icons.each do |icon| %>
    <svg x="<%= num.call(icon.x) %>" y="<%= num.call(icon.y) %>" width="<%= icon.size %>" height="<%= icon.size %>" viewBox="<%= icon.view_box %>"><path d="<%= icon.path %>" fill="<%= icon.fill %>" fill-rule="evenodd"/></svg>
  <% end %>
  <% layout.canvas.runs.each do |run| %>
    <%= card_run(run) %>
  <% end %>
</svg>
