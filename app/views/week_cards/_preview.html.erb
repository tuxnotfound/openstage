<%# The editor's preview. data-card-draft carries the post drafted from this
    exact card, for "Rebuild from the card". %>
<%= turbo_frame_tag "card_preview" do %>
  <div class="overflow-hidden rounded-card [&_svg]:block [&_svg]:h-auto [&_svg]:w-full" data-card-draft="<%= card.draft %>">
    <%= render card.week_card.template.partial, card: card %>
  </div>
<% end %>
