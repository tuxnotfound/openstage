<% content_for :title, "Pricing — Openstage" %>
<% content_for :main_class, "os-wrap os-stack pt-1.5" %>
<% content_for :meta_description, "Openstage is free forever: your page, a page for each project, and a subscribe box. Pro is $7 a month and adds your subscriber list, analytics, private entries and pins." %>

<%
  billing_faqs = [
    { q: "Is there really a free plan?",
      a: "Yes. Your public page, a page for each project, automatic GitHub sync, the subscribe box, the social preview card and the badge are free forever. Nothing that helps your page spread is behind the paywall." },
    { q: "What does Pro actually add?",
      a: "Your subscriber list: every address that confirmed on your page, with dates, yours to keep. Plus profile analytics, private entries, up to three pinned entries, and no Openstage link in your footer." },
    { q: "Can I cancel anytime?",
      a: "Yes. You can manage or cancel your subscription from your Settings at any time, and Pro access continues until the end of the billing period." },
    { q: "How do payments work?",
      a: "Payments are handled securely by Stripe. Openstage never sees or stores your card details." }
  ]
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= {
      "@context" => "https://schema.org",
      "@type" => "FAQPage",
      "mainEntity" => billing_faqs.map { |f|
        { "@type" => "Question", "name" => f[:q], "acceptedAnswer" => { "@type" => "Answer", "text" => f[:a] } }
      }
    }.to_json.html_safe %>
  </script>
<% end %>

<section class="os-panel p-6 sm:p-12">
  <h1 class="os-h1">Free forever. Pro is $7 a month.</h1>
  <p class="os-p mt-3 text-lg">Your page, its project pages, the sync and the subscribe box are free. Pro is for keeping the audience you build.</p>

  <div class="os-grid2 mt-7">
    <div class="os-card flex flex-col p-6">
      <h2 class="os-h2">Free</h2>
      <div class="mt-3 flex items-baseline gap-2.5"><span class="os-num text-[56px] leading-none">$0</span><span class="os-ink2">forever</span></div>
      <ul class="mt-3.5 flex-1">
        <% [ "Your proof-of-work page, synced from GitHub",
             "A page for each project, which visitors can follow by email",
             "A subscribe box on your page, and how many confirmed",
             "Milestones, notes, a progress chart, streak",
             "Social preview card, README badge, RSS" ].each do |item| %>
          <li class="os-row flex gap-2.5 py-2.5"><span aria-hidden="true" class="font-bold text-accent-ink">✓</span><span class="text-[15px] font-semibold"><%= item %></span></li>
        <% end %>
      </ul>
      <% if user_signed_in? %>
        <%= link_to "Go to dashboard", dashboard_path, class: "os-btn2 mt-4 w-full" %>
      <% else %>
        <%= button_to "Start free with GitHub", "/auth/github", method: :post, data: { turbo: false }, form: { class: "mt-4" }, class: "os-btn2 w-full" %>
      <% end %>
    </div>

    <div class="os-card flex flex-col border-2 border-strong p-6">
      <div class="os-between"><h2 class="os-h2">Pro</h2><span class="os-tag pro">✦ Pro</span></div>
      <div class="mt-3 flex items-baseline gap-2.5"><span class="os-num text-[56px] leading-none">$7</span><span class="os-ink2">a month, cancel any time</span></div>
      <ul class="mt-3.5 flex-1">
        <li class="os-row flex gap-2.5 py-2.5"><span aria-hidden="true" class="font-bold text-accent-ink">✓</span><span><span class="block text-[15px] font-semibold">Your subscriber list.</span><span class="os-xs os-muted">Every confirmed address, with dates. Yours to keep.</span></span></li>
        <% [ "Profile analytics: views, referrers, countries",
             "Private entries",
             "Pin up to 3 entries",
             "No Openstage link in your footer",
             "Everything in Free" ].each do |item| %>
          <li class="os-row flex gap-2.5 py-2.5"><span aria-hidden="true" class="font-bold text-accent-ink">✓</span><span class="text-[15px] font-semibold"><%= item %></span></li>
        <% end %>
      </ul>
      <div class="mt-4">
        <% if user_signed_in? && current_user.pro? %>
          <p class="os-card bg-accent-soft py-2.5 text-center font-bold text-accent-ink border-transparent">✦ You're on Pro</p>
          <% if current_user.stripe_customer_id.present? %>
            <%= link_to "Manage billing", billing_portal_path, data: { turbo: false }, class: "os-btn2 mt-2.5 w-full" %>
          <% end %>
        <% elsif user_signed_in? %>
          <%= button_to "Go Pro for $7 a month", checkout_path, method: :post, form: { data: { turbo: false } }, class: "os-btn w-full" %>
        <% else %>
          <%= button_to "Sign in to go Pro", "/auth/github", method: :post, data: { turbo: false }, class: "os-btn w-full" %>
          <p class="os-note mt-2 text-center">Sign in free first, then upgrade anytime.</p>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="os-panel" aria-labelledby="billing-faq">
  <h2 id="billing-faq" class="os-h2">Billing questions</h2>
  <div class="mt-2.5">
    <% billing_faqs.each do |f| %>
      <div class="os-row py-4">
        <h3 class="os-h3"><%= f[:q] %></h3>
        <p class="os-p mt-1.5 text-[15px]"><%= f[:a] %></p>
      </div>
    <% end %>
  </div>
</section>
