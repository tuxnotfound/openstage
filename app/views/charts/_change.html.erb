<%# A change's arrow and percent, as the pages write them: only the arrow
    wears the colour, and a screen reader hears its direction as a word
    rather than the arrow's shape. change: a ChartFilterSerializer's. %>
<span class="<%= chart_tone(change[:up]) %>" aria-hidden="true"><%= change[:arrow] %></span><% unless change[:up].nil? %><span class="sr-only"><%= change[:up] ? "up" : "down" %></span><% end %> <%= change[:text] %>
