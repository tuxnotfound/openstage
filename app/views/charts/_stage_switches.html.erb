<%# A project's switches for the builder's stage, in the dashboard's table
    and its list of projects: whether the stage shows it, an eye
    (charts/_eye), which GithubReposController switches, and its pin
    (charts/_pin), which Projects::PinsController switches; each sends the
    dashboard back. name: the project's; page, pin: the row's, either nil
    for none; fields: what each form sends beside its own, [name, value]
    pairs or a hash. %>
<% if page %>
  <%= form_with url: page[:path], method: :patch, class: "inline-flex align-middle", data: { turbo: false } do %>
    <%= hidden_field_tag :included, (!page[:on]).to_s, id: nil %>
    <% fields.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
    <button type="submit" role="switch" aria-checked="<%= page[:on] %>" aria-label="Show <%= name %> on your stage"
            title="<%= eye_title(page[:on]) %>" class="os-eye"><%= render "charts/eye" %></button>
  <% end %>
<% end %>
<% if pin %>
  <%= form_with url: pin[:path], method: :patch, class: "ml-1 inline-flex align-middle", data: { turbo: false } do %>
    <%= hidden_field_tag :pinned, (!pin[:on]).to_s, id: nil %>
    <% fields.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
    <%= tag.button render("charts/pin"), type: "submit", role: "switch", aria: { checked: pin[:on], label: "Pin #{name} to your stage" },
                                         title: pin[:title], class: "os-eye os-pin" %>
  <% end %>
<% end %>
