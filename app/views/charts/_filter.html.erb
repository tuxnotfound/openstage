<%# A chart filter's first paint, as the chart's script draws it (ProgressIsland)
    and as it reads without the script: the numbers and the window over the
    chart, the chart, and the projects' table under it. A builder's page and
    a project's share a row of numbers and window; the dashboard puts the
    window beside Your activity, adds each number's change, and its table is
    where the builder picks what visitors see.
    view: a ProgressViewSerializer's attributes; mode: "page", "project" or
    "dashboard"; path_for: the page's address for some params changed. %>
<% dashboard = mode == "dashboard" %>
<% if dashboard %>
  <div class="os-between">
    <h2 id="your-activity" class="os-h2">Your activity</h2>
    <%= render "charts/window", view: view, path_for: path_for %>
  </div>
  <div class="mt-5"><%= render "charts/toggles", view: view, path_for: path_for, changes: true %></div>
<% else %>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <%= render "charts/toggles", view: view, path_for: path_for %>
    <%= render "charts/window", view: view, path_for: path_for, css: "max-md:flex max-md:w-full max-md:justify-between" %>
  </div>
<% end %>
<%= render "charts/chart", view: view, height: ("h-[260px]" if dashboard) %>
<% if view[:table] %>
  <%= render "charts/table", view: view, path_for: path_for, manage: dashboard, back: local_assigns.fetch(:back, {}) %>
<% end %>
<% if dashboard %>
  <p class="os-note mt-2.5">The switches set what visitors see on your page and your project pages, and this chart follows them; the boxes and the numbers above the chart change this chart only.</p>
<% end %>
