<%# The numbers above the chart, a toggle each (charts/toggle). On analytics
    they sit in their groups, each named before its toggles (On GitHub, On
    your websites, On Openstage), and Openstage's own, which no project
    picks, fold behind "+ n more" unless one of them is drawn, as the chart's
    script folds them on the screens it measures, so the page holds still
    when the script takes over; without it, the button opens them in place.
    Every other toggle shows here, and the script folds what does not fit.
    view: a ChartFilterSerializer's attributes; path_for: the page's address
    for some params changed; changes: whether toggles carry their change;
    groups: whether they sit in their groups. %>
<% groups = local_assigns[:groups].present? %>
<% locals = { view: view, path_for: path_for, changes: local_assigns[:changes], full: view[:drawn].size >= Progress::DrawService::MAX_DRAWN } %>
<% head, tail = groups ? view[:numbers].partition { |number| Progress::Numbers.find(number[:key]).picked } : [ view[:numbers], [] ] %>
<% open = tail.any? { |number| view[:drawn].include?(number[:key]) } %>
<% gaps = groups ? "gap-x-4 gap-y-2" : "gap-2" %>
<div class="min-w-0 flex-[1_1_480px]">
  <div class="flex min-w-0 flex-wrap items-center <%= gaps %>" role="group" aria-label="Numbers on the chart">
    <%= render "charts/toggle_groups", numbers: head, groups: groups, locals: locals %>
    <% if tail.any? && !open %>
      <details>
        <summary class="flex h-11 cursor-pointer list-none items-center rounded-control px-3 text-[13px] font-bold text-accent-ink [&::-webkit-details-marker]:hidden">+ <%= tail.size %> more</summary>
        <div class="mt-2.5 flex flex-wrap items-center <%= gaps %>" role="group" aria-label="More numbers">
          <%= render "charts/toggle_groups", numbers: tail, groups: groups, locals: locals %>
        </div>
      </details>
    <% end %>
  </div>
  <% if open %>
    <div class="mt-2.5 flex flex-wrap items-center <%= gaps %>" role="group" aria-label="More numbers">
      <%= render "charts/toggle_groups", numbers: tail, groups: groups, locals: locals %>
    </div>
  <% end %>
</div>
