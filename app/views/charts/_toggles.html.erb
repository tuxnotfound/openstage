<%# The numbers above the chart, a toggle each (charts/toggle). On analytics
    they sit in their groups, each named before its toggles (On GitHub, On
    your websites, On Openstage). Every toggle shows here: the chart's script
    folds the ones that do not fit its row behind "+ n more".
    view: a ChartFilterSerializer's attributes; path_for: the page's address
    for some params changed; changes: whether toggles carry their change;
    groups: whether they sit in their groups. %>
<% locals = { view: view, path_for: path_for, changes: local_assigns[:changes], full: view[:drawn].size >= Progress::DrawService::MAX_DRAWN } %>
<div class="flex min-w-0 flex-[1_1_480px] flex-wrap items-center <%= local_assigns[:groups] ? 'gap-x-4 gap-y-2' : 'gap-2' %>" role="group" aria-label="Numbers on the chart">
  <% if local_assigns[:groups] %>
    <% view[:numbers].chunk_while { |one, other| one[:group] == other[:group] }.each do |numbers| %>
      <div class="inline-flex min-w-0 flex-wrap items-center gap-2" role="group" aria-label="<%= numbers.first[:group] %>">
        <span class="pr-0.5 text-xs font-bold whitespace-nowrap text-ink-3" aria-hidden="true"><%= numbers.first[:group] %></span>
        <%= render partial: "charts/toggle", collection: numbers, as: :number, locals: locals %>
      </div>
    <% end %>
  <% else %>
    <%= render partial: "charts/toggle", collection: view[:numbers], as: :number, locals: locals %>
  <% end %>
</div>
