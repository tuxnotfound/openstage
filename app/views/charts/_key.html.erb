<%# A number's line as a short sample, in a toggle, a column's head or the
    tooltip's: solid, dotted or dashed by its place in the line order. %>
<svg class="<%= local_assigns[:css] || 'h-1.5 w-[22px]' %> flex-none overflow-visible" viewBox="0 0 22 6" aria-hidden="true">
  <line x1="3" y1="3" x2="19" y2="3" stroke="currentColor" stroke-width="3" stroke-linecap="round"<%= %( stroke-dasharray="#{ChartFilterHelper::KEY_DASHES[line]}").html_safe if ChartFilterHelper::KEY_DASHES[line] %>/>
</svg>
