<%# A run of number toggles (charts/toggle), each group named before its own
    where the page groups them (On GitHub, On your websites, On Openstage).
    numbers: some of a ChartFilterSerializer's numbers; groups: whether they
    sit in their groups; locals: charts/toggle's. %>
<% if groups %>
  <% numbers.chunk_while { |one, other| one[:group] == other[:group] }.each do |run| %>
    <div class="inline-flex min-w-0 flex-wrap items-center gap-2" role="group" aria-label="<%= run.first[:group] %>">
      <span class="pr-0.5 text-xs font-bold whitespace-nowrap text-ink-3" aria-hidden="true"><%= run.first[:group] %></span>
      <%= render partial: "charts/toggle", collection: run, as: :number, locals: locals %>
    </div>
  <% end %>
<% else %>
  <%= render partial: "charts/toggle", collection: numbers, as: :number, locals: locals %>
<% end %>
