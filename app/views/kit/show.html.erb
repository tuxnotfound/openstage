<% content_for :main_class, "os-wrap os-stack pt-1.5" %>
<% content_for :title, "Kit" %>

<section class="os-panel">
  <h1 class="os-h1">Kit</h1>
  <p class="os-p mt-3 max-w-[640px]">Spectrum's tokens and components, as the drafts drew them. Switch light and dark in the header. Sample numbers, not anyone's data.</p>
</section>

<section class="os-panel">
  <h2 class="os-h2">Colours</h2>
  <div class="os-grid3 mt-4">
    <% [ %w[ground surface fill line], %w[ink ink-2 ink-3 strong], %w[accent accent-soft accent-ink on-accent], %w[up down down-soft danger warn] ].each do |group| %>
      <div class="os-card">
        <% group.each do |token| %>
          <div class="flex items-center gap-3 py-1.5">
            <span class="size-8 shrink-0 rounded-[10px] border border-line" style="background: var(--color-<%= token %>)"></span>
            <span class="os-sm"><%= token %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <p class="os-label mt-6">Projects, by all-time commit order</p>
  <div class="mt-2 flex flex-wrap gap-2">
    <% (1..ProgressChart::Palette::PROJECT_COLORS[:light].size).each do |n| %>
      <span class="os-disc size-9 text-[13px]" style="background: var(--color-project-<%= n %>); color: var(--color-on-project-<%= n %>)"><%= n %></span>
    <% end %>
  </div>
</section>

<section class="os-panel">
  <h2 class="os-h2">Type</h2>
  <div class="mt-4 os-stack">
    <p class="os-h1">Keep shipping.</p>
    <p class="os-h2">What shipped</p>
    <p class="os-h3">wheels-off</p>
    <div class="flex flex-wrap items-baseline gap-x-[22px] gap-y-1.5">
      <span class="os-num os-big">306</span>
      <span class="text-lg font-semibold text-ink-2"><span class="text-up">▲</span> 130% vs the previous 90 days</span>
    </div>
    <p class="os-label">Commits · all 7 projects, last 90 days</p>
    <p class="os-p">Body copy in Funnel Sans: what a builder is building, and how each project is doing.</p>
    <p class="os-note">A note under a field, 13 px in the third ink.</p>
    <p><a href="#" class="os-link">Project page →</a></p>
  </div>
</section>

<div class="os-grid2">
  <section class="os-panel">
    <h2 class="os-h2">Buttons</h2>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <button type="button" class="os-btn">Subscribe</button>
      <button type="button" class="os-btn2">View page</button>
      <button type="button" class="os-btn sm">Copy link</button>
      <button type="button" class="os-btn2 sm">Sync now</button>
      <button type="button" class="os-btn danger sm">Delete account</button>
      <button type="button" class="os-btn sm" disabled>Saving</button>
    </div>
    <h2 class="os-h2 mt-8">Marks</h2>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="os-tag pro">✦ Pro</span>
      <span class="os-tag soft">Live</span>
      <span class="os-tag">Archived</span>
      <span class="os-missing">No website</span>
      <span class="os-avatar">T</span>
      <span class="os-avatar size-[34px] text-sm">T</span>
    </div>
  </section>

  <section class="os-panel">
    <h2 class="os-h2">Toggles, tabs and filters</h2>
    <div class="mt-4 os-stack">
      <div class="os-pills" role="group" aria-label="Time range">
        <button type="button" class="os-pill">30 days</button>
        <button type="button" class="os-pill" aria-pressed="true">90 days</button>
        <button type="button" class="os-pill">12 months</button>
        <button type="button" class="os-pill">All time</button>
      </div>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Projects">
        <button type="button" class="os-chip" aria-pressed="true">All projects</button>
        <button type="button" class="os-chip" style="background: var(--color-project-1); border-color: var(--color-project-1); color: var(--color-on-project-1)"><span class="os-dot bg-white/75"></span>openstage</button>
        <button type="button" class="os-chip" style="background: var(--color-project-2); border-color: var(--color-project-2); color: var(--color-on-project-2)"><span class="os-dot bg-black/35"></span>wheels-off</button>
        <button type="button" class="os-chip border-dashed"><span class="os-dot bg-line"></span>goal_atlas</button>
      </div>
      <label class="flex items-center gap-3">
        <input type="checkbox" class="os-switch" checked>
        <span class="os-sm">Show the shipped and published list</span>
      </label>
      <label class="flex items-center gap-3">
        <input type="checkbox" class="os-switch">
        <span class="os-sm">Hidden from your page</span>
      </label>
    </div>
  </section>
</div>

<section class="os-panel">
  <h2 class="os-h2">Fields</h2>
  <div class="os-grid2 mt-4">
    <div class="os-fieldset">
      <label class="os-label" for="kit-email">Get Tux's updates by email</label>
      <div class="flex gap-2">
        <input id="kit-email" class="os-field" type="email" placeholder="you@example.com">
        <button type="button" class="os-btn">Subscribe</button>
      </div>
      <p class="os-note">Double opt-in, one-click unsubscribe.</p>
    </div>
    <div class="os-fieldset">
      <label class="os-label" for="kit-detail">More detail (optional)</label>
      <textarea id="kit-detail" class="os-area" placeholder="What did you do?"></textarea>
    </div>
  </div>
  <pre class="os-code mt-4">[![Openstage](https://openstage.dev/badge/you.svg)](https://openstage.dev/you)</pre>
</section>

<section class="os-panel">
  <h2 class="os-h2">Chart</h2>
  <p class="os-label mt-4">Commits · 3 projects, last 90 days</p>
  <div class="mt-0.5 flex flex-wrap items-baseline gap-x-[22px] gap-y-1.5">
    <span class="os-num os-big">248</span>
    <span class="text-lg font-semibold text-ink-2"><span class="text-down">▼</span> 12% vs the previous 90 days</span>
  </div>
  <div class="os-sharebar mt-5" role="img" aria-label="Share of commits by project">
    <div class="bg-project-1" style="flex: 120 1 0"></div>
    <div class="bg-project-2" style="flex: 80 1 0"></div>
    <div class="bg-project-3" style="flex: 48 1 0"></div>
  </div>
  <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-[13px] text-ink-2">
    <span><span class="os-num font-bold text-ink">48%</span> openstage</span>
    <span><span class="os-num font-bold text-ink">32%</span> wheels-off</span>
    <span><span class="os-num font-bold text-ink">20%</span> goal_atlas</span>
  </div>
  <div class="os-chart mt-6" role="img" aria-label="Commits per week by project">
    <div class="os-gridline top-0"></div>
    <div class="os-gridline top-1/2"></div>
    <div class="os-axis"></div>
    <% [ [ "stroke-project-1", "M0 270 L166 240 L333 250 L500 180 L666 200 L833 90 L1000 30" ],
         [ "stroke-project-2", "M0 275 L166 270 L333 220 L500 230 L666 150 L833 170 L1000 120" ],
         [ "stroke-project-3", "M0 260 L166 200 L333 230 L500 262 L666 250 L833 240 L1000 255" ] ].each do |color, d| %>
      <svg viewBox="0 0 1000 280" preserveAspectRatio="none" aria-hidden="true"><path d="<%= d %>" fill="none" class="<%= color %>" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"></path></svg>
    <% end %>
    <div class="os-ylab top-1">40</div>
    <div class="os-ylab top-[calc(50%+4px)]">20</div>
    <span class="os-disc absolute -translate-x-1/2 -translate-y-1/2 bg-project-1 text-on-project-1" style="left: 83.3%; top: 32%">1</span>
    <span class="os-disc absolute -translate-x-1/2 -translate-y-1/2 bg-project-2 text-on-project-2" style="left: 66.6%; top: 53.5%">2</span>
  </div>
  <div class="os-xlabs"><span>Jul 27</span><span>Sep 7</span><span>Today</span></div>
</section>

<div class="os-grid3">
  <% [ [ "1", "openstage", "Build in public, beautifully." ], [ "2", "wheels-off", "A skateboarding game in an anime look." ], [ "3", "goal_atlas", nil ] ].each do |n, name, desc| %>
    <div class="os-card">
      <p class="os-h3 flex items-center gap-2"><span class="os-dot" style="background: var(--color-project-<%= n %>)"></span><%= name %></p>
      <% if desc %>
        <p class="os-p mt-1 text-[15px]"><%= desc %></p>
      <% else %>
        <p class="mt-2"><span class="os-missing">No description</span></p>
      <% end %>
      <div class="os-row os-rowflex mt-3"><span class="os-sm os-muted">Oct 21</span><span class="os-sm font-semibold">Last commit</span></div>
    </div>
  <% end %>
</div>
