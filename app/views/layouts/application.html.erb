<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= page_title %></title>
    <meta name="description" content="<%= meta_description %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta name="theme-color" content="#111827">

    <%# Icons %>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <%# Open Graph %>
    <meta property="og:site_name" content="Openstage">
    <meta property="og:type" content="<%= og_type %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= meta_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= og_image_for_page %>">

    <%# Twitter %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= meta_description %>">
    <meta name="twitter:image" content="<%= og_image_for_page %>">

    <%# Site-wide structured data (Organization + WebSite) %>
    <script type="application/ld+json"><%= site_structured_data.to_json.html_safe %></script>

    <%= yield :head %>
    <% if ENV["GOOGLE_SITE_VERIFICATION"].present? %>
      <meta name="google-site-verification" content="<%= ENV["GOOGLE_SITE_VERIFICATION"] %>" />
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <% if ENV["UMAMI_WEBSITE_ID"].present? %>
      <script defer src="https://cloud.umami.is/script.js" data-website-id="<%= ENV["UMAMI_WEBSITE_ID"] %>"></script>
    <% end %>
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <% unless content_for?(:minimal_page) %>
      <header class="border-b border-gray-200">
        <nav class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between gap-3">
          <%= link_to "Openstage", root_path, class: "font-semibold text-gray-900 shrink-0" %>

          <div class="flex items-center gap-0.5 sm:gap-2 text-sm">
            <% if user_signed_in? %>
              <%# Three places a builder goes: the work, the weekly post, the page
                  itself. Everything else is account plumbing in the menu. %>
              <%= nav_link "Dashboard", dashboard_path %>
              <%= nav_link "Recap", recap_path %>
              <%= nav_link "My page", profile_path(current_user.username) %>

              <details class="relative ml-1" data-controller="dropdown">
                <summary class="list-none [&::-webkit-details-marker]:hidden flex items-center gap-1 rounded-full p-0.5 cursor-pointer hover:bg-gray-100" aria-label="Account menu">
                  <img src="<%= current_user.avatar_url %>" alt="" class="w-7 h-7 rounded-full">
                  <svg class="hidden sm:block w-3 h-3 text-gray-400 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <div class="absolute right-0 mt-2 w-52 rounded-xl border border-gray-200 bg-white shadow-lg py-1 z-20">
                  <p class="px-4 py-2 text-xs text-gray-400 font-mono truncate border-b border-gray-100">@<%= current_user.username %></p>
                  <%= link_to "Settings", settings_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-50" %>
                  <% if current_user.pro? %>
                    <%= link_to "Analytics", analytics_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-50" %>
                  <% else %>
                    <%= link_to "Upgrade to Pro", pricing_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-50" %>
                  <% end %>
                  <%= link_to "Explore builders", feed_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-50" %>
                  <% if current_user.owner? %>
                    <%= link_to "Admin", admin_path, class: "block px-4 py-2 text-gray-700 hover:bg-gray-50" %>
                  <% end %>
                  <div class="border-t border-gray-100 mt-1 pt-1">
                    <%= button_to "Sign out", sign_out_path, method: :delete, data: { turbo: false },
                          class: "w-full text-left px-4 py-2 text-gray-500 hover:bg-gray-50 hover:text-gray-900 cursor-pointer" %>
                  </div>
                </div>
              </details>
            <% else %>
              <%= link_to "Pricing", pricing_path, class: "text-gray-600 hover:text-gray-900" %>
              <%= link_to "Blog", blog_path, class: "hidden sm:inline text-gray-600 hover:text-gray-900" %>
              <%= button_to "Sign in with GitHub", "/auth/github", method: :post, data: { turbo: false }, class: "bg-gray-900 text-white px-3 py-1.5 rounded-md hover:bg-gray-700 border-0 cursor-pointer" %>
            <% end %>
          </div>
        </nav>
      </header>

      <% if flash[:notice] %>
        <div class="bg-green-50 border-b border-green-200 px-4 py-2 text-sm text-green-800 text-center"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="bg-red-50 border-b border-red-200 px-4 py-2 text-sm text-red-800 text-center"><%= flash[:alert] %></div>
      <% end %>
    <% end %>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <% unless content_for?(:minimal_page) %>
      <footer class="border-t border-gray-100 mt-8">
        <div class="max-w-5xl mx-auto px-4 py-8">
          <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-gray-500" aria-label="Footer">
            <%= link_to "Home", root_path, class: "hover:text-gray-900" %>
            <%= link_to "Pricing", pricing_path, class: "hover:text-gray-900" %>
            <%= link_to "About", about_path, class: "hover:text-gray-900" %>
            <%= link_to "Blog", blog_path, class: "hover:text-gray-900" %>
            <%= link_to "Live demo", profile_path("tuxnotfound"), class: "hover:text-gray-900" %>
            <a href="https://github.com/tuxnotfound/openstage" rel="noopener" class="hover:text-gray-900">GitHub</a>
          </nav>
          <div class="text-center text-xs text-gray-400 mt-5">
            got thoughts? we'd love to hear them —
            <a href="mailto:tuxnotfound@cioga.eu" class="text-gray-500 hover:text-gray-700 underline">tuxnotfound@cioga.eu</a>
            <div class="italic mt-1">(feedback, bugs, or just say hi)</div>
          </div>
        </div>
      </footer>
    <% end %>
  </body>
</html>
