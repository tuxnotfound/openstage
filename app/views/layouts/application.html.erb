<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Openstage" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% if content_for?(:meta_description) %>
      <meta name="description" content="<%= yield(:meta_description) %>">
    <% end %>
    <%= yield :head %>
    <% if ENV["GOOGLE_SITE_VERIFICATION"].present? %>
      <meta name="google-site-verification" content="<%= ENV["GOOGLE_SITE_VERIFICATION"] %>" />
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <% if ENV["UMAMI_WEBSITE_ID"].present? %>
      <script defer src="https://cloud.umami.is/script.js" data-website-id="<%= ENV["UMAMI_WEBSITE_ID"] %>"></script>
    <% end %>
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <% unless content_for?(:minimal_page) %>
      <header class="border-b border-gray-200">
        <nav class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
          <%= link_to "Openstage", root_path, class: "font-semibold text-gray-900" %>

          <div class="flex items-center gap-4 text-sm">
            <% if user_signed_in? %>
              <%= link_to "Dashboard", dashboard_path, class: "text-gray-600 hover:text-gray-900" %>
              <% if current_user.pro? %>
                <%= link_to "Analytics", analytics_path, class: "text-gray-600 hover:text-gray-900" %>
              <% end %>
              <%= link_to "Feed", feed_path, class: "text-gray-600 hover:text-gray-900" %>
              <%= link_to "Settings", settings_path, class: "text-gray-600 hover:text-gray-900" %>
              <%= link_to "Timeline", profile_path(current_user.username), class: "text-gray-600 hover:text-gray-900" %>
              <%= button_to "Sign out", sign_out_path, method: :delete, data: { turbo: false }, class: "text-gray-500 hover:text-gray-900" %>
            <% else %>
              <%= button_to "Sign in with GitHub", "/auth/github", method: :post, data: { turbo: false }, class: "bg-gray-900 text-white px-3 py-1.5 rounded-md hover:bg-gray-700 border-0 cursor-pointer" %>
            <% end %>
          </div>
        </nav>
      </header>

      <% if flash[:notice] %>
        <div class="bg-green-50 border-b border-green-200 px-4 py-2 text-sm text-green-800 text-center"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="bg-red-50 border-b border-red-200 px-4 py-2 text-sm text-red-800 text-center"><%= flash[:alert] %></div>
      <% end %>
    <% end %>

    <main class="max-w-4xl mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <% unless content_for?(:minimal_page) %>
      <footer class="max-w-4xl mx-auto px-4 py-8 text-center text-xs text-gray-400">
        got thoughts? we'd love to hear them —
        <a href="mailto:tuxnotfound@cioga.eu" class="text-gray-500 hover:text-gray-700 underline">tuxnotfound@cioga.eu</a>
        <div class="italic mt-1">(feedback, bugs, or just say hi)</div>
      </footer>
    <% end %>
  </body>
</html>
