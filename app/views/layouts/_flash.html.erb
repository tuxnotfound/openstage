<% if flash[:notice] || flash[:alert] %>
  <div class="os-wrap os-stack mb-2 gap-2">
    <% if flash[:notice] %>
      <p role="status" class="rounded-control bg-accent-soft px-4 py-2.5 text-sm"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p role="alert" class="rounded-control bg-down-soft px-4 py-2.5 text-sm"><%= flash[:alert] %></p>
    <% end %>
  </div>
<% end %>
