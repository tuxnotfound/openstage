<%# What an action answered, a success or a refusal: under the header as the
    page opens, and held at the top of the screen as the page scrolls, so a
    page that comes back where the click was still shows it. Dismiss takes one
    away (flash controller); the next page has none. %>
<% messages = [ [ :notice, "status", "" ], [ :alert, "alert", " down" ] ].select { |key, _role, _look| flash[key].present? } %>
<% if messages.any? %>
  <div class="os-flash" data-controller="flash">
    <div class="<%= content_for(:wrap) || "os-wrap" %> os-flash-list">
      <% messages.each do |key, role, look| %>
        <div role="<%= role %>" class="os-msg<%= look %>" data-flash-target="message">
          <p><%= flash[key] %></p>
          <button type="button" class="os-msg-x" aria-label="Dismiss this message" data-action="flash#dismiss">&times;</button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
