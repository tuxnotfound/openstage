<header class="os-wrap">
  <% if user_signed_in? %>
    <%# On a phone the tabs take a row of their own and scroll sideways. %>
    <div class="os-top max-md:h-auto max-md:flex-wrap max-md:gap-x-3 max-md:gap-y-1 max-md:pt-3">
      <%= link_to "openstage", root_path, class: "os-logo" %>
      <nav class="os-nav md:ml-3 max-md:order-last max-md:w-full max-md:flex-nowrap max-md:overflow-x-auto max-md:py-3" aria-label="Main">
        <%= nav_link "Dashboard", dashboard_path, :dashboard %>
        <%= nav_link safe_join([ "Your stage ", tag.span("↗", aria: { hidden: true }) ]), profile_path(current_user.username), :page %>
        <%= nav_link "Feed", feed_path, :feed %>
        <% if current_user.pro? %>
          <%= nav_link "Analytics", analytics_path, :analytics %>
        <% end %>
        <%= nav_link "Settings", settings_path, :settings %>
      </nav>
      <span class="ml-auto"></span>
      <%= render "layouts/theme_toggle" %>

      <details class="relative" data-controller="dropdown">
        <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer rounded-full" aria-label="Account menu">
          <img src="<%= current_user.avatar_url %>" alt="" class="os-avatar size-8.5">
        </summary>
        <div class="os-card absolute right-0 top-full z-20 mt-2 w-56 p-1.5 text-sm shadow-lg">
          <p class="px-3 py-2 os-xs os-muted truncate">@<%= current_user.username %></p>
          <% unless current_user.pro? %>
            <%= link_to "Upgrade to Pro", pricing_path, class: "block rounded-[10px] px-3 py-2 hover:bg-fill" %>
          <% end %>
          <% if current_user.owner? %>
            <%= link_to "Admin", admin_path, class: "block rounded-[10px] px-3 py-2 hover:bg-fill" %>
          <% end %>
          <div class="mt-1 border-t border-line pt-1">
            <%= button_to "Sign out", sign_out_path, method: :delete, data: { turbo: false },
                  class: "w-full cursor-pointer rounded-[10px] px-3 py-2 text-left text-ink-3 hover:bg-fill hover:text-ink" %>
          </div>
        </div>
      </details>
    </div>
  <% else %>
    <%# A visitor's one action is their own stage, straight to GitHub's sign-in,
        which a member uses too; "Sign in" names it for them beside the links.
        On a phone only the logo and the button fit, so the links and the
        theme fold into a menu beside the button. %>
    <div class="os-top max-sm:gap-3">
      <%= link_to "openstage", root_path, class: "os-logo" %>
      <nav class="os-nav ml-auto items-center max-sm:hidden" aria-label="Main">
        <%= link_to "Feed", feed_path, aria: { current: (controller_name == "feed" ? "page" : nil) } %>
        <%= link_to "Pricing", pricing_path %>
        <%= link_to "Blog", blog_path %>
        <%= button_to "Sign in", "/auth/github", method: :post, data: { turbo: false, sign_in: true },
                      class: "cursor-pointer whitespace-nowrap text-ink-2 hover:text-ink" %>
      </nav>
      <span class="max-sm:hidden"><%= render "layouts/theme_toggle" %></span>
      <%# On the landing its box is the one action, so the button leaves. %>
      <% landing = previews_on? && controller_name == "home" %>
      <%= render "layouts/make_your_own", form_class: "max-sm:ml-auto" unless landing %>
      <details class="relative sm:hidden <%= "max-sm:ml-auto" if landing %>" data-controller="dropdown" data-phone-menu>
        <summary class="os-chip size-8.5 cursor-pointer justify-center p-0 text-ink-2 list-none [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav class="os-card absolute right-0 top-full z-20 mt-2 w-52 p-1.5 text-[15px] font-semibold shadow-lg" aria-label="Menu">
          <% item = "block w-full cursor-pointer rounded-[10px] px-3 py-2.5 text-left text-ink-2 hover:bg-fill hover:text-ink" %>
          <%= link_to "Feed", feed_path, class: item, aria: { current: (controller_name == "feed" ? "page" : nil) } %>
          <%= link_to "Pricing", pricing_path, class: item %>
          <%= link_to "Blog", blog_path, class: item %>
          <%= button_to "Sign in", "/auth/github", method: :post, data: { turbo: false, sign_in: true }, class: item %>
          <div class="mt-1 border-t border-line pt-1">
            <button type="button" class="<%= item %>" data-controller="theme" data-action="theme#toggle">
              <span class="dark:hidden">Dark theme</span><span class="hidden dark:inline">Light theme</span>
            </button>
          </div>
        </nav>
      </details>
    </div>
  <% end %>
</header>
