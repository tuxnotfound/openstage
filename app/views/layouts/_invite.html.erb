<%# The end of a builder's page, for a signed-out visitor who read it this
    far: what they get, and the header's button (layouts/_make_your_own).
    title and about: the page's own words; ref: its tag for /admin. %>
<section class="os-panel flex flex-wrap items-center justify-between gap-x-6 gap-y-3.5" aria-labelledby="invite" data-invite>
  <div class="min-w-0">
    <h2 id="invite" class="os-h3"><%= title %></h2>
    <p class="os-sm os-muted mt-0.5"><%= about %></p>
  </div>
  <%= render "layouts/make_your_own", ref: ref %>
</section>
