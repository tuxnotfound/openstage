<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
  </head>

  <%# The app's look as mail draws it: the wordmark, then the message in the
      app's panels (MailHelper), 600 wide at most. The app's fonts show where
      a reader has them; none is fetched, so opening a mail calls no one. %>
  <body style="margin: 0; padding: 0; background: #FFFFFF; color: #0E0F12; font-family: <%= MailHelper::SANS %>; font-size: 15px; line-height: 1.55;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; border-collapse: collapse;">
            <tr>
              <td align="left" style="padding: 0 4px 16px; font-family: <%= MailHelper::DISPLAY %>; font-size: 22px; font-weight: 700; letter-spacing: -0.02em; color: #0E0F12;">openstage</td>
            </tr>
            <tr>
              <td align="left"><%= yield %></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
