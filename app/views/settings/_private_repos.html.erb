<div class="mt-3.5">
  <% if current_user.github_installation_id? %>
    <div class="os-card">
      <p class="os-sm">
        Private repos are connected, read-only. They stay excluded until you include them above.
        <%= link_to "Change which repos Openstage can read", "https://github.com/settings/installations/#{current_user.github_installation_id}",
              class: "os-link text-sm", target: "_blank", rel: "noopener" %>
        on GitHub: a repo you add there shows up here excluded, and one you remove leaves Openstage, its commits with it.
      </p>
      <% if repo_scope %>
        <p class="os-xs mt-2 font-semibold text-warn">Openstage no longer needs the read and write access you gave it before. Revoke it at <%= link_to "github.com/settings/applications", "https://github.com/settings/applications", class: "underline", target: "_blank", rel: "noopener" %>, then sign in again.</p>
      <% end %>
    </div>
  <% elsif repo_scope %>
    <p class="os-sm os-muted">Private repos are connected. They stay excluded until you include them above.</p>
    <% if github_app %>
      <div class="os-card os-between mt-2">
        <p class="os-sm min-w-0 flex-[1_1_320px]">Openstage can now read private repos without write access, and only the ones you pick. Pick every private repo you want on your page: once you switch, the ones you leave out are removed.</p>
        <%= link_to "Switch to read-only", new_github_installation_path, data: { turbo: false }, class: "os-btn sm" %>
      </div>
    <% end %>
  <% elsif github_app %>
    <div class="os-card os-between">
      <p class="os-sm min-w-0 flex-[1_1_320px]">Private repos are not listed. Connecting them installs the Openstage GitHub App on the repos you pick, read-only. Openstage reads their commits, releases, merged pull requests and deploys, and never stores your code. Each private repo stays excluded until you include it.</p>
      <%= link_to "Connect private repos", new_github_installation_path, data: { turbo: false }, class: "os-btn sm" %>
    </div>
  <% else %>
    <div class="os-card os-between">
      <p class="os-sm min-w-0 flex-[1_1_320px]">Private repos are not listed. GitHub only shares them through its <code>repo</code> permission, which also allows writes. Openstage never writes. It reads their commits, releases, merged pull requests and deploys, and never stores your code. Each private repo stays excluded until you include it.</p>
      <%= button_to "Connect private repos", "/auth/github", method: :post, params: { scope: "user:email,repo" }, data: { turbo: false }, class: "os-btn sm" %>
    </div>
  <% end %>
</div>
