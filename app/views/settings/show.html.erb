<% content_for :title, "Settings — Openstage" %>

<div class="max-w-xl">
  <h1 class="text-2xl font-bold mb-6">Settings</h1>

  <!-- Tab nav -->
  <div data-controller="tabs">
    <div class="flex gap-1 border-b border-gray-100 mb-8">
      <button data-tabs-target="tab"
              data-tabs-tab="profile"
              data-action="click->tabs#show"
              class="px-4 py-2 text-sm font-medium transition-colors data-[active=true]:text-gray-900 data-[active=true]:border-b-2 data-[active=true]:border-gray-900 data-[active=true]:-mb-px data-[active=false]:text-gray-500 data-[active=false]:hover:text-gray-900">
        Profile
      </button>
      <button data-tabs-target="tab"
              data-tabs-tab="integrations"
              data-action="click->tabs#show"
              class="px-4 py-2 text-sm font-medium transition-colors data-[active=true]:text-gray-900 data-[active=true]:border-b-2 data-[active=true]:border-gray-900 data-[active=true]:-mb-px data-[active=false]:text-gray-500 data-[active=false]:hover:text-gray-900">
        Integrations
      </button>
    </div>

    <!-- Profile tab -->
    <div data-tabs-target="panel" data-tabs-panel="profile">

      <!-- Profile form -->
      <section class="mb-10">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Profile</h2>
        <div class="bg-white border border-gray-200 rounded-xl p-6">
          <%= form_with model: current_user, url: settings_path, method: :patch do |f| %>
            <div class="space-y-4">
              <div>
                <%= f.label :display_name, "Display name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_field :display_name,
                    class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
              </div>

              <div>
                <%= f.label :bio, "Bio", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_area :bio,
                    rows: 3,
                    placeholder: "What are you building?",
                    class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent resize-none" %>
              </div>

              <div>
                <%= f.label :website_url, "Website", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.url_field :website_url,
                    placeholder: "https://",
                    class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
              </div>

              <div>
                <%= f.label :building_since, "Building since", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.date_field :building_since,
                    class: "border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
              </div>
            </div>

            <div class="mt-6">
              <%= f.submit "Save changes",
                  class: "bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors cursor-pointer" %>
            </div>
          <% end %>
        </div>
      </section>

      <!-- Username -->
      <section class="mb-10">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Username</h2>
        <div class="bg-white border border-gray-200 rounded-xl p-6">
          <% if current_user.can_change_username? %>
            <%= form_with model: current_user, url: settings_username_path, method: :patch do |f| %>
              <div class="flex gap-3 items-end">
                <div class="flex-1">
                  <%= f.label :username, "Username", class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-gray-900">
                    <span class="px-3 py-2.5 text-sm text-gray-400 bg-gray-50 border-r border-gray-200">openstage.dev/</span>
                    <%= f.text_field :username,
                        class: "flex-1 px-3 py-2.5 text-sm focus:outline-none" %>
                  </div>
                </div>
                <%= f.submit "Update",
                    class: "bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors cursor-pointer shrink-0" %>
              </div>
              <p class="text-xs text-gray-400 mt-2">You can change your username once every 30 days.</p>
            <% end %>
          <% else %>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-900">@<%= current_user.username %></p>
                <p class="text-xs text-gray-400 mt-0.5">
                  Next change available on <%= current_user.next_username_change_at.strftime("%B %-d, %Y") %>
                </p>
              </div>
              <span class="text-xs text-gray-400 bg-gray-100 px-2.5 py-1 rounded-full">Locked</span>
            </div>
          <% end %>
        </div>
      </section>

      <!-- Danger zone -->
      <section>
        <h2 class="text-sm font-semibold text-red-500 uppercase tracking-wide mb-4">Danger zone</h2>
        <div class="bg-white border border-red-200 rounded-xl p-6">
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="text-sm font-medium text-gray-900">Delete account</p>
              <p class="text-xs text-gray-500 mt-1">
                Your profile goes offline immediately. You have 30 days to recover your account by contacting support — after that, it's permanent.
              </p>
            </div>
            <%= button_to "Delete account", settings_path, method: :delete,
                data: { turbo_confirm: "Are you sure? Your profile will go offline immediately. This can be recovered within 30 days." },
                class: "shrink-0 bg-white text-red-600 border border-red-300 px-4 py-2 rounded-lg text-sm font-medium hover:bg-red-50 transition-colors cursor-pointer" %>
          </div>
        </div>
      </section>

    </div>

    <!-- Integrations tab -->
    <div data-tabs-target="panel" data-tabs-panel="integrations" class="hidden">

      <!-- Connected accounts -->
      <section class="mb-10">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Connected accounts</h2>
        <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
          <div class="flex items-center justify-between px-5 py-4">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
              </svg>
              <div>
                <p class="text-sm font-medium text-gray-900">GitHub</p>
                <p class="text-xs text-gray-400">@<%= current_user.github_username %></p>
              </div>
            </div>
            <span class="flex items-center gap-1.5 text-xs text-green-600 font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
              Connected
            </span>
          </div>
          <div class="flex items-center justify-between px-5 py-4">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <div>
                <p class="text-sm font-medium text-gray-400">X / Twitter</p>
                <p class="text-xs text-gray-300">Coming soon</p>
              </div>
            </div>
            <span class="text-xs text-gray-400">Not connected</span>
          </div>
        </div>
      </section>

      <!-- GitHub repos -->
      <% if @github_repos.any? %>
      <section>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">GitHub repos</h2>
          <% if @last_github_sync %>
            <span class="text-xs text-gray-400">Synced <%= time_ago_in_words(@last_github_sync) %> ago</span>
          <% end %>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100 overflow-hidden">
          <% @github_repos.each do |repo| %>
            <%= turbo_frame_tag dom_id(repo) do %>
              <div class="flex items-center justify-between px-5 py-3">
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-gray-800 truncate"><%= repo.name %></p>
                  <% if repo.description.present? %>
                    <p class="text-xs text-gray-400 truncate"><%= repo.description %></p>
                  <% end %>
                </div>
                <%= button_to github_repo_path(repo), method: :patch,
                    params: { included: (!repo.included?).to_s },
                    class: "ml-4 shrink-0 text-xs px-3 py-1 rounded-full border transition-colors #{repo.included? ? 'border-green-300 text-green-700 bg-green-50 hover:bg-green-100' : 'border-gray-200 text-gray-400 bg-white hover:border-gray-400'}" do %>
                  <%= repo.included? ? "Included" : "Excluded" %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
        <p class="text-xs text-gray-400 mt-2">Excluded repos won't contribute commits to your timeline.</p>
      </section>
      <% end %>

    </div>
  </div>
</div>
