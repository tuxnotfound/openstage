<% content_for :title, "Settings — Openstage" %>

<div class="max-w-xl">
  <h1 class="text-2xl font-bold mb-8">Settings</h1>

  <!-- Profile -->
  <section class="mb-10">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Profile</h2>
    <div class="bg-white border border-gray-200 rounded-xl p-6">
      <%= form_with model: current_user, url: settings_path, method: :patch do |f| %>
        <div class="space-y-4">
          <div>
            <%= f.label :display_name, "Display name", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :display_name,
                class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div>
            <%= f.label :bio, "Bio", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_area :bio,
                rows: 3,
                placeholder: "What are you building?",
                class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent resize-none" %>
          </div>

          <div>
            <%= f.label :website_url, "Website", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.url_field :website_url,
                placeholder: "https://",
                class: "w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>

          <div>
            <%= f.label :building_since, "Building since", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.date_field :building_since,
                class: "border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
          </div>
        </div>

        <div class="mt-6">
          <%= f.submit "Save changes",
              class: "bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Username -->
  <section class="mb-10">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Username</h2>
    <div class="bg-white border border-gray-200 rounded-xl p-6">
      <% if current_user.can_change_username? %>
        <%= form_with model: current_user, url: settings_username_path, method: :patch do |f| %>
          <div class="flex gap-3 items-end">
            <div class="flex-1">
              <%= f.label :username, "Username", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-gray-900">
                <span class="px-3 py-2.5 text-sm text-gray-400 bg-gray-50 border-r border-gray-200">openstage.dev/</span>
                <%= f.text_field :username,
                    class: "flex-1 px-3 py-2.5 text-sm focus:outline-none" %>
              </div>
            </div>
            <%= f.submit "Update",
                class: "bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors cursor-pointer shrink-0" %>
          </div>
          <p class="text-xs text-gray-400 mt-2">You can change your username once every 30 days.</p>
        <% end %>
      <% else %>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-900">@<%= current_user.username %></p>
            <p class="text-xs text-gray-400 mt-0.5">
              Next change available on <%= current_user.next_username_change_at.strftime("%B %-d, %Y") %>
            </p>
          </div>
          <span class="text-xs text-gray-400 bg-gray-100 px-2.5 py-1 rounded-full">Locked</span>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Danger zone -->
  <section>
    <h2 class="text-sm font-semibold text-red-500 uppercase tracking-wide mb-4">Danger zone</h2>
    <div class="bg-white border border-red-200 rounded-xl p-6">
      <div class="flex items-start justify-between gap-6">
        <div>
          <p class="text-sm font-medium text-gray-900">Delete account</p>
          <p class="text-xs text-gray-500 mt-1">
            Your profile goes offline immediately. You have 30 days to recover your account by contacting support — after that, it's permanent.
          </p>
        </div>
        <%= button_to "Delete account", settings_path, method: :delete,
            data: { turbo_confirm: "Are you sure? Your profile will go offline immediately. This can be recovered within 30 days." },
            class: "shrink-0 bg-white text-red-600 border border-red-300 px-4 py-2 rounded-lg text-sm font-medium hover:bg-red-50 transition-colors cursor-pointer" %>
      </div>
    </div>
  </section>
</div>
