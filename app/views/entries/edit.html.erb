<% content_for :dark_mode, true %>
<%= turbo_frame_tag dom_id(@entry) do %>
  <div class="os-card my-2">
    <%= form_with model: @entry, url: entry_path(@entry), method: :patch, class: "os-stack gap-2.5" do |f| %>
      <%= render "entries/type_picker", f: f, current: @entry.entry_type, id_prefix: "edit_entry_type_#{@entry.id}" %>
      <%= f.text_field :title, placeholder: "Title", aria: { label: "Title" }, class: "os-field" %>
      <%= f.text_area :body, placeholder: "More detail (optional)", rows: 2, aria: { label: "More detail (optional)" }, class: "os-area min-h-20" %>
      <div class="flex flex-col gap-2.5 sm:flex-row">
        <%= f.url_field :url, placeholder: "Link (optional)", aria: { label: "Link (optional)" }, class: "os-field" %>
        <%= f.datetime_local_field :occurred_at, value: @entry.occurred_at.strftime("%Y-%m-%dT%H:%M"), aria: { label: "When" }, class: "os-field sm:w-auto" %>
      </div>
      <% suggestions_id = "project-suggestions-#{@entry.id}" %>
      <%= f.text_field :repo_name, list: suggestions_id, placeholder: "Project / repo (optional)", aria: { label: "Project / repo (optional)" }, class: "os-field" %>
      <datalist id="<%= suggestions_id %>">
        <% current_user.project_names.each do |name| %><option value="<%= name %>"></option><% end %>
      </datalist>
      <div class="flex items-center gap-2">
        <%= f.submit "Save", class: "os-btn sm" %>
        <%= link_to "Cancel", dashboard_path, class: "os-btn2 sm", data: { turbo_frame: dom_id(@entry) } %>
      </div>
    <% end %>
  </div>
<% end %>
