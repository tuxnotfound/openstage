<%= turbo_frame_tag dom_id(@entry) do %>
  <div class="p-4 bg-gray-50 border-b border-gray-100">
    <%= form_with model: @entry, url: entry_path(@entry), method: :patch do |f| %>
      <div class="flex flex-wrap gap-2 mb-3">
        <% [
          ["milestone", "Milestone"],
          ["shipped",   "Shipped"],
          ["note",      "Note"],
          ["link",      "Link"],
          ["released",  "Released"],
        ].each do |value, label| %>
          <label class="cursor-pointer">
            <%= f.radio_button :entry_type, value, id: "edit_entry_type_#{value}_#{@entry.id}", class: "peer sr-only", checked: @entry.entry_type == value %>
            <span class="peer-checked:bg-gray-900 peer-checked:text-white inline-block px-3 py-1 rounded-full text-xs font-medium border border-gray-200 text-gray-600 hover:border-gray-400 transition-colors">
              <%= label %>
            </span>
          </label>
        <% end %>
      </div>

      <%= f.text_field :title,
          placeholder: "Title",
          class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent mb-2" %>

      <%= f.text_area :body,
          placeholder: "More detail (optional)",
          rows: 2,
          class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent mb-2 resize-none" %>

      <div class="flex flex-col sm:flex-row gap-2 mb-3">
        <%= f.url_field :url,
            placeholder: "Link (optional)",
            class: "flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
        <%= f.datetime_local_field :occurred_at,
            value: @entry.occurred_at.strftime("%Y-%m-%dT%H:%M"),
            class: "border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent" %>
      </div>

      <div class="flex items-center gap-2">
        <%= f.submit "Save",
            class: "bg-gray-900 text-white px-4 py-1.5 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors cursor-pointer" %>
        <%= link_to "Cancel", dashboard_path,
            class: "text-sm text-gray-500 hover:text-gray-900 transition-colors",
            data: { turbo_frame: dom_id(@entry) } %>
      </div>
    <% end %>
  </div>
<% end %>
