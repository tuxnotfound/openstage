<%# One builder's day: up to three entries in their words, and how many more. %>
<% user = group.user %>
<article class="os-card <%= feed_color(user) %> p-5">
  <div class="os-between">
    <div class="flex min-w-0 items-center gap-3">
      <img src="<%= user.avatar_url %>" alt="" class="os-avatar size-10">
      <div class="min-w-0">
        <p class="font-bold">@<%= user.username %></p>
        <p class="os-xs os-muted"><%= feed_summary(group) %></p>
      </div>
    </div>
    <%= link_to "Open page", profile_path(user.username), class: "os-btn2 sm" %>
  </div>
  <div class="mt-2.5">
    <% group.entries.first(3).each do |entry| %>
      <div class="os-row flex items-baseline gap-2.5 py-2 text-[15px]">
        <span class="os-dot size-2 shrink-0 bg-(--project)"></span>
        <span class="min-w-0"><%= entry.title %><% if entry.repo_name.present? %> <span class="os-xs os-muted"><%= entry.repo_name.split("/").last %></span><% end %></span>
      </div>
    <% end %>
  </div>
  <% if group.entries.size > 3 %>
    <p class="os-note border-t border-line pt-2"><%= "and #{group.entries.size - 3} more that day" %></p>
  <% end %>
</article>
