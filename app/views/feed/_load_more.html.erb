<% if feed.next_cursor %>
  <div id="load-more" class="mt-4" data-controller="infinite-scroll" data-infinite-scroll-target="sentinel">
    <%= link_to "Load more", feed_path(show: @show, **feed.next_cursor), class: "os-btn2",
          data: { turbo_stream: true, infinite_scroll_target: "link" } %>
  </div>
<% end %>
