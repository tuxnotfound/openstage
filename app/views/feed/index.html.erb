<% content_for :title, "Feed — Openstage" %>
<% content_for :dark_mode, true %>
<% content_for :main_class, "os-wrap pt-1.5" %>

<section class="os-panel">
  <div class="os-between">
    <div>
      <h1 class="os-h1 text-[clamp(34px,4vw,48px)]">Feed</h1>
      <p class="os-p mt-1.5">The latest from every builder on Openstage.</p>
    </div>
    <nav class="os-pills" aria-label="Show">
      <% [ [ nil, "Everything" ], [ "shipped", "Shipped" ], [ "posts", "Posts" ] ].each do |show, label| %>
        <%= link_to label, feed_path(show: show), class: "os-pill", aria: { current: (@show == show ? "page" : nil) } %>
      <% end %>
    </nav>
  </div>

  <% if @entries.empty? %>
    <p class="os-sm os-muted mt-4 rounded-card border border-dashed border-line py-14 text-center">No public entries yet.</p>
  <% else %>
    <p class="os-card mt-4 border-transparent bg-accent-soft os-sm os-ink2">
      The latest <b class="os-num text-[22px] text-accent-ink"><%= @entries.size %></b> entries come from
      <b class="os-num text-[22px] text-accent-ink"><%= @entries.map(&:user_id).uniq.size %></b> <%= @entries.map(&:user_id).uniq.one? ? "builder" : "builders" %>.
    </p>
    <div id="feed-groups" class="os-stack mt-4">
      <%= render partial: "feed/group", collection: feed_groups(@entries), as: :group %>
    </div>
    <%= render "feed/load_more", entries: @entries %>
  <% end %>
</section>
