<% content_for :title, "Feed — Openstage" %>

<div class="flex items-start gap-8">
  <!-- Main feed -->
  <div class="flex-1 min-w-0">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Feed</h1>
      <p class="text-sm text-gray-500 mt-0.5">Updates from builders you follow</p>
    </div>

    <% if @following_count == 0 %>
      <div class="rounded-2xl border border-dashed border-gray-200 bg-white px-6 py-16 text-center">
        <p class="text-gray-500 text-sm mb-3">You're not following anyone yet.</p>
        <%= link_to "Find builders on the homepage →", root_path, class: "text-sm text-gray-900 font-medium hover:underline" %>
      </div>
    <% elsif @entries.empty? %>
      <div class="rounded-2xl border border-dashed border-gray-200 bg-white px-6 py-16 text-center">
        <p class="text-gray-500 text-sm">The builders you follow haven't posted anything yet.</p>
      </div>
    <% else %>
      <div class="rounded-2xl border border-gray-200 bg-white overflow-hidden">
        <div id="feed-entries">
          <%= render partial: "home/feed_entry", collection: @entries, as: :entry %>
        </div>
      </div>

      <% if @entries.next_page %>
        <div class="mt-6 text-center">
          <%= link_to "Load more",
              feed_path(page: @entries.next_page),
              class: "text-sm text-gray-500 hover:text-gray-900 border border-gray-200 rounded-lg px-5 py-2.5 inline-block transition-colors" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Suggested sidebar -->
  <% if @suggested_users.any? %>
    <aside class="w-64 shrink-0 hidden lg:block">
      <div class="bg-white border border-gray-200 rounded-2xl px-4 py-4">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Suggested builders</h2>
        <div class="space-y-0">
          <% @suggested_users.each do |user| %>
            <div class="flex items-center justify-between py-2.5 border-b border-gray-100 last:border-0">
              <a href="<%= profile_path(user.username) %>" class="flex items-center gap-2.5 min-w-0 hover:opacity-80 transition-opacity">
                <img src="<%= user.avatar_url %>"
                     alt="<%= user.display_name %>"
                     class="w-8 h-8 rounded-full ring-1 ring-gray-100 shrink-0">
                <div class="min-w-0">
                  <p class="text-xs font-medium text-gray-900 truncate"><%= user.display_name %></p>
                  <p class="text-xs text-gray-400 font-mono truncate">@<%= user.username %></p>
                </div>
              </a>
              <%= render "profiles/follow_button", user: user, follow: nil %>
            </div>
          <% end %>
        </div>
      </div>
    </aside>
  <% end %>
</div>
