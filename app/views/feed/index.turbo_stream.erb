<%= turbo_stream.append "feed-entries" do %>
  <%= render partial: "home/feed_entry", collection: @entries, as: :entry %>
<% end %>

<% if @entries.next_page %>
  <%= turbo_stream.replace "load-more" do %>
    <%= render "feed/load_more", entries: @entries %>
  <% end %>
<% else %>
  <%= turbo_stream.remove "load-more" %>
<% end %>
