<%= turbo_stream.append "feed-groups" do %>
  <%= render partial: "feed/group", collection: @feed.cards, as: :group %>
<% end %>

<% if @feed.next_cursor %>
  <%= turbo_stream.replace "load-more" do %>
    <%= render "feed/load_more", feed: @feed %>
  <% end %>
<% else %>
  <%= turbo_stream.remove "load-more" %>
<% end %>
