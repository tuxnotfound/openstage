<% project = @focus.project %>
<% card = @focus.card %>
<% section = @focus.page.section %>
<% website = safe_external_url(card&.website) %>
<% picture = safe_external_url(card&.picture) %>
<% can_follow = current_user != @user %>
<% content_for :title, "#{project.name} by #{@user.display_name} — Openstage" %>
<% content_for :meta_description, card&.description.presence || "#{project.name}, a project #{@user.display_name} is building in public on Openstage." %>
<% content_for :canonical, project_page_url(@user.username, project.repo.split("/").last) %>
<%# A shared link shows the project's own picture; without one, its card. %>
<% content_for :og_image, picture || share_card(og_project_url(@user.username, project.repo.split("/").last)) %>
<% content_for :main_class, "os-wrap os-stack pt-1.5" %>

<% if @revealed %>
  <p role="status" class="rounded-control bg-accent-soft px-4 py-3 os-sm">
    <b>Only you can see this page.</b> You hid <%= project.name %>, so visitors who open it land on your page.
    <%= link_to "Show it again on the dashboard", dashboard_path(anchor: "activity-lines"), class: "os-link text-sm" %>
  </p>
<% end %>

<nav aria-label="Breadcrumb" class="os-sm flex items-center gap-2 px-1">
  <img src="<%= @user.avatar_url %>" alt="" class="os-avatar size-6">
  <%= link_to @user.display_name, profile_path(@user.username), class: "os-link text-sm" %>
  <span class="os-muted" aria-hidden="true">/</span>
  <span class="font-bold" aria-current="page"><%= project.name %></span>
</nav>

<section class="os-panel <%= project_class(project.rank) %>" aria-label="<%= project.name %>">
  <div class="flex flex-wrap items-start gap-x-9 gap-y-6">
    <div class="min-w-0 flex-[999_1_520px]">
      <div class="flex flex-wrap gap-2">
        <% if card&.live? %><span class="os-tag soft">Live</span><% end %>
        <% if card&.archived? %><span class="os-tag">Archived</span><% end %>
        <% unless card.nil? || card.private_repo.nil? %>
          <span class="os-tag"><%= card.private_repo ? "Private repo, commit messages only" : "Public repo" %></span>
        <% end %>
        <% if card&.last_commit %><span class="os-tag">Last commit <%= progress_ago(card.last_commit) %></span><% end %>
      </div>
      <h1 class="os-h1 mt-3.5 flex items-center gap-4 text-[clamp(36px,5vw,56px)] [overflow-wrap:anywhere]">
        <span class="os-dot size-4 shrink-0 bg-(--project)" aria-hidden="true"></span><%= project.name %>
      </h1>
      <% if card&.description %>
        <p class="os-p mt-3 max-w-[62ch] text-[19px]/[1.5] text-ink"><%= card.description %></p>
      <% end %>
      <div class="mt-5 flex flex-wrap gap-2.5">
        <% slug = project.repo.split("/").last %>
        <% if website && card.github_repo.outbound_url("visit") %>
          <a href="<%= project_click_out_path(@user.username, slug, "visit") %>" target="_blank" rel="noopener" data-turbo="false" class="os-btn">Visit <%= URI(website).host %> <span aria-hidden="true">↗</span></a>
        <% end %>
        <% if card&.github_repo&.outbound_url("github") %>
          <a href="<%= project_click_out_path(@user.username, slug, "github") %>" target="_blank" rel="noopener" data-turbo="false" class="os-btn2">View on GitHub <span aria-hidden="true">↗</span></a>
        <% end %>
      </div>
    </div>
    <% if picture || can_follow %>
      <div class="os-stack min-w-0 flex-[1_1_300px]">
        <% if picture %>
          <img src="<%= picture %>" alt="" data-controller="hide-broken" data-action="error->hide-broken#hide"
               class="aspect-[2/1] w-full rounded-[12px] bg-(--project)/12 object-cover">
        <% end %>
        <%= render "project_pages/follow", user: @user, card: card if can_follow %>
      </div>
    <% end %>
  </div>

  <%# With site visits, a toggle per number above the chart; with both on, it compares them. %>
  <% site_view = SiteVisitsViewSerializer.new(@focus.site, section) if @focus.site %>
  <% numbers = chart_numbers(site_view, params[:show]) %>
  <% show = (numbers.first if numbers.one? && site_view) %>
  <% range_param = section.labels.range == Progress::Window::DEFAULT ? nil : section.labels.range %>
  <%= react_island("progress", { initial: ProgressViewSerializer.new(section, site: site_view).as_json,
                                 endpoint: api_progress_path(@user.username, reveal: @revealed, site: (1 if site_view)), mode: "project", numbers: numbers,
                                 defaultRange: Progress::Window::DEFAULT, shippedTarget: "what-shipped-panel" }, id: "progress") do %>
    <% ranges = capture do %>
      <nav class="os-pills" aria-label="Time range">
        <% ProgressHelper::RANGES.each do |range, label| %>
          <%= link_to label, project_page_for(@user, project, range: range == Progress::Window::DEFAULT ? nil : range, show: show),
                class: "os-pill max-sm:px-2", aria: { current: (section.labels.range == range ? "page" : nil) } %>
        <% end %>
      </nav>
    <% end %>
    <% headline = capture do %>
      <% if numbers == [ "visits" ] %>
        <p class="os-label">Site visits · <%= section.labels.words %></p>
        <div class="mt-0.5 flex flex-wrap items-baseline gap-x-[22px] gap-y-1.5">
          <span class="os-num os-big"><%= site_view.attributes[:value] %></span>
          <span class="text-lg font-semibold text-ink-2"><%= site_view.attributes[:visitors] %></span>
        </div>
      <% elsif numbers == [ "commits" ] %>
        <% arrow, change, up = progress_change(section) %>
        <p class="os-label">Commits · <%= section.labels.words %></p>
        <div class="mt-0.5 flex flex-wrap items-baseline gap-x-[22px] gap-y-1.5">
          <span class="os-num os-big"><%= section.tally.totals.commits %></span>
          <% if change.present? %>
            <span class="text-lg font-semibold text-ink-2">
              <% if arrow %><span class="<%= up ? 'text-up' : 'text-down' %>" aria-label="<%= up ? 'Up' : 'Down' %>"><%= arrow %></span><% end %>
              <%= change %>
            </span>
          <% end %>
        </div>
      <% else %>
        <p class="os-label">Commits and site visits · <%= section.labels.words %></p>
      <% end %>
    <% end %>
    <%# With site visits, the numbers and the window share one row, and what the chart shows sits under them. %>
    <% if site_view %>
      <div class="mt-7 flex flex-wrap items-center justify-between gap-3">
        <%= render "profiles/page/numbers", numbers: numbers,
                   values: { "commits" => section.tally.totals.commits, "visits" => site_view.attributes[:value] },
                   path_for: ->(value) { project_page_for(@user, project, range: range_param, show: value) } %>
        <%= ranges %>
      </div>
      <div class="mt-5"><%= headline %></div>
    <% else %>
      <div class="os-between mt-7.5 items-end"><div><%= headline %></div><%= ranges %></div>
    <% end %>
    <div class="mt-[22px]"><%= render "profiles/page/chart", section: section, chart: numbers_chart(section, site_view, numbers) %></div>
  <% end %>
</section>

<div class="flex flex-wrap items-start gap-4.5">
  <div class="os-stack min-w-0 flex-[999_1_560px]">
    <% if (news = @focus.news) %>
      <section class="os-panel" aria-labelledby="whats-new">
        <div class="os-between">
          <h2 id="whats-new" class="os-h2">What's new</h2>
          <span class="os-xs os-muted"><%= news.occurred_at.strftime("%b %-d") %> · <%= Entry::SHIPPED_TYPES.include?(news.entry_type) ? "Shipped" : "Published" %></span>
        </div>
        <h3 class="os-h3 mt-3 text-[22px]">
          <% if (url = safe_external_url(news.url)) %>
            <%= link_to news.title, entry_click_out_path(news.id), target: "_blank", rel: "noopener", data: { turbo: false }, class: "hover:underline", title: url %>
          <% else %>
            <%= news.title %>
          <% end %>
        </h3>
        <% if news.body.present? %>
          <p class="os-p mt-2 whitespace-pre-line"><%= news.body %></p>
        <% end %>
      </section>
    <% end %>
    <%= render "profiles/page/recent", user: @user, groups: @focus.page.recent, by_project: false if @focus.page.recent.any? %>
    <%= render "profiles/page/shipped", section: section %>
  </div>

  <aside class="os-panel min-w-0 flex-[1_1_300px]" aria-labelledby="details">
    <h2 id="details" class="os-h3">Details</h2>
    <dl class="mt-2.5">
      <% facts = [ [ "Commits, all time", project.commits ] ] %>
      <% facts << [ "First commit", @focus.first_commit.to_date.strftime("%b %-d, %Y") ] if @focus.first_commit %>
      <% facts << [ "Shipped and published", @focus.highlights ] if @focus.highlights.positive? %>
      <% facts << [ "Stars on GitHub", card.github_repo.stars_count ] if card&.github_repo&.stars_count.to_i.positive? %>
      <% facts << [ "Website", URI(website).host ] if website %>
      <% facts.each do |label, value| %>
        <div class="os-row flex justify-between gap-4 py-2.5">
          <dt class="os-sm os-muted"><%= label %></dt>
          <dd class="os-sm m-0 min-w-0 text-right font-semibold [overflow-wrap:anywhere]"><%= value %></dd>
        </div>
      <% end %>
    </dl>

    <%# The eight busiest; a big team's page says how many more. %>
    <% if @focus.co_builders.any? %>
      <h2 class="os-h3 mt-6.5">Also building this</h2>
      <ul class="mt-1.5">
        <% @focus.co_builders.first(8).each do |co| %>
          <li class="os-row py-0">
            <%= link_to project_page_path(co.user.username, project.repo.split("/").last), class: "flex items-center justify-between gap-3 py-2.5 hover:underline" do %>
              <span class="inline-flex min-w-0 items-center gap-2.5 font-bold">
                <img src="<%= co.user.avatar_url %>" alt="" class="os-avatar size-6 shrink-0"><span class="truncate">@<%= co.user.username %></span>
              </span>
              <span class="os-xs os-muted shrink-0"><%= pluralize(co.commits, "commit") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if (more = @focus.co_builders.size - 8).positive? %>
        <p class="os-note mt-1"><%= "and #{pluralize(more, 'more builder')}" %></p>
      <% end %>
    <% end %>

    <% if @focus.others.any? %>
      <h2 class="os-h3 mt-6.5">More from <%= @user.display_name %></h2>
      <ul class="mt-1.5">
        <% @focus.others.each do |other| %>
          <li class="os-row py-0">
            <%= link_to project_page_for(@user, other), class: "flex items-center justify-between gap-3 py-2.5 hover:underline" do %>
              <span class="inline-flex min-w-0 items-center gap-2.5 font-bold">
                <span class="os-dot <%= project_class(other.rank) %> bg-(--project)" aria-hidden="true"></span><span class="truncate"><%= other.name %></span>
              </span>
              <% if other.last_commit %><span class="os-xs os-muted shrink-0"><%= progress_ago(other.last_commit) %></span><% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </aside>
</div>
