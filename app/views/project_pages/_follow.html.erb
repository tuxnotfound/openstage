<%# Following one project by email, never a count of followers. Without its
    repo on the builder's list, the box follows the builder instead. %>
<% unless current_user == user %>
  <% repo = card&.github_repo %>
  <div class="min-w-0 flex-[1_1_300px]" data-subscribe-box>
    <%= form_with url: profile_subscribe_path(user.username), method: :post do |f| %>
      <%= f.hidden_field :project, value: repo.id if repo %>
      <label for="subscribe-email" class="mb-2 block text-[15px] font-semibold"><%= repo ? "Follow #{repo.name} by email" : "Get #{user.display_name}'s updates by email" %></label>
      <div class="flex gap-2">
        <%= f.email_field :email, id: "subscribe-email", placeholder: "you@example.com", required: true, autocomplete: "email", class: "os-field" %>
        <%# Honeypot: hidden from people, filled by scripts. %>
        <div class="hidden" aria-hidden="true"><%= f.text_field :website, tabindex: -1, autocomplete: "off" %></div>
        <%= f.submit repo ? "Follow" : "Subscribe", class: "os-btn" %>
      </div>
    <% end %>
    <p class="os-note mt-2">
      <% if repo %>
        <%= repo.name %>'s week on Fridays, when it has three or more things in it. Double opt-in, one-click unsubscribe.
        <%= link_to "Or follow everything #{user.display_name} builds", profile_path(user.username, anchor: "subscribe-email"), class: "underline hover:text-ink" %>
      <% else %>
        Double opt-in, one-click unsubscribe. Your address goes to <%= user.display_name %>, not to a list of ours.
      <% end %>
    </p>
  </div>
<% end %>
