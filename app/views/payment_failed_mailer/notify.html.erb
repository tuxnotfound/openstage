<%= mail_panel do %>
  <%= mail_heading "Your Pro payment failed" %>
  <p style="margin: 0;">Hi <%= @user.display_name %>,</p>
  <p style="margin: 12px 0 0;">We weren't able to process your Openstage Pro payment. Please update your payment method to keep your Pro features active.</p>
  <p style="margin: 20px 0 0;"><%= mail_button "Update payment method", settings_url %></p>
<% end %>

<p style="margin: 16px 4px 0; color: #666A73; font-size: 12px;">— Openstage</p>
