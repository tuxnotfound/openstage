<div class="max-w-md mx-auto py-16">
  <h1 class="text-2xl font-bold mb-2">Choose your username</h1>
  <p class="text-gray-500 text-sm mb-8">
    This will be your public URL: <span class="font-mono text-gray-700">openstage.dev/<%= @proposed_username %></span>
  </p>

  <%= form_with url: "/claim-username", method: :post do |f| %>
    <div class="mb-4">
      <%= f.label :username, "Username", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :username, value: @proposed_username,
          class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-900",
          autocomplete: "off", autofocus: true %>
      <p class="text-xs text-gray-400 mt-1">Letters, numbers, hyphens, underscores. 2–39 characters.</p>
    </div>

    <%= f.submit "Claim username", class: "w-full bg-gray-900 text-white py-2 rounded-md text-sm font-medium hover:bg-gray-700 cursor-pointer" %>
  <% end %>
</div>
