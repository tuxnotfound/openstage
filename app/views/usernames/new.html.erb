<% content_for :dark_mode, true %>
<% content_for :main_class, "os-wrap pt-10" %>

<section class="os-panel mx-auto max-w-[640px] p-6 sm:p-10">
  <h1 class="os-h1 text-[clamp(32px,4vw,44px)]">Choose your username</h1>
  <p class="os-p mt-2.5">This will be your public URL: <b class="text-ink">openstage.dev/<%= @proposed_username %></b></p>

  <%= form_with url: "/claim-username", method: :post, class: "mt-4" do |f| %>
    <%= f.label :username, "Username", class: "os-label" %>
    <span class="os-field mt-1.5 flex items-center p-0 focus-within:outline-2 focus-within:outline-accent">
      <span class="os-muted pl-3.5 pr-1 text-[15px]">openstage.dev/</span>
      <%= f.text_field :username, value: @proposed_username, autocomplete: "off", autofocus: true,
          aria: { describedby: "username-rules" },
          class: "h-full min-w-0 flex-auto border-0 bg-transparent pr-3.5 text-[15px] outline-none" %>
    </span>
    <p id="username-rules" class="os-xs os-muted mt-2">Letters, numbers, hyphens, underscores. 2–39 characters.</p>
    <%= f.submit "Claim username", class: "os-btn mt-5 w-full" %>
  <% end %>
</section>
