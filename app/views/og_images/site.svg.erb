<%# Every other page: the landing's headline over the landing's demo page,
    one line per project, as it stands today. Without @section, the headline
    alone (public/og-default.png, the card served when drawing fails). %>
<%= render "og_images/wordmark", x: 64, y: 100, size: 40 %>
<% HomeHelper::TAGLINE.each_with_index do |line, i| %>
  <%= share_card_text(line, x: 64, y: 196 + (i * 80), size: 72, font: ShareCardHelper::DISPLAY, weight: 700) %>
<% end %>

<% if @section %>
  <% chart = ProgressChart::Trend.new(@section) %>
  <%= share_card_text("A real Openstage page, as it stands today", x: 1136, y: 100, size: 24, fill: ShareCardHelper::INK_3, anchor: "end") %>
  <%# The busiest project last, so it draws on top. %>
  <% chart.lines.reverse_each do |line| %>
    <polyline points="<%= share_card_trend(chart, line, left: 0, right: 1200, top: 300, bottom: 604) %>" fill="none" stroke="<%= share_card_color(line.rank) %>" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"/>
  <% end %>
<% end %>
