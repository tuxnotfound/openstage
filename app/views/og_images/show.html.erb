<?xml version="1.0" encoding="UTF-8"?>
<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
  <!-- Background -->
  <rect width="1200" height="630" fill="#0f172a"/>

  <!-- Top accent -->
  <rect width="1200" height="3" fill="#6366f1"/>

  <!-- Avatar circle clip -->
  <defs>
    <clipPath id="av">
      <circle cx="152" cy="268" r="80"/>
    </clipPath>
  </defs>
  <image href="<%= @user.avatar_url %>" x="72" y="188" width="160" height="160" clip-path="url(#av)"/>

  <!-- Display name -->
  <text x="276" y="244"
        font-family="-apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif"
        font-size="52" font-weight="700" fill="#f8fafc">
    <%= h @user.display_name.truncate(26) %>
  </text>

  <!-- @username -->
  <text x="278" y="298"
        font-family="ui-monospace, 'Cascadia Code', Menlo, monospace"
        font-size="28" fill="#64748b">
    @<%= h @user.username %>
  </text>

  <% if @user.bio.present? %>
  <!-- Bio -->
  <text x="278" y="348"
        font-family="-apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif"
        font-size="22" fill="#94a3b8">
    <%= h @user.bio.truncate(72) %>
  </text>
  <% end %>

  <!-- Stats -->
  <text x="278" y="<%= @user.bio.present? ? 416 : 376 %>"
        font-family="-apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif"
        font-size="26" fill="#475569">
    <%= @total_entries %> entries · <%= @repos_synced %> repos · <%= @milestones %> milestones
  </text>

  <!-- Branding -->
  <text x="1128" y="592"
        font-family="-apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif"
        font-size="22" fill="#334155" text-anchor="end">
    openstage.dev
  </text>
</svg>
