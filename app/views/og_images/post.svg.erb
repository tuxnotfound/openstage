<%# A blog post: its title and date, and the line of the project it is about
    when it names one (BlogPost#chart) across the bottom, else what it says. %>
<%= render "og_images/wordmark", x: 64, y: 100, size: 34, tail: "blog" %>
<%= share_card_text(@post.published_on.strftime("%b %-d, %Y"), x: 1136, y: 100, size: 26, fill: ShareCardHelper::INK_3, anchor: "end") %>
<% title = share_card_lines(@post.title, width: 1072, size: 58, lines: 3, font: ShareCardHelper::DISPLAY) %>
<% title.each_with_index do |line, i| %>
  <%= share_card_text(line, x: 64, y: 210 + (i * 70), size: 58, font: ShareCardHelper::DISPLAY, weight: 700) %>
<% end %>

<% if @chart %>
  <% card = @chart.card %>
  <% color = share_card_color(card.rank) %>
  <% since = card.weeks.size < Progress::SummarizeService::WEEKS ? "since #{@chart.first_commit.strftime('%B %Y')}" : "over the last 12 months" %>
  <%= share_card_text("#{card.name}, commits per week #{since}", x: 1136, y: 432, size: 24, fill: ShareCardHelper::INK_3, anchor: "end") %>
  <% line, area = progress_sparkline(card.weeks, width: 1200, height: 176) %>
  <g transform="translate(0 450)">
    <path d="<%= area %>" fill="<%= color %>" fill-opacity="0.16"/>
    <path d="<%= line %>" fill="none" stroke="<%= color %>" stroke-width="6" stroke-linejoin="round" stroke-linecap="round"/>
  </g>
<% else %>
  <% share_card_lines(@post.description, width: 1072, size: 32, lines: 3).each_with_index do |line, i| %>
    <%= share_card_text(line, x: 64, y: 210 + (title.size * 70) + 36 + (i * 44), size: 32, fill: ShareCardHelper::INK_2) %>
  <% end %>
<% end %>
