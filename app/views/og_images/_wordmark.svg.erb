<%# The app's wordmark, as its header sets it. tail: a word after it, muted. %>
<text x="<%= x %>" y="<%= y %>" font-family="<%= ShareCardHelper::DISPLAY %>" font-weight="700" font-size="<%= size %>" letter-spacing="<%= -(size * 0.02).round(2) %>" fill="<%= ShareCardHelper::INK %>" text-anchor="<%= local_assigns.fetch(:anchor, "start") %>">openstage<% if local_assigns[:tail] %><tspan dx="<%= (size * 0.4).round %>" fill="<%= ShareCardHelper::INK_3 %>"><%= tail %></tspan><% end %></text>
