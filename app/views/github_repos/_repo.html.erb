<%# Single source of truth for a repo row: rendered both in Settings and by the
    turbo_stream response, which previously had its own drifting copy. %>
<%= turbo_frame_tag dom_id(repo) do %>
  <div class="os-row flex items-center gap-3 py-[11px]">
    <div class="min-w-0 flex-auto">
      <p class="truncate">
        <% unless repo.owned_by_user? %><span class="os-muted"><%= repo.owner_login %> /</span><% end %>
        <span class="font-bold"><%= repo.name %></span>
        <% if repo.private_repo? %><span class="os-tag ml-1 h-5 px-2 text-[11px]">private</span><% end %>
      </p>
      <% if repo.private_repo? %>
        <p class="os-xs <%= repo.included? ? 'font-semibold text-warn' : 'os-muted' %>">
          <%= repo.included? ? "Commit messages and releases from this private repo are public on your profile. Code and links are not." : "Excluded. Include it to publish its commit messages and releases (your code stays private)." %>
        </p>
      <% elsif repo.project_description.present? %>
        <p class="os-xs os-muted truncate"><%= repo.project_description %></p>
      <% end %>
    </div>
    <span class="os-xs os-muted shrink-0"><%= repo.included? ? "Included" : "Excluded" %></span>
    <%= button_to "", github_repo_path(repo), method: :patch, params: { included: (!repo.included?).to_s },
          role: "switch", aria: { checked: repo.included?, label: "Include #{repo.name}" }, class: "os-switch" %>
  </div>
<% end %>
