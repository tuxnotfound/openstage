<%= render "mailer/builder", builder: @builder, name: @project ? "#{@project.name}, by #{@builder.display_name}" : @builder.display_name, address: @page %>

<%= mail_panel do %>
  <%= mail_heading "Confirm your subscription" %>
  <% if @project %>
    <p style="margin: 0;">You asked for email updates on <%= @project.name %>, a project by <%= @builder.display_name %> (<%= @page %>).</p>
  <% else %>
    <p style="margin: 0;">You asked for email updates from <%= @builder.display_name %> (<%= @page %>).</p>
  <% end %>
  <p style="margin: 20px 0 0;"><%= mail_button "Yes, send me their updates", @confirm_url %></p>
<% end %>

<p style="margin: 16px 4px 0; color: #666A73; font-size: 12px;">If that was not you, ignore this and nothing more will arrive. You can also <%= link_to "unsubscribe", @unsub_url, style: "color: #666A73;" %> at any time from any email.</p>
