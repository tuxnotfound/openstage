#!/usr/bin/env bash
# Prints one secret for Kamal: the shell's value if set, else the value in the gitignored
# .env.kamal. Prints nothing when neither has it. Not .env: dotenv-rails loads .env in every
# environment, tests included, and production's values must never reach a local process.
set -eu
name="$1"
value="$(printenv "$name" 2>/dev/null || true)"
if [ -z "$value" ] && [ -f .env.kamal ]; then
  value="$(grep "^${name}=" .env.kamal | head -1 | cut -d= -f2- || true)"
fi
printf '%s' "$value"
